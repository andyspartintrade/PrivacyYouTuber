<!DOCTYPE html>
<html lang="el" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Privacy YouTuber</title>
<link rel="stylesheet" href="fonts/manrope.css">
<style>
  :root {
    --bg: #0d1017;
    --card: #171c26;
    --border: #242b38;
    --text: #e6ebf2;
    --muted: #8b94a6;
    --accent: #6c8cff;
    --accent2: #22d3a5;
    --danger: #ff6b6b;
    /* 🧱 Silk UI shadows (dark theme) */
    --silk-dark: #131315;
    --silk-light: #292a2e;
    --silk-extruded: 6px 6px 12px #00000080, -6px -6px 12px #26282e;
    --silk-inset: inset 6px 6px 12px #00000080, inset -6px -6px 12px #26282e;
    --silk-extruded-soft: 4px 4px 8px #131315, -4px -4px 8px #292a2e;
    --silk-inset-soft: inset 4px 4px 8px #131315, inset -4px -4px 8px #292a2e;
    /* Νεον glow για ενεργά στοιχεία (dark) */
    --silk-glow: rgba(0, 242, 254, 0.6);
    --silk-accent: #00f2fe;
    /* Χρώμα γραμμάτων ΠΑΝΩ στο accent (active buttons/chips) */
    --accent-fg: #000000;
    /* Παράγωγα χρώματα (hover / inputs / αστέρια) — για να αλλάζουν κι αυτά με το θέμα */
    --hover: #1a202c;
    --dragging: #1e2634;
    --input-bg: #0d1017;
    --star-off: #3a4456;
    /* Κίτρινο των κατηγοριών (dark: κλασικό κίτρινο, light: σκούρο πορτοκαλί) */
    --cat: #facc15;
    --cat-rgb: 250, 204, 21;
    /* Αστέρια ★ / pin 📌 / rating (dark: αμβαρ κίτρινο, light: μπλε) */
    --star: #fbbf24;
    --star-rgb: 251, 191, 36;
  }
  /* 🌞 Light theme — silk soft UI (off-white) */
  [data-theme="light"] {
    --bg: #f0f0f3;
    --card: #f0f0f3;
    --border: #d1d1d4;
    --text: #1b2230;
    --muted: #66708a;
    --accent: #3a7bd5;
    --accent2: #00d2ff;
    --danger: #e03e3e;
    /* 🧱 Silk UI shadows (light theme) */
    --silk-dark: #d1d1d4;
    --silk-light: #ffffff;
    --silk-extruded: 6px 6px 12px #d1d1d4, -6px -6px 12px #ffffff;
    --silk-inset: inset 6px 6px 12px #d1d1d4, inset -6px -6px 12px #ffffff;
    --silk-extruded-soft: 4px 4px 8px #d1d1d4, -4px -4px 8px #ffffff;
    --silk-inset-soft: inset 4px 4px 8px #d1d1d4, inset -4px -4px 8px #ffffff;
    /* Χωρίς neon στο light (καθαρό μπλε gradient) */
    --silk-glow: rgba(0, 210, 255, 0.35);
    --silk-accent: #00d2ff;
    /* Στο light, το accent είναι ΣΚΟΥΡΟ μπλε → άσπρα γράμματα πάνω του (καλό contrast) */
    --accent-fg: #ffffff;
    --hover: #eef1f8;
    --dragging: #e3e8f2;
    --input-bg: #f0f0f3;
    --star-off: #c4cadd;
    /* Σκούρο μπορντό για τις κατηγορίες στο light (αντί κίτρινου) */
    --cat: #9f1239;
    --cat-rgb: 159, 18, 57;
    /* Σκούρο μπορντό αστέρια/pin/rating στο light (αντί αμβαρ) */
    --star: #9f1239;
    --star-rgb: 159, 18, 57;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Manrope', -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg); color: var(--text);
    background-attachment: fixed;
    line-height: 1.5; padding: 32px 20px; max-width: 1240px; margin: 0 auto;
    transition: background .3s ease, color .3s ease;
  }
  /* 🌑 Dark theme: neon glow στα ενεργά/active στοιχεία (drop-shadow cyan) */
  :root .icon-btn:active,
  :root .yt-mode.active,
  :root .tag-chip.match-chip,
  [data-theme="dark"] .icon-btn:active,
  [data-theme="dark"] .yt-mode.active,
  [data-theme="dark"] .tag-chip.match-chip {
    filter: drop-shadow(0 0 6px var(--silk-glow));
  }
  header { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  h1 { font-size: 28px; letter-spacing: -0.5px; white-space: nowrap; font-weight: 800; }
  .lock {
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .privacy-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(34, 211, 165, 0.1); color: var(--accent2);
    border: 1px solid rgba(34, 211, 165, 0.3); border-radius: 999px;
    padding: 3px 12px; font-size: 12px; font-weight: 600;
    white-space: nowrap;
  }
  .privacy-badge .sep { opacity: .4; }
  .privacy-badge b { color: var(--accent2); font-size: 12.5px; }
  /* Backup / Update / Subscriptions — ΔΕΥΤΕΡΗ ΓΡΑΜΜΗ: Update αριστερά (κάτω από το P), τα υπόλοιπα δεξιά. */
  .backup-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex-basis: 100%; justify-content: space-between; }
  .backup-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .backup-btn {
    background: var(--bg); color: var(--text); border: none;
    border-radius: 12px; padding: 8px 14px; font-size: 12.5px; font-weight: 600; cursor: pointer;
    box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .12s, color .12s, transform .12s;
  }
  .backup-btn:hover { color: var(--accent); transform: translateY(-1px); }
  .backup-btn:active { box-shadow: var(--silk-inset-soft); transform: translateY(0); }
  /* 🌙/☀️ Διακόπτης θέματος */
  .theme-toggle {
    background: var(--bg); color: var(--text); border: none;
    border-radius: 999px; padding: 6px 12px; font-size: 15px; cursor: pointer;
    line-height: 1; box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .12s, color .12s, transform .12s; flex-shrink: 0;
  }
  .theme-toggle:hover { color: var(--accent); transform: scale(1.06); }
  .theme-toggle:active { box-shadow: var(--silk-inset-soft); }
  .backup-status { font-size: 12.5px; color: var(--muted); }
  /* Popup επιλογής import (αντικατάσταση / συγχώνευση) */
  .import-pop {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,.55);
    display: flex; align-items: center; justify-content: center;
    animation: fade-in .15s ease;
  }
  .import-pop-card {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 22px 24px; max-width: 420px; width: 90%;
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
  }
  .import-pop-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
  .import-pop-sub { font-size: 13px; color: var(--muted); margin: 0 0 16px; line-height: 1.5; }
  .import-pop-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .import-pop-actions .imp-replace { border-color: var(--danger); color: var(--danger); }
  .import-pop-actions .imp-replace:hover { border-color: var(--danger); color: #fff; background: rgba(239,68,68,.15); }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
/* Tabs — η γραμμή (2px) ρίχνει μαλακή σκιά προς τα πάνω· το ενεργό tab ΚΑΛΥΠΤΕΙ τη γραμμή και ενώνεται με το περιεχόμενο. */
  .tabs { display: flex; gap: 6px; margin: 10px 0 0; padding: 0 4px; position: relative; }
  .tabs::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--border); box-shadow: 0 -6px 12px rgba(0,0,0,.16);
    z-index: 1; pointer-events: none;
  }
  .tab {
    position: relative; z-index: 0; cursor: grab; opacity: .7; box-shadow: none;
    background: var(--bg); color: var(--muted); font-size: 15px; font-weight: 600;
    padding: 10px 30px 10px 20px;
    /* Ίδιο πλαίσιο σε ΟΛΑ τα tabs (διάφανο όταν δεν είναι ενεργό) → καμία μετατόπιση μεγέθους στην αλλαγή tab. */
    border: 1px solid transparent; border-bottom: none;
    border-radius: 8px 8px 0 0;                      /* στρογγυλό ΜΟΝΟ πάνω */
    transition: color .15s, box-shadow .16s, transform .16s, opacity .16s;
  }
  .tab::before {   /* ⠿ λαβή drag */
    content: "⠿"; position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    font-size: 14px; color: var(--muted); opacity: .5; pointer-events: none; letter-spacing: -1px;
  }
  .tab:hover { color: var(--text); opacity: .9; transform: translateY(-2px); }
  .tab:active { transform: translateY(1px); }
  .tab.active {
    color: var(--accent); opacity: 1; z-index: 2;              /* μπροστά από τη γραμμή */
    border-color: rgba(0,0,0,.08); border-bottom: none;        /* λεπτό απαλό περίγραμμα, ΟΧΙ κάτω */
    box-shadow: 0 -2px 4px rgba(0,0,0,.04);                    /* πολύ διακριτική σκιά, ΜΟΝΟ πάνω */
    padding-bottom: 12px; margin-bottom: -2px;                 /* = πάχος γραμμής: σβήνει το διαχωριστικό */
  }
  /* Το ενεργό tab ΜΕΝΕΙ καρφωμένο: αλλιώς το hover το ανέβαζε 2px και αποκάλυπτε τη γραμμή από κάτω. */
  .tab.active:hover, .tab.active:active { transform: none; opacity: 1; color: var(--accent); }
  .tab.active::before { opacity: .85; color: var(--accent); }
  .tab.tab-dragging { cursor: grabbing; opacity: .55; }
  .tab.tab-over { box-shadow: 0 0 0 2px var(--accent); }
  /* Dark: cyan glow προς τα πάνω· μέσα στο tab ο glow είναι inset ώστε να μη «τρέχει» κάτω από την καρτέλα. */
  [data-theme="dark"] .tabs::after { box-shadow: 0 -8px 20px rgba(0,242,254,.40), 0 -2px 6px rgba(0,242,254,.30); }
  /* Στο dark, η εσοχή (inset) των πεδίων δεν ρίχνει έντονο ΜΑΥΡΟ — απαλό light inset ώστε να «διαβάζεται» η εσοχή. */
  [data-theme="dark"] .search-box input,
  [data-theme="dark"] .cat-add input {
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.35),
                inset 0 1px 2px rgba(255, 255, 255, 0.04);
  }
  [data-theme="dark"] .tab.active {
    background: var(--bg); border-color: rgba(255,255,255,.10); border-bottom: none;
    box-shadow: inset 0 2px 8px rgba(0,242,254,.10), 0 -2px 6px rgba(0,242,254,.25);
  }
  [data-theme="dark"] .tab.tab-over { box-shadow: 0 0 0 2px var(--accent), 0 -3px 10px rgba(0,242,254,.3); }

    /* ===== ⚙️ Settings tab ===== */
    .settings-card {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px 18px; margin: 12px 0 14px;
      box-shadow: var(--silk-extruded-soft);
    }
    .settings-card-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .settings-card-body { font-size: 14px; color: var(--muted); line-height: 1.65; }
    .settings-card-body b { color: var(--text); }
    .settings-legend { display: flex; flex-direction: column; gap: 4px; margin: 10px 0; }
    .settings-legend span { color: var(--text); font-size: 13.5px; }
    .settings-toolbar { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; align-items: center; }
    /* Παλιά ονόματα — κρατούνται για συμβατότητα με το Import (subs-btn) */
    .subs-info {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px 18px; margin: 12px 0 14px;
      box-shadow: var(--silk-extruded-soft);
    }
    .subs-info-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .subs-info-body { font-size: 14px; color: var(--muted); line-height: 1.65; }
    .subs-info-body b { color: var(--text); }
    .subs-info-legend { display: flex; flex-direction: column; gap: 4px; margin: 10px 0; }
    .subs-info-legend span { color: var(--text); font-size: 13.5px; }
    .subs-info-body i { color: var(--muted); font-size: 13px; }
    .subs-toolbar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .subs-info {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px 18px; margin: 12px 0 14px;
      box-shadow: var(--silk-extruded-soft);
    }
    .subs-info-title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .subs-info-body { font-size: 14px; color: var(--muted); line-height: 1.65; }
    .subs-info-body b { color: var(--text); }
    .subs-info-legend { display: flex; flex-direction: column; gap: 4px; margin: 10px 0; }
    .subs-info-legend span { color: var(--text); font-size: 13.5px; }
    .subs-info-body i { color: var(--muted); font-size: 13px; }
    .subs-toolbar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .subs-btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--bg); color: var(--text);
      border: 1px solid var(--border); border-radius: 50px;
      padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer;
      box-shadow: var(--silk-extruded-soft); text-decoration: none;
      transition: transform .16s, box-shadow .16s, border-color .16s;
    }
    .subs-btn:hover { transform: translateY(-2px); box-shadow: var(--silk-extruded); }
    .subs-btn:active { transform: translateY(1px); box-shadow: var(--silk-inset-soft); }
    .subs-btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff; border: none;
    }
    /* 📥 Modal οδηγιών */
    .subs-help-overlay {
      position: fixed; inset: 0; z-index: 2000;
      background: rgba(0,0,0,.55); backdrop-filter: blur(3px);
      display: none; align-items: center; justify-content: center; padding: 20px;
    }
    .subs-help-overlay.open { display: flex; animation: fade-in .2s ease; }
    .subs-help-modal {
      background: var(--card); border: 1px solid var(--border); border-radius: 16px;
      max-width: 620px; width: 100%; max-height: 85vh; overflow-y: auto;
      padding: 22px 24px; box-shadow: 0 20px 60px rgba(0,0,0,.5);
      animation: pop-in .3s cubic-bezier(.18,.9,.32,1.35);
    }
    .subs-help-head {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 17px; font-weight: 700; margin-bottom: 14px;
    }
    .subs-help-body { font-size: 14px; line-height: 1.7; color: var(--text); }
    .subs-help-steps { margin: 12px 0; padding-left: 22px; }
    .subs-help-steps li { margin-bottom: 8px; }
    .subs-help-steps b { color: var(--accent); }
    .subs-help-note {
      background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
      padding: 12px 14px; font-size: 13px; color: var(--muted); margin-top: 14px;
    }
    .subs-help-actions { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .cat-toolbar { margin: 8px 0 4px; }
  .cat-add { display: flex; gap: 8px; margin-bottom: 8px; }
  .cat-add input {
    flex: 1; min-width: 0; background: var(--bg);
    border: 1px solid var(--border);          /* 🔲 απαλό περίγραμμα (ίδιο ύφος με τον φακό) */
    border-radius: 50px; padding: 10px 16px; color: var(--text); font-size: 14px;
    box-shadow: var(--silk-inset);
    transition: border-color .18s ease;
  }
  .cat-add input:focus { outline: none; border-color: var(--accent); box-shadow: var(--silk-inset), 0 0 0 2px var(--accent); }
  .cat-add button {
    flex-shrink: 0; background: var(--accent); color: #fff; border: none; border-radius: 8px;
    padding: 0 18px; font-size: 15px; font-weight: 600; cursor: pointer;
  }
  .cat-add button:hover { background: #5a7af0; }
  /* Κατηγορία (στήλη user_category) επικεφαλίδα στο tab Κατηγορίες */
  .cat-group { margin: 12px 0; margin-bottom: 4px; }
  .cat-head { display: flex; align-items: center; gap: 6px; padding: 5px 8px; cursor: pointer; border: none; font-size: 13px; font-weight: 600; border-radius: 6px; background: var(--bg); box-shadow: var(--silk-extruded); transition: box-shadow .18s ease, transform .18s ease; user-select: none; }
  .cat-head:hover { box-shadow: var(--silk-extruded), 0 0 0 2px var(--cat); transform: translateY(-2px); background: var(--hover); }
  .cat-head:active { box-shadow: var(--silk-inset); transform: translateY(0); }
  /* 🟣 ΚΑΡΦΙΤΣΩΜΕΝΗ κατηγορία (pinned) → μωβ banner (κάρτα), όπως τα κανάλια */
  .cat-group.pinned .cat-head {
    background: linear-gradient(90deg, rgba(139, 92, 246, .16), rgba(139, 92, 246, .05));
    box-shadow: var(--silk-extruded), 0 0 0 2px rgba(139, 92, 246, .45);
  }
  .cat-group.pinned .cat-head:hover {
    box-shadow: var(--silk-extruded), 0 0 0 2px #8b5cf6;
  }
  .cat-head .cat-chevron { font-size: 16px; transition: transform .25s cubic-bezier(.4,0,.2,1); color: var(--muted); }
  /* Το βελάκι αλλάζει ΜΟΝΟ μέσω glyph (▸ κλειστό / ▾ ανοιχτό) — ΟΧΙ rotate. */
  .cat-head .cat-name { flex: 1; color: var(--cat); }
  .cat-head .cat-count { color: rgba(var(--cat-rgb), 0.6); font-size: 13px; font-weight: 400; }
  .cat-body .vrow { margin-left: 36px; border-left: 1px solid var(--border); padding-left: 14px; }
  .cat-group.collapsed .cat-body { display: none; }
  .cat-chip {
    display: inline-block; background: rgba(var(--cat-rgb), 0.15); border: 1px solid rgba(var(--cat-rgb), 0.4);
    color: var(--cat); border-radius: 12px; padding: 1px 8px; font-size: 11px; font-weight: 600; margin-left: 6px;
  }
  .note-chip {
    display: inline-block; background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    color: var(--accent); border-radius: 12px; padding: 1px 8px; font-size: 11px; font-weight: 700; margin-left: 6px;
    cursor: default;
  }

  .tag-chk {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--card); border: 1px solid var(--border); border-radius: 999px;
    padding: 3px 10px; font-size: 12px; cursor: pointer; user-select: none;
  }
  .tag-chk:hover { border-color: var(--accent); }
  .tag-chk input { accent-color: var(--accent); cursor: pointer; }
  .tag-chk.on { border-color: var(--accent); background: rgba(108,140,255,0.12); }
  /* Πράσινα (accent2) κόμπακτ tag bubbles — όπως οι πρασινοποιημένες κατηγορίες */
  .tag-chk.green { border-color: rgba(34,211,165,0.35); background: rgba(34,211,165,0.08); }
  .tag-chk.green.on { border-color: var(--accent2); background: rgba(34,211,165,0.18); }
  .tag-chk.green input { accent-color: var(--accent2); }
  /* Κίτρινα category bubbles (όπως οι κίτρινες κατηγορίες) */
  .tag-chk.yellow { border-color: rgba(var(--cat-rgb),0.35); background: rgba(var(--cat-rgb),0.08); }
  .tag-chk.yellow.on { border-color: var(--cat); background: rgba(var(--cat-rgb),0.16); }
  .tag-chk.yellow input { accent-color: var(--cat); }
  .tag-chk.yellow .tag-filter-x { color: var(--cat); }
  .tag-filter-x {
    margin-left: 2px; cursor: pointer; color: var(--muted); font-size: 15px; line-height: 1;
    width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
  }
  .tag-filter-x:hover { color: var(--danger); background: rgba(239,68,68,0.15); }
  .tag-filter-count-title { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 600; color: var(--accent2); }
  .tag-filter-count { color: var(--accent2); font-weight: 700; }
  .tag-active-count { color: var(--muted); font-weight: 500; font-size: 12px; }
  /* --- Πτυχωτό πάνελ φίλτρου + κατηγορίες (accordion) --- */
  .tag-filter-head {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    padding: 4px 10px; border: 1px solid rgba(34,211,165,0.4); border-radius: 999px;
    background: rgba(34,211,165,0.12); user-select: none;
  }
  .tag-filter-head:hover { border-color: var(--accent2); }
  /* Κίτρινο κουμπί κατηγοριών (όπως οι κίτρινες κατηγορίες) */
  .tag-filter-head.cat { border-color: rgba(var(--cat-rgb),0.4); background: rgba(var(--cat-rgb),0.1); }
  .tag-filter-head.cat:hover { border-color: var(--cat); }
  .tag-filter-head.cat .cat-title { color: var(--cat); }
  .tag-filter-head.cat .tag-filter-count { color: var(--cat); }
  .tag-filter-panel {
    margin-top: 6px; border: 1px solid var(--border); border-radius: 8px;
    padding: 8px 10px; background: var(--card); max-height: 320px; overflow-y: auto;
    display: flex; flex-wrap: wrap; gap: 7px; align-items: center;
  }

  .cat-chevron { color: var(--muted); font-size: 12px; width: 12px; text-align: center; }
  .cat-name { color: var(--fg); }
  .cat-count { color: var(--muted); font-size: 11px; font-weight: 400; }
  .cat-body { padding: 4px 4px 6px 20px; }

  /* Tag chips πάνω στα βίντεο */
  .tag-chip {
    display: inline-flex; align-items: center; gap: 3px;
    background: var(--bg); color: var(--accent2); border: none;
    border-radius: 999px; padding: 2px 10px; font-size: 11px; font-weight: 600;
    box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .15s ease, color .15s ease;
  }
  .tag-chip:hover { color: var(--accent); }
  .tag-chip:active { box-shadow: var(--silk-inset-soft); }
  .tag-chip.match-chip { color: var(--accent); box-shadow: var(--silk-inset-soft); }

  /* Inline confirm διαγραφής tag */
  .del-confirm {
    position: fixed; z-index: 2000; width: 280px;
    background: var(--card); border: 1px solid var(--danger); border-radius: 10px;
    padding: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); font-size: 13px;
  }
  /* Κεντραρισμένο spring popup (για διαγραφή βίντεο). */
  .del-confirm.center {
    left: 50%; top: 50%;
    margin-left: -140px; margin-top: -60px;
    animation: center-pop .3s cubic-bezier(.18,.9,.32,1.4);
  }
  @keyframes center-pop {
    0%   { transform: scale(.82); opacity: 0; }
    60%  { transform: scale(1.05); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .del-confirm .dc-msg { color: var(--fg); line-height: 1.45; }
  .del-confirm .dc-msg b { color: var(--danger); }
  .del-confirm .dc-warn { color: var(--muted); font-size: 11px; }
  .del-confirm .dc-btns { display: flex; gap: 8px; margin-top: 10px; }
  .del-confirm .dc-yes { background: var(--danger); color: #fff; border: none; border-radius: 6px; padding: 6px 12px; font-weight: 600; cursor: pointer; }
  .del-confirm .dc-yes:hover { filter: brightness(1.1); }
  .del-confirm .dc-no { background: var(--card); color: var(--fg); border: 1px solid var(--border); border-radius: 6px; padding: 6px 12px; cursor: pointer; }
  .del-confirm .dc-no:hover { background: var(--border); }

  /* Popover για tagging */
  .tag-pop {
    position: fixed; z-index: 1000; width: 220px;
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); display: none;
  }
  .tag-pop.open { display: block; animation: pop-in .28s cubic-bezier(.18,.9,.32,1.45); }
  .tag-pop.closing { display: block; animation: pop-out .16s ease forwards; }
  @keyframes pop-in {
    0%   { opacity: 0; transform: scale(.6) translateY(-10px); }
    60%  { opacity: 1; transform: scale(1.08) translateY(0); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes pop-out {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(.7) translateY(-6px); }
  }
  .tag-pop-head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  .tag-pop-close { cursor: pointer; color: var(--muted); border: none; background: none; font-size: 16px; }
  .tag-pop-close:hover { color: var(--danger); }
  .tag-pop-list { display: flex; flex-direction: column; gap: 2px; max-height: 220px; overflow-y: auto; }
  .tag-pop-item { display: flex; align-items: center; gap: 6px; font-size: 13px; padding: 4px 6px; border-radius: 6px; }
  .tag-pop-item:hover { background: var(--hover); }
  .tag-pop-label { display: flex; align-items: center; gap: 6px; flex: 1; cursor: pointer; }
  .tag-pop-item input { accent-color: var(--accent); cursor: pointer; }
  .tag-del {
    flex-shrink: 0; cursor: pointer; color: var(--muted); border: none; background: none;
    font-size: 16px; line-height: 1; width: 20px; height: 20px; border-radius: 4px; display: flex; align-items: center; justify-content: center;
  }
  .tag-del:hover { color: var(--danger); background: rgba(239,68,68,0.12); }
  .tag-pop-new { margin-top: 8px; display: flex; gap: 6px; }
  .tag-pop-new input {
    flex: 1; min-width: 0; background: var(--input-bg); border: 1px solid var(--border);
    border-radius: 6px; padding: 5px 8px; color: var(--text); font-size: 13px;
  }
  .tag-pop-new button {
    flex-shrink: 0; background: var(--accent); color: #fff; border: none; border-radius: 6px;
    padding: 5px 12px; font-size: 12px; font-weight: 600; cursor: pointer; transition: background .15s;
  }
  .tag-pop-new button:hover { background: #5a78e8; }
  .tag-pop-new button:active { background: #4761c4; }
  /* 📌 Pin popup — 3 states */
  .pin-pop-list { display: flex; flex-direction: column; gap: 4px; }   /* κόκκινο βελάκι = πάνω-πάνω */
  .icon-btn.ch-pin.top { color: #ef4444; }

  /* Stars rating */
  .stars {
    display: inline-flex; gap: 2px; cursor: pointer;
    background: var(--bg); border: none; border-radius: 999px;
    padding: 3px 10px; box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .15s ease;
  }
  .stars:active { box-shadow: var(--silk-inset-soft); }
  .stars .st {
    font-size: 16px; color: var(--star-off); transition: color .1s; line-height: 1;
    background: none; border: none; padding: 0; margin: 0; cursor: pointer; outline: none;
  }
  .stars .st.on { color: var(--star); }
  .stars:hover .st { color: var(--star); }
  h2 { font-size: 17px; margin-bottom: 14px; letter-spacing: -0.3px; }
  section { margin-bottom: 32px; }
  .list-head { display: flex; align-items: center; gap: 10px; margin: 16px 0 8px; }
  .list-head-lbl { font-size: 14px; font-weight: 600; color: var(--muted); }
  .list-head-count { font-weight: 400; color: var(--muted); opacity: 0.75; }
  /* Αριθμός βίντεο που βρέθηκαν στο ενεργό φίλτρο (αντί για την μπλε μπάρα). */
  .filter-count {
    margin-left: 6px; font-weight: 600; color: var(--accent);
    font-size: 13px; white-space: nowrap;
  }
  /* RSS Watchdog (panel μέσα στο κανάλι) */
  .rss-panel {
    margin: 4px 0 6px 36px; padding: 10px 12px;
    border: 1px solid var(--accent); border-left: 3px solid var(--accent);
    border-radius: 8px; background: rgba(99,102,241,.05);
    animation: rss-in .25s cubic-bezier(.4,0,.2,1);
  }
  @keyframes rss-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes rss-out {
    from { opacity: 1; transform: translateY(0); max-height: 400px; margin: 4px 0 6px 36px; padding: 10px 12px; }
    to   { opacity: 0; transform: translateY(-6px); max-height: 0; margin: 0; padding: 0; }
  }
  .rss-panel.closing {
    animation: rss-out .22s cubic-bezier(.4,0,.2,1) forwards;
    overflow: hidden;
    border-width: 0;
  }
  .rss-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .rss-title { font-size: 13.5px; font-weight: 600; }
  .rss-count { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; }
  .rss-total {
    font-size: 12.5px; color: var(--muted); font-weight: 600;
    white-space: nowrap; font-variant-numeric: tabular-nums;
    /* σταθερό πλάτος (χωράει "(+999)") → δεν κουνάει τα −/num/+ δεξιά του */
    min-width: 6ch; width: 6ch; text-align: left; display: inline-block;
  }
  /* σταθερό πλάτος 3 ψηφίων → τα −/+ ΔΕΝ μετακινούνται όταν αλλάζει ο αριθμός */
  .rss-num {
    font-weight: 700; color: var(--accent);
    min-width: 3ch; width: 3ch; text-align: center;
    font-variant-numeric: tabular-nums;
    display: inline-block;
  }
  .rss-countbtn {
    width: 26px; height: 26px; cursor: pointer; font-size: 16px; line-height: 1;
    background: var(--card); color: var(--text); border: 1px solid var(--border);
    border-radius: 6px; display: flex; align-items: center; justify-content: center;
  }
  .rss-countbtn:hover { border-color: var(--accent); color: var(--accent); }
  /* ⬆️⬇️ Σκρολ μέσα στο News Feed. Το ύψος (πόσα «χωράνε» πριν το scroll) ορίζεται δυναμικά
     από το −/+ (inline max-height στο .rss-list) → βλ. renderRssPanel(). Λεπτή μπάρα, ταιριάζει
     στο theme, και σταματά να τραβάει όλη τη σελίδα όταν είναι πολλά. */
  .rss-list {
    display: flex; flex-direction: column;
    max-height: 280px;
    overflow-y: auto;
    padding-right: 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .rss-list::-webkit-scrollbar { width: 8px; }
  .rss-list::-webkit-scrollbar-thumb {
    background: var(--border); border-radius: 6px;
  }
  .rss-list::-webkit-scrollbar-thumb:hover { background: var(--accent); }
  .rss-list::-webkit-scrollbar-track { background: transparent; }
  .new-row {
    display: flex; align-items: center; gap: 12px; padding: 8px 4px;
    border-bottom: 1px solid var(--border);
  }
  .new-row:last-child { border-bottom: none; }
  .new-row .thumb { width: 84px; height: 47px; }
  .rss-empty { font-size: 13px; color: var(--muted); padding: 6px 0; }
  @keyframes rss-spin { to { transform: rotate(360deg); } }
  @keyframes rss-slide { to { left: 100%; } }
  /* 🔔 καμπάνα — ΓΥΜΝΗ (χωρίς περίγραμμα): state μόνο από χρώμα + σχήμα */
  .watch-tgl { border-color: transparent !important; background: transparent !important; border-radius: 50% !important; transition: color .15s ease, filter .15s ease, transform .15s ease; }
  .watch-tgl.on { color: var(--accent); filter: drop-shadow(0 0 6px rgba(108,140,255,.55)); }
  .watch-tgl:not(.on) { color: var(--muted); }
  /* loading = το refresh icon κάνει spin (ομαλή πλήρης περιστροφή) */
  .watch-tgl.loading { animation: refresh-spin .8s linear infinite; }
  .watch-tgl.loading svg { animation: refresh-spin .8s linear infinite; }
  @keyframes refresh-spin {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  @keyframes bell-ring {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(16deg); }
    40% { transform: rotate(-14deg); }
    60% { transform: rotate(10deg); }
    80% { transform: rotate(-6deg); }
  }
  .toggle-all {
    flex-shrink: 0; cursor: pointer; background: var(--card);
    color: var(--muted); border: 1px solid var(--border); border-radius: 8px;
    width: 44px; height: 36px; line-height: 1;
    font-size: 30px; display: flex; align-items: center; justify-content: center;
    transition: color .15s, border-color .15s;
  }
  .toggle-all:hover { color: var(--text); border-color: var(--accent); }
  .toggle-all.all-closed { color: var(--accent); border-color: var(--accent); }
  .refresh {
    margin-left: auto; background: transparent; color: var(--muted);
    border: 1px solid var(--border); border-radius: 8px; padding: 6px 14px;
    font-size: 13px; cursor: pointer;
  }
  .refresh:hover { color: var(--text); border-color: var(--accent); }
  .add-box { display: flex; gap: 8px; margin-bottom: 8px; }
  .add-box input {
    flex: 1; background: var(--bg);
    border: 1px solid var(--border);          /* 🔲 ίδιο ύφος με τα άλλα πεδία */
    border-radius: 50px; padding: 10px 16px; color: var(--text); font-size: 14px;
    box-shadow: var(--silk-inset);
    transition: box-shadow .18s ease, border-color .18s ease;
  }
  .add-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--silk-inset), 0 0 0 2px var(--accent);
  }
  .add-box button {
    background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border: none; border-radius: 50px;
    padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer;
    box-shadow: var(--silk-extruded-soft);
  }
  .add-box button:hover { opacity: .92; }
  .add-box button:active { box-shadow: var(--silk-inset-soft); }

  /* Βιβλιοθήκη — group ανά κανάλι */
  /* 🚀 VIRTUAL για τα κανάλια (μπορεί να είναι εκατοντάδες σε ένα fetch):
     το channel-group έχει ύψος ~106px με 1 γραμμή, αλλά με πολλά βίντεο μεγαλώνει —
     γι' αυτό χρησιμοποιούμε το δικό του «auto» intrinsic size (ο browser το θυμάται). */
  .channel-group {
    /* ⛔ ΧΩΡΙΣ content-visibility: το containment έσπαγε το position:fixed του lift
       (η κάρτα «εξαφανιζόταν») και έκοβε τις άκρες των λωρίδων. */
    margin-bottom: 4px;   /* ✅ ίδιο κενό με τις Κατηγορίες (.cat-group) */
  }
  .channel-head {
    /* ✅ ΑΣΦΑΛΕΣ: 102 λωρίδες, καμία δεν έχει lift. */
    content-visibility: auto;
    contain-intrinsic-size: auto 62px;
    display: flex; align-items: center; gap: 12px;
    padding: 3px 16px; border: none; border-radius: 16px; margin-bottom: 0;
    cursor: pointer; user-select: none; line-height: 1; min-height: 0;
    min-width: 0; max-width: 100%; box-sizing: border-box;
    width: 100%;               /* 🔧 να πιάνει ΑΚΡΙΒΩΣ το πλάτος του .channel-body */
    overflow: hidden;          /* 🔧 ώστε το περιεχόμενο να μην ξεφεύγει έξω από τη λωρίδα */
    background: var(--bg);
    box-shadow: var(--silk-extruded);
    transition: box-shadow .18s ease, transform .18s ease, background .18s ease;
  }
  .channel-head:hover {
    box-shadow: var(--silk-extruded), 0 0 0 2px var(--accent);
    transform: translateY(-2px);
  }
  .channel-head:active { box-shadow: var(--silk-inset); transform: translateY(0); }
  .channel-head:hover .channel-name { color: var(--accent); }
  .chevron { color: var(--muted); font-size: 16px; transition: transform .25s cubic-bezier(.4,0,.2,1); flex-shrink: 0; }
  .channel-group.collapsed .chevron { transform: rotate(-90deg); }
  /* 🟣 ΚΑΡΦΙΤΣΩΜΕΝΑ κανάλια (pinned) → μωβ banner (κάρτα) */
  .channel-group.pinned .channel-head {
    background: linear-gradient(90deg, rgba(139, 92, 246, .16), rgba(139, 92, 246, .05));
    box-shadow: var(--silk-extruded), 0 0 0 2px rgba(139, 92, 246, .45);
  }
  .channel-group.pinned .channel-head:hover {
    box-shadow: var(--silk-extruded), 0 0 0 2px #8b5cf6;
  }
  /* 🔵 Νέο κανάλι (μόλις προστέθηκε) — ίδιο μπλε με τα «νέα» βίντεα (.vrow.unseen) */
  .channel-group.new .channel-head {
    background: linear-gradient(90deg, rgba(59, 130, 246, .16), rgba(56, 189, 248, .07));
    border-color: rgba(59, 130, 246, .45);
  }
  .channel-group.new .channel-head:hover {
    border-color: #3b82f6;
    box-shadow: 0 10px 28px rgba(59, 130, 246, .25);
  }
  /* 🟠 Εισαγμένο κανάλι (από subscriptions) — πορτοκαλί/κεχριμπαρένιο banner */
  .channel-group.imported .channel-head {
    background: linear-gradient(90deg, rgba(245, 158, 11, .16), rgba(251, 191, 36, .06));
    border-color: rgba(245, 158, 11, .45);
  }
  .channel-group.imported .channel-head:hover {
    border-color: #f59e0b;
    box-shadow: 0 10px 28px rgba(245, 158, 11, .25);
  }
  /* Accordion animation: ξεδίπλωμα/μάζεμα του σώματος (βίντεα + rss) */
  .channel-body {
    max-height: 50000px;
    overflow: hidden;
    min-width: 0;
    transition: max-height .3s cubic-bezier(.4,0,.2,1), opacity .22s ease;
    opacity: 1;
    padding: 4px 6px 6px 6px;
  }
  .channel-group.collapsed .channel-body {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* Tree layout: τα βίντεο μπαίνουν «ένα βήμα μέσα» με γραμμή, σαν file tree */
  .channel-group .vrow {
    margin-left: 36px;
    border-left: 1px solid var(--border);
    padding-left: 14px;
    border-radius: 0 8px 8px 0;
  }
  .channel-head .avatar-wrap { width: 56px; height: 56px; border-radius: 50%; box-shadow: 0 4px 14px rgba(0,0,0,.3); }
  .channel-name {
    font-weight: 700; font-size: 17px; line-height: 1; letter-spacing: -0.2px;
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .chan-link {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; color: inherit; line-height: 1; min-height: 0;
    min-width: 0;              /* 🔧 να μπορεί να μικρύνει — δεν σπρώχνει τα κουμπιά έξω */
    flex: 0 1 auto;
  }
  .chan-link:hover .channel-name { text-decoration: underline; }
  .head-spacer { flex: 1; }
  .vrow {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 4px; border-bottom: 1px solid var(--border);
    cursor: grab; border-radius: 8px; transition: background .18s ease, transform .18s ease;
  }
  .vrow:hover { background: var(--hover); }
  .vrow.dragging { opacity: .45; background: var(--dragging); cursor: grabbing; }
  /* Βίντεο που πρόσθεσες με ➕ αλλά ΔΕΝ έχεις δει ακόμα → απαλό ΜΠΛΕ φόντο (ξεμοβίζει χειροκίνητα) */
  .vrow.unseen { background: linear-gradient(90deg, rgba(59, 130, 246, .14), rgba(56, 189, 248, .09)); }
  .vrow.unseen:hover { background: linear-gradient(90deg, rgba(59, 130, 246, .22), rgba(56, 189, 248, .15)); }
  .new-badge {
    display: inline-block; margin-left: 8px; padding: 1px 7px;
    font-size: 10px; font-weight: 700; letter-spacing: .4px;
    color: #fff; background: linear-gradient(135deg, #3b82f6, #38bdf8);
    border-radius: 999px; vertical-align: middle; text-transform: uppercase;
  }
  /* 🃏 Καρτέλες βίντεο (grid, σαν την αναζήτηση) */
  .v-card-grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px;
    padding: 10px 0 12px;
  }
  /* 🚀 VIRTUAL για τις καρτέλες που ΜΕΝΟΥΝ στη σελίδα (κατηγορίες):
     ο browser ζωγραφίζει ΜΟΝΟ τις ορατές. Έχουμε 3531 .v-card — με αυτό δεν πληρώνουμε όλες.
     (Το contain-intrinsic-size βγαίνει από το πραγματικό ύψος — αλλιώς πηδά η μπάρα.) */
  .v-card {
    /* ⛔ ΧΩΡΙΣ content-visibility: έσπαγε το fixed positioning του lift. */
    display: flex; flex-direction: column; gap: 6px; padding: 10px;
    border-radius: 16px; background: var(--bg); border: none;
    box-shadow: var(--silk-extruded);
    cursor: grab; transition: transform .18s ease, box-shadow .18s ease;
  }
  .v-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--silk-extruded), 0 0 0 2px var(--accent);
  }
  .v-card:active { box-shadow: var(--silk-inset); }
  .v-card.dragging { opacity: .88; background: var(--dragging); cursor: grabbing; transform: scale(1.03); box-shadow: var(--silk-extruded), 0 0 0 2px var(--accent); }
  /* ⚡ Pointer-drag: το πρωτότυπο «πετάει» fixed και ακολουθεί τον κέρσορα (GPU, 60fps). */
  .pointer-dragging {
    position: fixed !important; z-index: 900 !important;
    margin: 0 !important; pointer-events: none !important;
    box-shadow: 0 20px 50px rgba(0,0,0,.45), var(--silk-extruded) !important;
    transform: scale(1.04) !important; opacity: .95 !important;
    transition: none !important; will-change: left, top;
  }
  .pointer-dragging-head { cursor: grabbing !important; }
  /* 🎨 Όταν σηκώνεται ένα banner/κάρτα: φόντο ημιδιαφανές + ΜΟΝΟ «αιωρούμενη» σκιά
     (μαύρη, διαφανής) — χωρίς τη silk σκιά που έσβηνε σε άσπρο. */
  .channel-head.pointer-dragging,
  .cat-head.pointer-dragging,
  .v-card.pointer-dragging {
    background: color-mix(in srgb, var(--bg) 78%, transparent) !important;
    box-shadow: 0 18px 44px rgba(0,0,0,.34) !important;
    backdrop-filter: blur(6px) !important;
  }
  /* Το κενό που αφήνει η σηκωμένη κάρτα (placeholder) — δείχνει πού θα πάει. */
  .drag-slot {
    border-radius: 18px; background: transparent;
    box-shadow: inset 0 0 0 2px var(--accent);
    pointer-events: none;
  }
  /* ⚡ Lag fix: όσο κάνουμε drag, κόψε τα transitions στις κάρτες (πολύ reflow σε grid 2D). */
  body:has(.v-card.dragging) .v-card,
  body:has(.channel-group.dragging) .channel-group,
  body:has(.cat-group.dragging) .cat-group {
    transition: none !important;
  }
  .v-card.drop-target, .vrow.drop-target { box-shadow: var(--silk-inset), 0 0 0 2px var(--accent) !important; }
  /* 🚀 Lift: η καρτέλα «απογειώνεται» — floating πάνω από το grid, μένει σταθερή στο scroll. */
  .v-card.lifted {
    position: fixed; z-index: 500;
    width: 280px; max-width: 80vw;
    transform: scale(1.08);
    box-shadow: 0 30px 70px rgba(0,0,0,.55), var(--silk-extruded);
    cursor: default;
    transition: none;
  }
  .v-card.lifted .lift-btn { color: var(--accent); }
  .lift-btn {
    font-size: 16px;
    /* 🏔️ Ανάγλυφο λευκό κουμπάκι (πιο έντονο embossed) */
    background: var(--bg);
    color: var(--text);
    box-shadow: var(--silk-extruded);
    transition: box-shadow .15s ease, color .15s ease, transform .15s ease;
  }
  .lift-btn:hover { color: var(--accent); transform: translateY(-1px); }
  .lift-btn:active { box-shadow: var(--silk-inset); transform: translateY(0); }
  .v-card.lifted:hover { transform: scale(1.08); box-shadow: 0 30px 70px rgba(0,0,0,.55), var(--silk-extruded); }
  .v-card-thumb-wrap { position: relative; min-width: 0; width: 100%; aspect-ratio: 16/9; cursor: pointer; overflow: hidden; border-radius: 8px; }
  .v-card-thumb-ph { position: absolute; inset: 0; background: linear-gradient(110deg, var(--card) 8%, var(--hover) 18%, var(--card) 33%); background-size: 200% 100%; animation: thumb-shimmer 1.6s linear infinite; }
  .v-card-thumb { position: relative; width: 100%; height: 100%; object-fit: cover; border-radius: 8px; display: block; background: #000; opacity: 0; filter: blur(4px); transition: filter .35s ease-out, opacity .35s ease-out ease-out; }
  .v-card-thumb.loaded { opacity: 1; filter: blur(0); }
  @keyframes thumb-shimmer { to { background-position-x: -200%; } }
  .skeleton-line { display: inline-block; height: 13px; border-radius: 4px; background: linear-gradient(110deg, var(--card) 8%, var(--hover) 18%, var(--card) 33%); background-size: 200% 100%; animation: thumb-shimmer 1.6s linear infinite; }
  .sk-avatar { width: 128px; height: 128px; border-radius: 16px; background: linear-gradient(110deg, var(--card) 8%, var(--hover) 18%, var(--card) 33%); background-size: 200% 100%; animation: thumb-shimmer 1.6s linear infinite; }
  .v-card-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 34px; color: #fff; opacity: 0; transition: opacity .15s;
    background: rgba(0,0,0,.25); border-radius: 8px; text-shadow: 0 2px 10px rgba(0,0,0,.6);
  }
  .v-card-thumb-wrap:hover .v-card-play { opacity: 1; }
  .v-card-title {
    font-size: 14.5px; font-weight: 600; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .v-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); }
  .v-card-actions { display: flex; align-items: center; gap: 6px; margin-top: auto; }
  .v-card-actions .spacer { flex: 1; }
  .thumb {
    width: 112px; height: 63px; object-fit: cover; border-radius: 6px;
    border: 1px solid var(--border); flex-shrink: 0; background: #000;
  }
  .vinfo { flex: 1; min-width: 0; }
  .vtitle { color: var(--text); text-decoration: none; font-size: 14px; font-weight: 500; display: block; }
  .vtitle:hover { color: var(--accent); }
  .vmeta { display: flex; align-items: center; gap: 8px; margin-top: 5px; font-size: 12.5px; flex-wrap: wrap; }
  .avatar-wrap { position: relative; width: 22px; height: 22px; flex-shrink: 0; }
  .avatar-fallback {
    position: absolute; inset: 0; border-radius: 50%;
    background: var(--hover); color: var(--text); font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .avatar {
    position: absolute; inset: 0; width: 100%; height: 100%;
    border-radius: 50%; object-fit: cover; border: 1px solid var(--border);
  }
  .cat {
    color: var(--accent); cursor: pointer; border-bottom: 1px dashed var(--accent);
    padding: 1px 2px; white-space: nowrap;
  }
  .cat:hover { opacity: .8; }
  .count { color: var(--accent2); font-weight: 600; font-size: 14px; }
  .pinned { color: var(--star); font-size: 12px; }
  .icon-btn {
    background: var(--bg); color: var(--muted); border: none;
    border-radius: 12px; width: 42px; height: 42px; font-size: 20px; line-height: 1;
    cursor: pointer; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: var(--silk-extruded-soft);
    transition: color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .icon-btn:hover { color: var(--text); transform: translateY(-1px); }
  .icon-btn:active { box-shadow: var(--silk-inset-soft); transform: translateY(0); }
  .icon-btn.del:hover { color: var(--danger); }
  .icon-btn.pin.active { color: var(--star); box-shadow: var(--silk-inset-soft); }
  .icon-btn.pin.pinning { animation: pin-pop .5s cubic-bezier(.18,.9,.32,1.35); }
  .icon-btn.ch-pin.pinning { animation: pin-pop .5s cubic-bezier(.18,.9,.32,1.35); }
  @keyframes pin-pop {
    0%   { transform: scale(1) rotate(0deg); }
    35%  { transform: scale(1.35) rotate(-14deg); }
    65%  { transform: scale(.9) rotate(5deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  @keyframes seen-out {
    to { opacity: 0; }
  }
  @keyframes deleting {
    0%   { opacity: 1; max-height: 400px; margin: 0; padding: 10px 4px; }
    100% { opacity: 0; max-height: 0; margin: 0; padding-top: 0; padding-bottom: 0; border-bottom-width: 0; }
  }

  /* Θέματα */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .sugg-item { display: flex; align-items: center; gap: 8px; }
  .sugg-item a {
    flex: 1; color: var(--text); text-decoration: none; font-size: 14px;
    padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--card); transition: border-color .15s, background .15s;
  }
  .sugg-item a:hover { border-color: var(--accent); background: var(--hover); }
  .sugg-item a::before { content: "🔎 "; }

  .empty { color: var(--muted); font-size: 14px; }
  .loading { color: var(--muted); font-size: 13px; }
  .muted { color: var(--muted); }
  .search-box { margin: 4px 0; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .search-box input {
    flex: 1; min-width: 200px; background: var(--bg);
    border: 1px solid var(--border);          /* 🔲 απαλό περίγραμμα (ίδιο ύφος με τον φακό) */
    border-radius: 50px; padding: 10px 18px; color: var(--text); font-size: 14px;
    box-shadow: var(--silk-inset);
    transition: box-shadow .18s ease, border-color .18s ease;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--silk-inset), 0 0 0 2px var(--accent);
  }
  /* 🔍 Search buttons — Apple round-glass: κυκλικό, γυάλινο, με soft glow στο hover. */
  .search-box button {
    width: 42px; height: 42px; border-radius: 50%;
    border: 2px solid var(--border);          /* 🔲 πιο παχύ περίγραμμα (πιο ορατό) */
    background: var(--card);
    color: var(--muted); font-size: 17px; line-height: 1;
    cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: color .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  .search-box button:hover {
    color: var(--text); border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--card));
    box-shadow: 0 0 0 4px rgba(108,140,255,.12), 0 6px 18px rgba(0,0,0,.22);
    transform: translateY(-1px);
  }
  .search-box button:active { transform: translateY(0); }
  .rating-filter {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--bg); border: none; border-radius: 999px;
    height: 40px; padding: 0 12px; flex-shrink: 0;
    box-shadow: var(--silk-inset-soft);
  }
  .rating-filter .stars { display: inline-flex; gap: 1px; cursor: pointer; }
  .rating-filter .st { font-size: 18px; color: var(--star-off); transition: color .1s; line-height: 1; }
  .rating-filter .st.on { color: var(--star); }
  /* Ακυρώνουμε το global hover εδώ — ΟΧΙ mouse-over φωτισμό στο φίλτρο */
  .rating-filter .stars:hover .st { color: var(--star-off); }
  .rating-filter .stars:hover .st.on { color: var(--star); }
  .rating-filter .rf-clear {
    color: var(--muted); cursor: pointer; font-size: 14px; line-height: 1;
    width: 30px; height: 30px; border-radius: 50%; border: none;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--bg); box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .15s ease, color .15s ease;
  }
  .rating-filter .rf-clear:hover { color: var(--danger); }
  .rating-filter .rf-clear:active { box-shadow: var(--silk-inset-soft); }
  .rating-filter .rf-clear.active {
    color: var(--danger);
    font-weight: 800;
    text-shadow: 0 0 6px color-mix(in srgb, var(--danger) 70%, transparent);
  }
  /* Στρογγυλό × για το search field (μπροστά από τη λούπα) — απαλό, μόλις γράψεις λέξη. */
  .input-clear {
    background: var(--card); color: var(--muted); border: 1px solid var(--border);
    border-radius: 50%; width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px; cursor: pointer; white-space: nowrap; flex-shrink: 0;
    transition: color .12s ease, border-color .12s ease, transform .12s ease;
  }
  .input-clear:hover { color: var(--danger); border-color: var(--danger); transform: scale(1.06); }
  .match-stars { box-shadow: 0 0 0 2px var(--danger); border-radius: 4px; }
  .match-chip { box-shadow: 0 0 0 2px var(--danger); }
  .vtitle mark.hl { color: var(--danger); font-weight: 700; background: none; }
  .fc { padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 600; }

  /* Προσβασιμότητα: σεβασμός στο «μείωσε την κίνηση» του λειτουργικού */
  @media (prefers-reduced-motion: reduce) {
    .channel-body, .chevron, .rss-panel, .watch-tgl.loading {
      transition: none !important;
      animation: none !important;
    }
  }

  /* 🎬 Floating player (lightbox) — sexy, μοντέρνο, βίντεο "στον αέρα" */
  .lb {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    animation: lb-fade .18s ease;
  }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  .lb-backdrop {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, .55);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
  }
  .lb-dialog {
    position: relative; z-index: 1;
    width: min(1180px, 96vw);          /* φαρδύτερο — χωράει και τα 3 κουτιά */
    background: transparent;            /* 🔴 ΚΑΝΕΝΑ ΛΕΥΚΟ ΦΟΝΤΟ */
    border: none;                       /* 🔴 ΚΑΝΕΝΑ ΠΛΑΙΣΙΟ */
    border-radius: 0;
    box-shadow: none;
    padding: 0;                         /* 🔴 ΚΑΝΕΝΑ ΚΕΝΟ */
    display: flex; flex-direction: column; gap: 10px;
    align-items: center;
  }
  /* 🌞 Light: ίδιο λεπτό μπλε outline (χωρίς glow γύρω-γύρω) */
  [data-theme="light"] .lb-dialog {
    border: 1.5px solid color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: none;
  }
  @keyframes lb-pop {
    from { transform: scale(.94) translateY(14px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }
  .lb-close {
    position: absolute; top: -12px; right: -12px;
    width: 34px; height: 34px; border-radius: 50%;
    border: none; background: var(--bg);
    color: var(--text); font-size: 16px; font-weight: 700;
    cursor: pointer; z-index: 2; box-shadow: var(--silk-extruded-soft);
    display: flex; align-items: center; justify-content: center;
    transition: transform .12s, box-shadow .12s;
  }
  .lb-close:hover { transform: scale(1.1); }
  .lb-close:active { box-shadow: var(--silk-inset-soft); }
  .lb-frame { position: relative; width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 10px; overflow: hidden; }

  /* ═══════════ 🎠 3D OVERLAY CAROUSEL ═══════════
     Τα πλαϊνά preview είναι ΠΙΣΩ από το κεντρικό βίντεο (overlay, όχι flex),
     ώστε το κεντρικό να δεσπόζει στο κέντρο με πλήρες μέγεθος. */
  /* Five-card staircase. All cards share one grid cell; no absolute previews. */
  .lb-stage {
    display: grid; grid-template-columns: minmax(0, 1fr);
    align-items: center; justify-items: center; width: 100%; min-width: 0;
  }
  .lb-main {
    grid-area: 1 / 1; position: relative; z-index: 10;
    width: 64%; max-width: 900px; min-width: 0;
    background: var(--bg); border: 1px solid var(--border); border-radius: 16px;
    padding: 10px; box-shadow: 0 8px 22px rgba(0,0,0,.22);
    display: flex; flex-direction: column; gap: 8px;
  }
  .lb-main .lb-frame { max-height: 64vh; }
  .lb-side {
    grid-area: 1 / 1; position: relative; z-index: 3;
    width: 44%; max-width: 630px; min-width: 0; margin: 0;
    padding: 6px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--bg); color: var(--text); font: inherit;
    cursor: pointer; display: flex; flex-direction: column; gap: 4px;
    opacity: 1; box-shadow: 0 6px 18px rgba(0,0,0,.25);
    transform: translateX(var(--side-offset)) scale(.96);
    transition: transform .25s ease;
    user-select: none;
  }
  .lb-side-prev { --side-offset: -52%; }
  .lb-side-next { --side-offset: 52%; }
  .lb-side::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background: rgba(0,0,0,.2); pointer-events: none;
    transition: background .25s ease;
  }
  .lb-side-far { width: 34%; max-width: 490px; z-index: 1; opacity: 1; cursor: default; }
  .lb-side-far::after { background: rgba(0,0,0,.4); }
  .lb-side-prev2 { --side-offset: calc(-50vw + 44%); }
  .lb-side-next2 { --side-offset: calc(50vw - 44%); }
  .lb-side:not(.lb-side-far):hover::after, .lb-side:not(.lb-side-far):focus-visible::after { background: transparent; }
  .lb-side:not(.lb-side-far):hover, .lb-side:not(.lb-side-far):focus-visible {
    opacity: 1; transform: translateX(var(--side-offset)) translateY(-8px) scale(1);
    z-index: 11;
  }
  .lb-side-thumb { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 8px; background: #000; display: block; }
  .lb-side-title { font-size: 11px; color: var(--muted); line-height: 1.3; text-align: center; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .lb-side.hidden { visibility: hidden; pointer-events: none; }
  /* Navigation spring uses independent translate/scale properties, preserving
     the layout/hover transforms and opaque cards. No idle or hover bounce on far cards. */
  .lb-side:not(.lb-side-far) { transition: transform .3s cubic-bezier(.22,1.25,.36,1); }

  /* ═══════════ 🎛️ COMPACT BOTTOM BAR (μία γραμμή) ═══════════ */
  .lb-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* αριστερά | κέντρο | δεξιά */
    align-items: center;                    /* ⬅️ ΟΛΑ κατακόρυφα κεντραρισμένα */
    gap: 10px;
    min-height: 46px;
  }
  .lb-bottom > div { min-height: 46px; display: flex; align-items: center; }
  .lb-bottom-left {
    display: flex; align-items: center; gap: 6px;
    justify-self: start;
    font-size: 12.5px; color: var(--muted);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .lb-bottom-center { display: flex; align-items: center; gap: 8px; justify-self: center; }
  .lb-bottom-right { display: flex; align-items: center; gap: 8px; justify-self: end; }
  .lb-time-sep { opacity: .45; }
  .lb-skip-num { font-size: 10.5px; opacity: .85; margin: 0 1px; }
  .lb-note-compact {
    height: 38px; padding: 0 14px; border-radius: 50px; border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent2));  /* 🎯 μπλε gradient */
    color: #fff; font-size: 13px; font-weight: 600;
    cursor: pointer; box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 40%, transparent);
    display: inline-flex; align-items: center; justify-content: center;  /* 🎯 ΑΠΟΛΥΤΟ κέντρο */
    line-height: 1; gap: 5px; text-align: center;
    transition: transform .14s, filter .14s;
  }
  .lb-note-compact:hover { transform: translateY(-1px); filter: brightness(1.06); }
  .lb-note-compact:active { transform: translateY(0); }
  .lb-note-compact:hover { transform: translateY(-1px); filter: brightness(1.08); }
  .lb-note-compact:active { box-shadow: var(--silk-inset-soft); }

  /* ═══════════ 🐇 PLAYBACK SPEED (κάθετο popup) ═══════════ */
  .lb-speed-wrap { position: relative; display: inline-flex; }
  .lb-speed-btn {
    height: 38px; padding: 0 12px; border-radius: 50px; border: none;
    background: var(--bg); color: var(--text);
    font-size: 13px; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, box-shadow .12s, color .12s;
    white-space: nowrap;
  }
  .lb-speed-btn svg { width: 19px; height: 19px; display: block; }
  .lb-speed-btn:hover { color: var(--accent); transform: translateY(-1px); }
  .lb-speed-btn:active { box-shadow: var(--silk-inset-soft); }
  .lb-speed-btn.active { color: var(--accent); }
  .lb-speed-val { font-variant-numeric: tabular-nums; font-size: 12.5px; min-width: 30px; text-align: right; }

  /* το κάθετο overlay — ανοίγει ΠΡΟΣ ΤΑ ΠΑΝΩ, δεν σπρώχνει τίποτα */
  .lb-speed-popup {
    position: absolute; bottom: calc(100% + 12px); left: 0;
    z-index: 20;
    background: var(--bg); border-radius: 16px; padding: 14px 14px 10px;
    box-shadow: 0 18px 50px rgba(0,0,0,.4), var(--silk-extruded);
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    opacity: 0; transform: translateY(8px) scale(.96); pointer-events: none;
    transition: opacity .2s ease, transform .2s cubic-bezier(.2,.8,.3,1);
    width: 210px;
  }
  .lb-speed-popup.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
  .lb-speed-head { font-size: 12.5px; font-weight: 700; color: var(--muted); }

  /* 🌡️ ΘΕΡΜΟΜΕΤΡΟ — στενή κάψουλα + floating badges */
  .lb-thermo {
    position: relative; display: flex; align-items: stretch; gap: 8px;
    padding: 2px 0;
  }
  /* ο άξονας: λεπτή κάψουλα */
  .lb-speed-range {
    position: relative; width: 7px; height: 210px; margin: 10px 7px;
    flex: 0 0 7px; border-radius: 999px; background: var(--border);
    touch-action: none; cursor: pointer; --speed-position: 42.857%;
  }
  .lb-speed-range::before { content: ""; position: absolute; inset: -10px -9px; }
  .lb-speed-thumb {
    position: absolute; left: 50%; bottom: var(--speed-position);
    width: 18px; height: 18px; border: 2px solid var(--bg); border-radius: 50%;
    background: var(--accent); transform: translate(-50%, 50%); pointer-events: none;
  }
  .lb-speed-range:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  /* 🏷️ floating badges: λιτά, χωρίς πλαίσιο */
  .lb-speed-ticks {
    display: flex; flex-direction: column; justify-content: space-between;
    height: 218px; flex: 1 1 auto;
  }
  .lb-speed-tick {
    border: none; background: transparent; color: var(--muted);
    font-size: 11px; font-weight: 600; padding: 1px 0; border-radius: 6px;
    cursor: pointer; text-align: left; line-height: 1;
    transition: color .14s, transform .14s;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .lb-speed-tick:hover { color: var(--text); transform: translateX(3px); }
  .lb-speed-tick.on {
    color: #fff; font-weight: 800;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    padding: 2px 7px; margin-left: -3px;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  /* 🧊 το popup = στενή κάψουλα glass */
  .lb-speed-popup {
    width: auto; min-width: 0;
    padding: 12px 12px 10px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .lb-speed-head { font-size: 11px; letter-spacing: .04em; text-transform: uppercase; opacity: .7; }



  /* 📱 responsive */
  @media (max-width: 860px) {
    .lb-speed-popup { width: 180px; padding: 12px 12px 8px; }
    .lb-speed-range { height: 150px; }
    .lb-speed-val { display: none; }
  }
  .lb-ctrl {
    height: 38px; min-width: 40px; padding: 0 10px; border-radius: 50px;
    border: none; background: var(--bg); color: var(--text);
    font-size: 15px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, box-shadow .12s, color .12s;
    font-variant-numeric: tabular-nums;
  }
  .lb-ctrl:hover { color: var(--accent); transform: translateY(-1px); }
  .lb-ctrl:active { box-shadow: var(--silk-inset-soft); transform: translateY(1px); }
  .lb-ctrl-play {
    width: 46px; min-width: 46px; height: 46px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff; font-size: 19px;
  }
  .lb-ctrl-play:hover { color: #fff; transform: scale(1.06); }
  /* 🎯 τα μονά βελάκια (±5s): πιο διακριτικά από τα 20άρια */
  .lb-ctrl-step { min-width: 34px; padding: 0 8px; opacity: .92; }
  /* 🎯 hover στα άκρα → η κάρτα σηκώνεται σαν να την άγγιξες (ίδιο look με :hover) */
  .lb-side.hover-preview {
    opacity: 1;
    transform: translateX(var(--side-offset)) translateY(-8px) scale(1);
    z-index: 11;
  }
  .lb-side.hover-preview::after { background: transparent; }
  .lb-ctrl-step:hover { color: var(--accent); }
  .lb-skip-num { color: inherit; }

  /* ═══════════ 📊 PROGRESS ═══════════ */
  .lb-progress-wrap { display: flex; align-items: center; gap: 10px; margin-top: 2px; }
  .lb-time { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; min-width: 38px; text-align: center; }
  .lb-progress {
    flex: 1 1 auto; height: 6px; border-radius: 999px; background: var(--bg);
    box-shadow: var(--silk-inset-soft); cursor: pointer; position: relative; overflow: hidden;
  }
  .lb-progress-fill {
    height: 100%; width: 0%; border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transition: width .2s linear;
  }
  .lb-progress:hover { height: 8px; }

  /* 🔴 MARKERS: τελείες σημειώσεων πάνω στη progress bar */
  .lb-marker {
    position: absolute; top: 50%;
    width: 9px; height: 9px; border-radius: 50%;
    background: #ff3b5c; border: 1.5px solid #fff;
    transform: translate(-50%, -50%);
    z-index: 3; cursor: pointer; padding: 0;
    box-shadow: 0 0 5px rgba(0,0,0,.45);
    transition: transform .16s ease;
  }
  .lb-marker:hover { transform: translate(-50%, -50%) scale(1.5); }
  .lb-progress { overflow: visible; }   /* να φαίνονται οι τελείες */
  .lb-progress-fill { border-radius: 999px; }

  /* ═══════════ 📝 NOTES SIDEBAR ═══════════ */
  .lb-notes-panel {
    position: absolute; top: 14px; right: 14px; bottom: 14px;
    width: 300px; max-width: 82vw; z-index: 50;   /* 🎯 ΠΑΝΩ από βίντεο (10) και speed (20) */
    background: var(--bg); border-radius: 16px; padding: 14px;
    display: flex; flex-direction: column; gap: 10px;
    box-shadow: 0 18px 50px rgba(0,0,0,.35), var(--silk-extruded);
    transform: translateX(calc(100% + 22px)); opacity: 0;
    transition: transform .28s cubic-bezier(.2,.8,.3,1), opacity .28s ease;
    pointer-events: none;
  }
  .lb-notes-panel.open { transform: translateX(0); opacity: 1; pointer-events: auto; }
  .lb-notes-head {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 14px; font-weight: 700;
  }
  .lb-notes-close {
    border: none; background: var(--bg); color: var(--muted);
    width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
    box-shadow: var(--silk-extruded-soft); font-size: 13px;
  }
  .lb-notes-close:hover { color: var(--danger, #e5533d); }
  .lb-notes-panel .lb-notes { margin-top: 0; max-height: none; flex: 1 1 auto; overflow-y: auto; }
  .lb-notes-add { margin-top: auto; }
  .lb-notes-add .lb-note-btn { width: 100%; justify-content: center; }
  /* 📱 σε στενές οθόνες: το sidebar γίνεται full-width overlay */
  @media (max-width: 860px) {
    .lb-notes-panel { width: auto; left: 14px; right: 14px; }
    .lb-side { width: 22%; min-width: 90px; }
    .lb-dialog { width: 98vw; padding: 10px; }
    .lb-bottom-left .lb-time-sep, .lb-bottom-left #lb-time-tot { display: none; }  /* χώρος */
    .lb-ctrl { height: 34px; min-width: 36px; padding: 0 8px; font-size: 13px; }
    .lb-ctrl-play { width: 42px; min-width: 42px; height: 42px; }
    .lb-note-compact { padding: 0 10px; }
  }
  .lb-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .lb-loading {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--muted); font-size: 14px;
  }
  .lb-blocked {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px;
    background: radial-gradient(circle at 50% 40%, #1a1f2b, #000);
    padding: 20px; text-align: center;
  }
  .lb-blocked-thumb { max-width: 60%; max-height: 45%; border-radius: 8px; border: 1px solid var(--border); }
  .lb-blocked-title { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.35; }
  .lb-blocked-btn {
    padding: 10px 22px; border-radius: 999px; border: none;
    background: var(--accent); color: var(--accent-fg); font-size: 14px; font-weight: 700;
    cursor: pointer; transition: transform .12s, filter .12s;
  }
  .lb-blocked-btn:hover { transform: scale(1.05); filter: brightness(1.08); }
  .lb-controls {
    display: flex; align-items: center; justify-content: center; gap: 14px;
  }
  .lb-nav {
    width: 44px; height: 44px; border-radius: 50%;
    border: none; background: var(--bg);
    color: var(--text); font-size: 17px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, box-shadow .12s, opacity .12s;
  }
  .lb-nav:hover { transform: scale(1.08); }
  .lb-nav:active { box-shadow: var(--silk-inset-soft); }
  .lb-nav:disabled { opacity: .3; cursor: default; transform: none; box-shadow: none; }
  .lb-pos { font-size: 13px; color: var(--muted); min-width: 46px; text-align: center; font-variant-numeric: tabular-nums; }
  .lb-add {
    width: 44px; height: 44px; border-radius: 50%;
    border: none; background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff; font-size: 19px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, filter .12s, box-shadow .12s;
  }
  .lb-add:hover { transform: scale(1.1); filter: brightness(1.08); }
  .lb-add:active { box-shadow: var(--silk-inset-soft); }
  /* Το «magic moment»: όταν προστίθεται ένα βίντεο, το ➕ γίνεται ✓ με spring + draw. */
  .lb-add.added {
    background: #22c55e;
    border-color: #22c55e;
    color: #fff;
    animation: add-pop .55s cubic-bezier(.18,.9,.32,1.35);
  }
  @keyframes add-pop {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.4); }
    60%  { transform: scale(.86); }
    80%  { transform: scale(1.08); }
    100% { transform: scale(1); }
  }
  @keyframes check-draw { to { stroke-dashoffset: 0; } }
  .lb-add.added svg, .lb-add.added .add-check { display: block; }
  .lb-dismiss {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--danger, #e5533d); background: var(--danger, #e5533d);
    color: #fff; font-size: 17px; font-weight: 700; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(0,0,0,.3);
    transition: transform .12s, filter .12s;
  }
  .lb-dismiss:hover { transform: scale(1.1); filter: brightness(1.08); }
  .lb-note-btn {
    height: 44px; padding: 0 16px; border-radius: 50px;
    border: none; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff;
    font-size: 14px; cursor: pointer; white-space: nowrap;
    display: flex; align-items: center; gap: 6px;
    box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, box-shadow .12s, filter .12s;
  }
  .lb-note-btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
  .lb-note-btn:active { box-shadow: var(--silk-inset-soft); transform: translateY(0); }
  .lb-notes { margin-top: 14px; max-height: 180px; overflow-y: auto; font-size: 13px; }
  .lb-note-item {
    display: flex; align-items: flex-start; gap: 10px;
    background: var(--bg); border: none; border-radius: 14px;
    padding: 10px 12px; margin-bottom: 8px; text-align: left;
    box-shadow: var(--silk-extruded-soft);
  }
  .lb-note-ts {
    flex: 0 0 auto; padding: 3px 10px; border-radius: 999px;
    background: var(--bg); color: var(--accent); font-weight: 700; font-size: 12px;
    font-variant-numeric: tabular-nums; cursor: pointer;
    white-space: nowrap; box-shadow: var(--silk-inset-soft);
  }
  .lb-note-body { flex: 1; min-width: 0; }
  .lb-note-title { font-weight: 600; margin-bottom: 2px; }
  .lb-note-text { color: var(--muted); word-wrap: break-word; }
  .lb-note-del {
    flex: 0 0 auto; border: none; background: var(--bg); color: var(--muted);
    cursor: pointer; font-size: 14px; padding: 6px 8px; border-radius: 10px;
    box-shadow: var(--silk-extruded-soft);
    transition: color .12s, box-shadow .12s;
  }
  .lb-note-del:hover { color: var(--danger, #e5533d); }
  .lb-note-del:active { box-shadow: var(--silk-inset-soft); }
  .lb-note-empty { color: var(--muted); padding: 6px 2px; }
  /* φόρμα note */
  .lb-note-form {
    background: var(--bg); border: none; border-radius: 16px;
    padding: 14px; margin-bottom: 10px; display: flex; flex-direction: column; gap: 8px;
    text-align: left; box-shadow: var(--silk-extruded);
  }
  .lb-note-form input, .lb-note-form textarea {
    background: var(--bg); border: none; border-radius: 10px;
    color: var(--text); font-size: 13px; padding: 10px 12px; width: 100%;
    font-family: inherit; box-shadow: var(--silk-inset-soft);
    outline: none;
  }
  .lb-note-form input:focus, .lb-note-form textarea:focus {
    box-shadow: var(--silk-inset-soft), 0 0 0 2px var(--accent);
  }
  .lb-note-form textarea { min-height: 56px; resize: vertical; }
  .lb-note-form-row { display: flex; gap: 8px; align-items: center; }
  .lb-note-form .ts-label { color: var(--accent); font-weight: 700; font-size: 12px; white-space: nowrap; }
  .lb-note-form-actions { display: flex; gap: 8px; justify-content: flex-end; }
  .lb-note-form-actions button {
    border: none; background: var(--bg); color: var(--text);
    border-radius: 50px; padding: 8px 16px; cursor: pointer; font-size: 13px;
    box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .12s, transform .12s;
  }
  .lb-note-form-actions button:hover { transform: translateY(-1px); }
  .lb-note-form-actions button:active { box-shadow: var(--silk-inset-soft); transform: translateY(0); }
  .lb-note-form-actions button.primary { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; font-weight: 600; }

  /* 🔍 YouTube Αναζήτηση (tab) */
  .yt-search-box { max-width: 760px; margin-bottom: 14px; position: relative; }
  .yt-search-status { margin: 0 0 12px; color: var(--muted); font-size: 14px; display: flex; align-items: center; gap: 10px; }
  
  .yt-search-status .spin {
    width: 16px; height: 16px; flex: 0 0 auto;
    border: 2px solid var(--border); border-top-color: var(--accent);
    border-radius: 50%; animation: rss-spin .7s linear infinite;
  }
  .yt-empty { color: var(--muted); font-size: 15px; padding: 24px 0; text-align: center; }
  .yt-sec-title {
    font-size: 15px; font-weight: 700; margin: 16px 0 8px; color: var(--text);
    display: flex; align-items: center; gap: 8px;
  }
  .yt-videos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; width: 100%; max-width: 100%; }
  /* 🚀 VIRTUAL SCROLLING (ασφαλής εκδοχή):
     Ο browser ΔΕΝ ζωγραφίζει τις κάρτες εκτός οθόνης — αλλά το ύψος μένει,
     οπότε η μπάρα κύλισης δεν «πηδά» και το scroll παραμένει ομαλό.
     Είναι το ίδιο που κάνουν YouTube/Netflix: το DOM μένει, το ΖΩΓΡΑΦΙΣΜΑ περιορίζεται. */
  .yt-video {
    /* ✅ ΑΣΦΑΛΕΣ: οι κάρτες αναζήτησης ΔΕΝ έχουν lift → content-visibility OK.
       (Στο .v-card / .channel-group ΑΠΑΓΟΡΕΥΕΤΑΙ — σπάει το position:fixed του lift.) */
    content-visibility: auto;
    contain-intrinsic-size: auto 293px;
    display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 18px;
    background: var(--bg); border: none;
    box-shadow: var(--silk-extruded);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .yt-video:hover {
    transform: translateY(-4px);
    box-shadow: var(--silk-extruded), 0 0 0 2px var(--accent);
  }
  .yt-video:active { box-shadow: var(--silk-inset); }
  .yt-thumb-wrap { position: relative; width: 100%; aspect-ratio: 16/9; cursor: pointer; overflow: hidden; border-radius: 8px; }
  .yt-thumb-ph { position: absolute; inset: 0; background: linear-gradient(110deg, var(--card) 8%, var(--hover) 18%, var(--card) 33%); background-size: 200% 100%; animation: thumb-shimmer 1.6s linear infinite; }
  /* 🎨 ΕΛΑΦΡΥ blur-up: 20px → 4px ΚΑΙ χωρίς scale.
     Το blur(20px) + scale(1.08) ήταν το πιο ακριβό GPU φίλτρο × κάθε κάρτα.
     Στο light theme δεν φαινόταν καν — αλλά το πληρώναμε σε κάθε φόρτωση. */
  .yt-thumb { position: relative; width: 100%; height: 100%; object-fit: cover; border-radius: 8px; display: block; opacity: 0; filter: blur(4px); transition: filter .35s ease-out, opacity .35s ease-out; }
  .yt-thumb.loaded { opacity: 1; filter: blur(0); }
  .yt-play-icon {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 34px; color: #fff; opacity: 0; transition: opacity .15s;
    background: rgba(0,0,0,.25); border-radius: 8px; text-shadow: 0 2px 10px rgba(0,0,0,.6);
  }
  .yt-thumb-wrap:hover .yt-play-icon { opacity: 1; }
  .yt-dur {
    position: absolute; right: 6px; bottom: 6px; background: rgba(0,0,0,.8);
    color: #fff; font-size: 12px; padding: 2px 6px; border-radius: 4px;
  }
  .yt-video-title {
    font-size: 14.5px; font-weight: 600; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .yt-video-meta { font-size: 12.5px; color: var(--muted); }
  .yt-add-btn { align-self: center; }
  .yt-btn {
    padding: 8px 16px; border-radius: 999px; border: none; cursor: pointer;
    font-size: 13px; font-weight: 700; box-shadow: var(--silk-extruded-soft);
    transition: transform .12s, filter .12s, box-shadow .12s;
  }
  .yt-btn.add { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; }
  /* ✅ Το «magic moment»: όταν προστίθεται από την καρτέλα → πρασινίζει + ✓ + pop. */
  .yt-btn.add.added {
    background: #22c55e; border-color: #22c55e; color: #fff;
    animation: add-pop .55s cubic-bezier(.18,.9,.32,1.35);
    pointer-events: none;
  }
  .yt-btn.watch { background: var(--bg); color: var(--text); }
  .yt-btn.watched { background: var(--bg); color: var(--accent); box-shadow: var(--silk-inset-soft); cursor: default; animation: watch-pop .35s cubic-bezier(.18,.9,.32,1.3); }
  @keyframes watch-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }
  .yt-btn:hover { transform: scale(1.04); filter: brightness(1.06); }
  .yt-btn:active { box-shadow: var(--silk-inset-soft); transform: scale(.97); }
  .yt-search-sticky {
    position: sticky; top: 0; z-index: 30;
    background: transparent;   /* ίδιο με το φόντο — χωρίς χρωματική διαφορά */
    padding: 8px 20px 6px;
    /* 🌫️ Frosted glass: θολώνει ό,τι περνά από κάτω του ΌΤΑΝ σκρολάρει (.scrolled). */
    backdrop-filter: blur(0px); -webkit-backdrop-filter: blur(0px);
    transition: backdrop-filter .25s ease, -webkit-backdrop-filter .25s ease;
  }
  /* Full-bleed frost σε ξεχωριστό layer (absolute, εκτός flow) — πίσω από το κεντραρισμένο περιεχόμενο. */
  .yt-search-sticky::before {
    content: ""; position: absolute; z-index: -1;
    left: calc(50% - 50vw); right: calc(50% - 50vw);
    top: 0; bottom: 0;
    background: var(--bg); opacity: 0; pointer-events: none;
    transition: opacity .25s ease;
  }
  .yt-search-sticky.scrolled {
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .yt-search-sticky.scrolled::before {
    opacity: 0.9;
    /* Λεπτή ανοιχτόχρωμη γραμμή (glow) στο κάτω άκρο — ανάλογα με το θέμα. */
    border-bottom: 1px solid var(--border);
    box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--border) 80%, transparent);
  }
  /* 🧊 Κοινό frosted-glass sticky για όλα τα tabs (Κανάλια / Κατηγορίες / Αναζήτηση). */
  .sticky-head {
    position: sticky; top: 0; z-index: 30;
    background: transparent;
    padding: 8px 20px 6px;
    backdrop-filter: blur(0px); -webkit-backdrop-filter: blur(0px);
    transition: backdrop-filter .25s ease, -webkit-backdrop-filter .25s ease;
  }
  .sticky-head::before {
    content: ""; position: absolute; z-index: -1;
    left: calc(50% - 50vw); right: calc(50% - 50vw);
    top: 0; bottom: 0;
    background: var(--bg); opacity: 0; pointer-events: none;
    transition: opacity .25s ease;
  }
  .sticky-head.scrolled {
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .sticky-head.scrolled::before {
    opacity: 0.9;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--border) 80%, transparent);
  }
  .yt-recent {
    position: absolute; left: 0; right: 0; top: calc(100% + 4px);
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    box-shadow: 0 8px 28px rgba(0,0,0,.4); padding: 6px; z-index: 40;
    min-width: 560px;   /* 📐 χωράει το πλέγμα 6 στηλών */
  }
  .yt-recent-item {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 10px; border-radius: 7px; cursor: pointer; font-size: 14px;
  }
  .yt-recent-item:hover { background: color-mix(in srgb, var(--card) 60%, var(--accent) 14%); }
  /* 📐 Πλέγμα 6 στηλών για τις πρόσφατες αναζητήσεις (όλες σε ένα dropdown, δίπλα-δίπλα). */
  .yt-recent-grid {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2px;
  }
  .yt-recent-grid .yt-recent-item {
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    font-size: 12.5px; padding: 6px 8px;
  }
  .yt-recent-head {
    font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
    padding: 4px 10px 6px;
  }

  .yt-modes { display: flex; gap: 8px; margin: 0 0 14px; width: 100%; max-width: 100%; }
  .yt-mode {
    padding: 8px 18px; border-radius: 999px; border: none;
    background: var(--bg); color: var(--text); font-size: 13px; font-weight: 600;
    cursor: pointer; box-shadow: var(--silk-extruded-soft);
    transition: box-shadow .12s, color .12s;
  }
  .yt-mode.active { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; box-shadow: var(--silk-extruded-soft); }
  .yt-mode:hover { color: var(--accent); }
  .yt-mode:active { box-shadow: var(--silk-inset-soft); }

  /* 🫧 Bubble Field — αιωρούμενα θέματα (trending) στην αρχική σελίδα αναζήτησης */
  #bubble-field {
    position: relative;
    width: 100%;
    height: 460px;
    border-radius: 0;       /* ίδιο φόντο με τη σελίδα — αόρατο */
    overflow: hidden;
    margin: 4px 0 18px;
    background: transparent;  /* ΚΑΝΕΝΑ φόντο → τα bubbles «βγαίνουν από το πουθενά» */
    cursor: default;
  }
  #bubble-field canvas { position: absolute; inset: 0; display: block; }

  .yt-channels {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px; width: 100%; max-width: 100%;   /* 🎯 χωρίς cap — να μη κόβεται καμία */
  }
  .yt-channel {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    padding: 18px 12px; border-radius: 18px;
    background: var(--bg); border: none;
    cursor: pointer; text-align: center;
    box-shadow: var(--silk-extruded);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .yt-channel:hover {
    transform: translateY(-4px);
    box-shadow: var(--silk-extruded), 0 0 0 2px var(--accent);
  }
  .yt-channel:active { box-shadow: var(--silk-inset); }
  .yt-channel-logo-wrap { width: 100%; display: flex; justify-content: center; position: relative; }
  .yt-channel-avatar-ph { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 128px; height: 128px; border-radius: 16px; background: linear-gradient(110deg, var(--card) 8%, var(--hover) 18%, var(--card) 33%); background-size: 200% 100%; animation: thumb-shimmer 1.6s linear infinite; }
  .yt-channel-avatar { width: 128px; height: 128px; border-radius: 16px; object-fit: cover; opacity: 0; filter: blur(4px); transition: filter .35s ease-out, opacity .35s ease-out; }
  .yt-channel-avatar.loaded { opacity: 1; filter: blur(0); }
  .yt-channel-name {
    font-size: 14px; font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  
  .yt-next-wrap { display: flex; justify-content: center; margin: 20px 0 8px; width: 100%; max-width: 100%; }
  /* «Επόμενα» μέσα στο κανάλι: ίδιο ύφος με το κουμπί της αναζήτησης, στο ΤΕΛΟΣ της λίστας. */
  .yt-sentinel { height: 1px; width: 100%; }
  .yt-next-btn {
    padding: 9px 22px; border: none; border-radius: 999px; cursor: pointer;
    background: var(--card); color: var(--text); font-weight: 600; font-size: 14px;
    box-shadow: var(--silk-extruded-soft, 0 2px 8px rgba(0,0,0,.08));
    transition: transform .12s, filter .12s;
  }
  .yt-next-btn:hover { transform: scale(1.04); filter: brightness(1.05); }
  .yt-next-btn:active { box-shadow: var(--silk-inset-soft, inset 0 2px 6px rgba(0,0,0,.12)); transform: scale(.98); }
  .yt-next-btn:disabled { cursor: default; transform: none; }
  /* 🏁 Διακριτικό σημείο τέλους — όχι κουμπί, μόνο μια ανάσα. */
  .yt-the-end {
    font-size: 13px; letter-spacing: .12em; text-transform: lowercase;
    color: var(--muted); opacity: .55; user-select: none; padding: 6px 0;
  }
  .yt-next-wrap .spin { margin-right: 6px; }
  .yt-loading {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 18px 0; color: var(--muted); font-size: 14px;
  }
  .yt-loading .spin {
    width: 16px; height: 16px; flex: 0 0 auto;
    border: 2px solid var(--border); border-top-color: var(--accent);
    border-radius: 50%; animation: rss-spin .7s linear infinite;
  }
  /* ⏳ Loading indicator που δείχνει ότι η λίστα «ξαναχτίζεται» (μετά από add/delete). */
  #list-loading {
    display: none; align-items: center; justify-content: center; gap: 10px;
    padding: 22px 0; color: var(--muted); font-size: 14px;
  }
  #list-loading.show { display: flex; }
  #list-loading .spin {
    width: 20px; height: 20px; flex: 0 0 auto;
    border: 2px solid var(--border); border-top-color: var(--accent);
    border-radius: 50%; animation: rss-spin .7s linear infinite;
  }

  /* 👁️ Channel window (eye) — σαν το video lightbox */
  .cw-dialog {
    background: var(--bg); border: none; border-radius: 20px;
    width: min(560px, 92vw); max-height: 82vh; overflow-y: auto;
    padding: 22px; position: relative; box-shadow: var(--silk-extruded), 0 24px 80px rgba(0,0,0,.4);
  }
  .cw-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .cw-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .cw-title { flex: 1; font-size: 18px; font-weight: 700; line-height: 1.3; min-width: 0; }
  .cw-videos-title { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 8px; }
  .cw-videos { display: flex; flex-direction: column; gap: 8px; }
  .cw-video { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 10px; background: var(--bg, #111); cursor: pointer; }
  .cw-video:hover { background: color-mix(in srgb, var(--card) 60%, var(--accent) 14%); }
  .cw-video-thumb { width: 96px; aspect-ratio: 16/9; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .cw-video-title { font-size: 13.5px; font-weight: 500; line-height: 1.3; }

  /* 📱 Responsive ladder — 4 → 3 → 2 → 1.
     Base (>1240px): 4 στήλες παντού. Κάθε βήμα ΚΑΤΕΒΑΙΝΕΙ μία στήλη. */
  @media (max-width: 1240px) {
    .yt-videos   { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .yt-channels { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .v-card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 1000px) {
    .yt-videos   { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .yt-channels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .v-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    body { padding: 20px 14px; }
  }
  @media (max-width: 700px) {
    .yt-videos   { grid-template-columns: minmax(0, 1fr); }
    .yt-channels { grid-template-columns: minmax(0, 1fr); }
    .v-card-grid { grid-template-columns: minmax(0, 1fr); }
    .yt-video-title { -webkit-line-clamp: 2; }
  }
  @media (max-width: 480px) {
    body { padding: 14px 10px; }
    .yt-channels { gap: 10px; }
    .v-card-grid { gap: 10px; }
  }
  /* 📱 Tablet/κινητό: το search γίνεται sticky ΚΑΤΩ (όπως Pinterest) */
  @media (max-width: 900px) {
    .yt-search-sticky {
      position: sticky; top: auto; bottom: 0;
      border-top: 1px solid var(--border);
      padding: 8px 0 6px;
    }
    .yt-recent { top: auto; bottom: calc(100% + 4px); }
  }

  /* Player card contract: controls INSIDE; transparent shell; restrained shadows. */
  #lb .lb-dialog { width: min(1400px, 96vw); padding: 0; border: 0; background: transparent; box-shadow: none; }
  #lb .lb-close { top: -12px; right: -12px; z-index: 60; box-shadow: none; border: 1px solid var(--border); }
  #lb { overflow: clip; }
  #lb .lb-main { container-type: inline-size; }
  #lb .lb-bottom { width: 100%; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); gap: 6px; min-height: 34px; }
  #lb .lb-bottom > div { min-width: 0; min-height: 34px; gap: 4px; }
  #lb .lb-bottom-left { font-size: 11px; }
  #lb .lb-time { font-size: 11px; min-width: 0; }
  #lb .lb-ctrl { height: 30px; min-width: 30px; padding: 0 6px; font-size: 12px; }
  #lb .lb-ctrl-play { width: 34px; min-width: 34px; height: 34px; font-size: 16px; }
  #lb .lb-note-compact, #lb .lb-speed-btn { height: 30px; padding: 0 8px; font-size: 11px; }
  #lb .lb-speed-btn { color: var(--accent); }
  #lb .lb-speed-val { display: inline; font-size: 11px; min-width: 0; }
  #lb .lb-add, #lb .lb-dismiss { width: 30px; height: 30px; font-size: 14px; }
  #lb .lb-progress-wrap { width: 100%; margin: 0; height: 10px; flex-shrink: 0; }
  #lb .lb-progress { background: var(--border); box-shadow: none; }
  #lb button, #lb .lb-speed-range, #lb .lb-speed-tick.on, #lb .lb-marker { box-shadow: none; filter: none; text-shadow: none; }
  #lb .lb-side-far { box-shadow: 0 4px 12px rgba(0,0,0,.16); }
  #lb .lb-speed-popup { width: auto; padding: 10px; border-radius: 18px; background: var(--bg); backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: 0 5px 16px rgba(0,0,0,.18); }
  #lb .lb-speed-range { height: 210px; transform: none; writing-mode: horizontal-tb; direction: ltr; }
  #lb .lb-speed-ticks { height: 230px; flex-direction: column; justify-content: space-between; }
  #lb .lb-speed-tick { height: 20px; line-height: 20px; padding: 0 5px; margin: 0; }
  #lb .lb-speed-tick.on { padding: 0 5px; margin: 0; }
  #lb .lb-notes-panel { z-index: 50; box-shadow: 0 8px 24px rgba(0,0,0,.22); }
  #lb .lb-notes-panel:not(.open) { visibility: hidden; }
  @container (max-width: 670px) {
    #lb .lb-bottom-left #lb-time-tot, #lb .lb-bottom-left .lb-time-sep { display: none; }
  }
  @container (max-width: 540px) {
    #lb .lb-bottom { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
    #lb .lb-bottom-center { grid-row: 1; grid-column: 1 / -1; }
    #lb .lb-bottom-left { grid-row: 2; grid-column: 1; }
    #lb .lb-bottom-right { grid-row: 2; grid-column: 2; }
  }
  @media (max-width: 860px) {
    #lb .lb-main { width: 76%; }
    #lb .lb-side { width: 48%; min-width: 0; }
    #lb .lb-side-prev { --side-offset: -48%; }
    #lb .lb-side-next { --side-offset: 48%; }
    #lb .lb-side-far { width: 34%; }
    #lb .lb-side-prev2 { --side-offset: calc(-50vw + 44%); }
    #lb .lb-side-next2 { --side-offset: calc(50vw - 44%); }
  }
  @media (max-width: 560px) {
    #lb .lb-main { width: 94%; padding: 8px; }
    #lb .lb-side { display: none; }
  }
  @media (max-height: 600px) {
    #lb .lb-main .lb-frame { max-height: 48vh; }
    #lb .lb-speed-range { height: 140px; }
    #lb .lb-speed-ticks { height: 160px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #lb *, #lb *::before { animation: none !important; transition: none !important; }
  }

</style>
</head>
<body>
  <header>
    <h1>Privacy <span class="lock">YouTuber</span></h1>
    <span class="privacy-badge" id="privacy-badge">🔒 100% local</span>
  </header>

  <nav class="tabs" id="tabs">
      <button class="tab active" id="tab-search" data-tab="search" onclick="switchTab('search')"><span data-i18n="tab.search">Search</span></button>
      <button class="tab" id="tab-channels" data-tab="channels" onclick="switchTab('channels')"><span data-i18n="tab.channels">Channels</span></button>
      <button class="tab" id="tab-categories" data-tab="categories" onclick="switchTab('categories')"><span data-i18n="tab.categories">Categories</span></button>
      <button class="tab" id="tab-subs" data-tab="subs" onclick="switchTab('subs')">⚙️ <span data-i18n="tab.settings">Settings</span></button>
    </nav>

  <section id="view-channels" style="display:none">
    <div class="sticky-head" id="channels-head">
    <div class="add-box">
      <input type="text" id="add-url" data-i18n-placeholder="add.urlPh" placeholder="Paste a YouTube link here…" onkeydown="if(event.key==='Enter')addVideo()">
      <button onclick="addVideo()">➕ <span data-i18n="btn.add">Add</span></button>
    </div>
    <div class="search-box">
      <input type="text" id="search-input" data-i18n-placeholder="search.libPh" placeholder="Search your library (title, channel, tag, category)…" oninput="doSearch(this.value)" onkeydown="if(event.key==='Enter')doSearchNow()">
      <button class="input-clear" id="input-clear" data-i18n-title="btn.clear" title="Clear text" onclick="clearSearchText()" style="display:none">✕</button>
      <button id="search-btn" onclick="doSearchNow()">🔍</button>
      <span class="rating-filter" id="rating-filter" data-i18n-title="misc.starFilter" title="Filter by rating">
        <span class="stars" id="search-stars">
          <span class="st" onclick="setSearchRating(1)">★</span>
          <span class="st" onclick="setSearchRating(2)">★</span>
          <span class="st" onclick="setSearchRating(3)">★</span>
          <span class="st" onclick="setSearchRating(4)">★</span>
          <span class="st" onclick="setSearchRating(5)">★</span>
        </span>
        <span class="rf-clear" id="search-rating-clear" onclick="setSearchRating(0)">×</span>
      </span>
    </div>
    <div class="list-head">
      <button class="toggle-all" id="toggle-all" data-i18n-title="ch.openAll" title="Expand/collapse ALL channels" onclick="toggleAllChannels()">▾</button>
      <span class="list-head-lbl"><span data-i18n="ch.listTitle">Channels</span> <span class="list-head-count" id="list-head-count"></span><span class="filter-count" id="filter-count"></span></span>
      <button class="tag-filter-head" id="tag-filter-head" onclick="toggleTagPanel()">
        <span class="tag-filter-count-title">🏷️ Tags <span class="tag-filter-count" id="tag-total">(0)</span> <span class="tag-active-count" id="tag-active" data-i18n-suffix="misc.active">· 0 active</span></span>
        <span class="cat-chevron" id="tag-chevron">▾</span>
      </button>
    </div>
    <div class="tag-filter-panel" id="tag-filter-panel" style="display:none"></div>
    </div>
    <div id="list-loading"><span class="spin"></span> <span data-i18n="msg.loadingList">Loading list…</span></div>
    <div id="videos"></div>
  </section>

  <section id="view-categories" style="display:none">
    <div class="sticky-head" id="categories-head">
    <div class="cat-toolbar">
      <div class="cat-add">
        <input type="text" id="cat-new-input" placeholder="＋ new category (e.g. Hobbies, Work)…" onkeydown="if(event.key==='Enter')addCategory()">
        <button onclick="addCategory()">Add</button>
      </div>
    </div>
    <div class="search-box">
      <input type="text" id="cat-search-input" placeholder="Search categories (title, channel, tag)…" oninput="doCatSearch(this.value)" onkeydown="if(event.key==='Enter')doCatSearchNow()">
      <button id="cat-search-btn" onclick="doCatSearchNow()">🔍</button>
      <span class="rating-filter" title="Filter by rating">
        <span class="stars" id="cat-search-stars">
          <span class="st" onclick="setCatSearchRating(1)">★</span>
          <span class="st" onclick="setCatSearchRating(2)">★</span>
          <span class="st" onclick="setCatSearchRating(3)">★</span>
          <span class="st" onclick="setCatSearchRating(4)">★</span>
          <span class="st" onclick="setCatSearchRating(5)">★</span>
        </span>
        <span class="rf-clear" id="cat-rating-clear" onclick="setCatSearchRating(0)">×</span>
      </span>
    </div>
    <div class="list-head">
      <button class="toggle-all" id="toggle-all-cat" title="Expand/collapse ALL categories" onclick="toggleAllCategories()">▾</button>
      <span class="list-head-lbl">Categories <span class="list-head-count" id="list-head-cat-count"></span></span>
      <button class="tag-filter-head cat" id="cat-filter-head" onclick="toggleCatPanel()">
        <span class="tag-filter-count-title cat-title">📁 Categories <span class="tag-filter-count" id="cat-total">(0)</span> <span class="tag-active-count" id="cat-active">· 0 active</span></span>
        <span class="cat-chevron" id="cat-chevron">▾</span>
      </button>
    </div>
    <div class="tag-filter-panel" id="cat-filter-panel" style="display:none"></div>
    </div>
    <div id="categories-list"></div>
      </section>

      <section id="view-subs" style="display:none">
        <!-- ⚙️ Settings — εδώ: database (εξαγωγή/εισαγωγή) · ενημερώσεις · θέμα -->

        <div class="settings-card">
          <div class="settings-card-title">💾 Your database</div>
          <div class="settings-card-body">
            Here you <b>import</b> and <b>export</b> the entire app database —
            your channels, categories, videos, searches and tags.
            <div class="settings-legend">
              <span><b>📦 Export</b> → saves a file with everything (for backup or another computer)</span>
              <span><b>📥 Import</b> → brings in a database from another machine, with <b>Replace</b> or <b>Merge</b></span>
            </div>
          </div>
          <div class="settings-toolbar">
            <button class="backup-btn" id="export-btn" onclick="doExport()">📦 Export</button>
            <button class="backup-btn" id="import-btn" onclick="doImport()">📥 Import</button>
            <span class="backup-status" id="backup-status"></span>
          </div>
        </div>

        <div class="settings-card">
          <div class="settings-card-title">🔄 Updates</div>
          <div class="settings-card-body">
            Check whether a newer version of PrivacyYouTuber is available.
          </div>
          <div class="settings-toolbar">
            <button class="backup-btn" id="update-btn" onclick="checkUpdate()" title="Check for a new version">🔄 Check for updates</button>
          </div>
        </div>

        <div class="settings-card">
          <div class="settings-card-title">🌗 Theme</div>
          <div class="settings-card-body">
            Light or dark — whatever suits you.
          </div>
          <div class="settings-toolbar">
            <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" aria-label="Αλλαγή θέματος (σκοτεινό / φωτεινό)">🌙</button>
            <span class="backup-status" id="theme-label">Dark / Light</span>
          </div>
        </div>

        <div class="settings-card">
          <div class="settings-card-title">📥 Import subscriptions (Google Takeout)</div>
          <div class="settings-card-body">
            Load your channel list from <b>Google Takeout</b>.
            <div class="settings-legend">
              <span><b>📥 Import Subscriptions</b> → channels are added to your <b>Channels</b>, at the end, in <b>yellow</b></span>
              <span><b>🔄</b> (on the yellow channel) → fetches its videos and makes it <b>regular</b></span>
            </div>
          </div>
          <div class="settings-toolbar">
            <button class="subs-btn subs-btn-primary" onclick="doImportSubscriptions()">📥 Import Subscriptions</button>
            <button class="subs-btn" onclick="openSubsHelp()">❓ Help</button>
          </div>
        </div>

      </section>

  <section id="view-search">
    <div class="yt-search-sticky">
      <div class="search-box yt-search-box">
        <input type="text" id="yt-search-input" placeholder="Search YouTube…" autocomplete="off" onfocus="showRecentSearches()" oninput="if(!this.value.trim()){document.getElementById('yt-search-results').innerHTML='';refreshBubbleField();}" onkeydown="if(event.key==='Enter')doYouTubeSearch()">
        <button id="yt-search-btn" onclick="doYouTubeSearch()">🔍</button>
        <div class="yt-recent" id="yt-recent" style="display:none"></div>
      </div>
      <div class="yt-modes" id="yt-modes">
        <button class="yt-mode active" id="ym-videos" onclick="setSearchMode('videos')">🎬 Videos</button>
        <button class="yt-mode" id="ym-channels" onclick="setSearchMode('channels')">📺 Channels</button>
      </div>
    </div>
    <div class="yt-search-status" id="yt-search-status" style="display:none"></div>
    <div id="bubble-field" style="display:none">
      <canvas id="bubble-canvas"></canvas>
    </div>
    <div id="yt-search-results"></div>
  </section>

  <!-- Popover για tagging -->
  <div class="tag-pop" id="tag-pop">
    <div class="tag-pop-head">🏷️ Tags <button class="tag-pop-close" onclick="closeTagPop()">×</button></div>
    <div class="tag-pop-list" id="tag-pop-list"></div>
    <div class="tag-pop-new">
      <input type="text" id="tag-pop-new-input" placeholder="+ new tag" onkeydown="if(event.key==='Enter')addNewTag()">
      <button onclick="addNewTag()">Add</button>
    </div>
  </div>

    <!-- 📥 Modal ΟΔΗΓΙΩΝ — πώς κάνεις export από Google Takeout -->
    <div class="subs-help-overlay" id="subs-help-overlay" onclick="if(event.target===this)closeSubsHelp()">
      <div class="subs-help-modal">
        <div class="subs-help-head">
          <span>❓ How to export from Google Takeout</span>
          <button class="tag-pop-close" onclick="closeSubsHelp()">×</button>
        </div>
        <div class="subs-help-body">
          <p>To get your YouTube <b>subscription list</b>, follow these steps:</p>
          <ol class="subs-help-steps">
            <li>Open <b>Google Takeout</b> (<b>takeout.google.com</b>) and sign in with your account.</li>
            <li>Click <b>"Deselect all"</b> (above the list) to uncheck everything.</li>
            <li>Scroll down the list and check <b>only</b> <b>"YouTube and YouTube Music"</b>.</li>
            <li>Click the <b>"Multiple formats"</b> button below it, and make sure <b>"Subscriptions"</b> is set to <b>CSV</b> or <b>JSON</b>.</li>
            <li>Click <b>"Next step"</b> (bottom right) → choose frequency <b>"Export once"</b> → <b>"Create export"</b>.</li>
            <li>Wait for the "Your export is ready" email — usually <b>a few minutes</b> (sometimes hours).</li>
            <li>Download the <b>.zip</b>, extract it and find <b>Takeout/YouTube and YouTube Music/</b> → file <b>subscriptions.csv</b> or <b>subscriptions.json</b>.</li>
            <li>Come back here, click <b>"📥 Import Subscriptions"</b>, pick the file — and <b>done!</b></li>
                    </ol>
          <div class="subs-help-note">
            💡 Το αρχείο περιέχει <b>μόνο</b> τα κανάλια που ακολουθείς. Τίποτα άλλο από τα δεδομένα σου δεν ανεβαίνει πουθενά — όλα μένουν <b>τοπικά</b>.
          </div>
        </div>
        <div class="subs-help-actions">
          <a class="subs-btn subs-btn-primary" href="https://takeout.google.com/" target="_blank" rel="noopener">🔗 Άνοιξε το Google Takeout</a>
          <button class="subs-btn" onclick="closeSubsHelp()">Κλείσιμο</button>
        </div>
      </div>
    </div>

  <!-- Popover για κατηγορίες -->
  <div class="tag-pop" id="cat-pop">
    <div class="tag-pop-head">📁 Κατηγορία <button class="tag-pop-close" onclick="closeCatPop()">×</button></div>
    <div class="tag-pop-list" id="cat-pop-list"></div>
    <div class="tag-pop-new">
      <input type="text" id="cat-pop-new-input" placeholder="+ νέα κατηγορία" onkeydown="if(event.key==='Enter')saveVideoCategory()">
      <button onclick="saveVideoCategory()">Add</button>
    </div>
  </div>

  <!-- Popover για pin (3 states) -->
  <div class="tag-pop" id="pin-pop">
    <div class="tag-pop-head">📌 Καρφίτσωμα <button class="tag-pop-close" onclick="closePinPop()">×</button></div>
    <div class="pin-pop-list" id="pin-pop-list"></div>
  </div>

<script src="i18n.js"></script>
<script>
async function load() {
  // ⏳ Δείξε το spinner την ώρα που φορτώνει η λίστα (μετά από add/delete/κλπ).
  let loadingEl = document.getElementById("list-loading");
  if (loadingEl) loadingEl.classList.add("show");
  const d = await (await fetch("/api/dashboard")).json();

  // Στατιστικά ΜΕΣΑ στο privacy bubble (κλειδαριά · 100% · βίντεο · κανάλια — ΟΧΙ προβολές)
  const s = d.stats || {};
  document.getElementById("privacy-badge").innerHTML =
    `🔒 100% τοπικά` +
    `<span class="sep">·</span><b>${s.videos ?? 0}</b> βίντεο` +
    `<span class="sep">·</span><b>${s.channel_count ?? 0}</b> κανάλια`;

  // Βιβλιοθήκη — group ανά κανάλι (με tag filter)
  allVideos = d.videos || [];
  ALL_TAGS = d.all_tags || [];
  CHANNEL_TAGS = d.channel_tags || {};
  ALL_CATEGORIES = d.all_categories || [];
  // 🎯 Memory state:
  //   - Κανάλια ΜΕ ανοιχτό News Feed (watched) → κλειστά ΜΟΝΟ στο αρχικό load (εξοικονόμηση πόρων).
  //   - Στα επόμενα re-render (add/remove/κλπ) → ΣΕΒΕΤΑΙ την τρέχουσα κατάσταση του χρήστη.
  WATCHED_CHANNELS = d.channel_watch || {};
  WATCHED_META = d.channel_watch_meta || {};
  const savedCollapsed = new Set(d.collapsed || []);
  if (!_initialized) {
    // ✅ ΝΕΟ (Γ): ΟΛΑ τα κανάλια ΚΛΕΙΣΤΑ εξαρχής. Ο χρήστης ανοίγει όποια θέλει και το θυμόμαστε.
    //    Μετανάστευση: τα «ανοιχτά» σήμερα γίνονται expanded, ώστε κανείς να μη χάσει τη δουλειά του.
    collapsedChannels = new Set();
    expandedChannels = new Set();
    const savedExpanded = new Set(d.expanded || []);
    if (savedExpanded.size > 0) {
      // Υπάρχει νέο state → σεβασμός (επιστροφή χρήστη).
      expandedChannels = new Set(savedExpanded);
    } else {
      // 🔄 ΜΕΤΑΝΑΣΤΕΥΣΗ (πρώτη φορά με το νέο build): ό,τι ΔΕΝ ήταν collapsed = expanded.
      (d.videos || []).forEach(v => {
        const key = v.channel_id || v.channel || "__unknown__";
        if (!savedCollapsed.has(key) && WATCHED_CHANNELS[key] !== 1) {
          expandedChannels.add(key);
        }
      });
    }
    _initialized = true;
  } else {
    // Re-render (add/remove/κλπ): ΜΗΝ πειράξεις ΚΑΘΟΛΟΥ το collapsedChannels.
    // Ο χρήστης έχει τον πλήρη έλεγχο μετά το αρχικό load.
    // (Τα ολοκαίνουρια κανάλια μένουν όπως τα δηλώνει το backend μετά το επόμενο restart.)
  }
  channelOrder = d.order || [];
  catOrder = d.cat_order || [];
  collapsedCats = new Set(d.cat_collapsed || []);
  pinnedCats = new Set(d.cat_pinned || []);
  rssShown = (typeof d.rss_shown === "number" && d.rss_shown >= 1) ? d.rss_shown : 6;
  // ↕️ Σειρά tabs (dragable) — αν δεν υπάρχει, μένει η default (Αναζήτηση/Κανάλια/Κατηγορίες).
  tabOrder = Array.isArray(d.tab_order) ? d.tab_order : [];
  applyTabOrder();
  // 🌙/☀️ Θέμα από τη βάση (επιμένει — το localStorage δεν κρατά στο WebView).
  if (d.theme === "dark" || d.theme === "light") {
    applyTheme(d.theme, false);
  }
  // ⏱️ Timestamp notes: ήρθαν μέσα στο dashboard (ένα request, ένα render).
  VIDEO_NOTES = d.video_notes || {};
  renderTagFilter();
  // ⚡ Lazy render: ζωγραφίζουμε ΜΟΝΟ το tab που φαίνεται. Τα υπόλοιπα σημειώνονται «βρώμικα»
  //    και ζωγραφίζονται όταν τα ανοίξεις (switchTab) — στην εκκίνηση δεν πληρώνουμε 1.500 κάρτες για κρυμμένα tabs.
  _chanDirty = true;
  _catDirty = true;
  if (currentTab === "channels") {
    renderCurrent();
    redrawRssPanels();
  } else if (currentTab === "categories") {
    renderCategories();
  }
  // ⏳ Κρύψε το spinner — η λίστα φορτώθηκε.
  loadingEl = document.getElementById("list-loading");
  if (loadingEl) loadingEl.classList.remove("show");
}

function shortDate(iso) {
  const d = new Date(iso || Date.now());
  return `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
}

/* --- Full-text search στο ιστορικό (τίτλος, κανάλι, tags, κατηγορία) --- */
let searchTimer = null;
let searchRating = 0;  // 0 = κανένα φίλτρο αστεριών, 1-5 = min rating

function setSearchRating(n) {
  searchRating = n;
  // ενημέρωσε τα αστεράκια (μόνο όσα πατήθηκαν ανάβουν)
  const stars = document.querySelectorAll("#search-stars .st");
  stars.forEach((s, i) => s.classList.toggle("on", i < n));
  // ✕ πάντα ορατό (μέσα στα αστεράκια) — κόκκινο + glow μόνο όταν υπάρχει ενεργό rating
  const clr = document.getElementById("search-rating-clear");
  if (clr) clr.classList.toggle("active", n > 0);
  // ξανασχεδίασε και τα tag chips (ώστε να κρυφτεί ο × όταν μπαίνουμε σε search mode)
  renderTagFilter();
  renderCurrent();
}

// Έξοδος από search/filter mode: καθαρίζει κείμενο + rating.
function clearSearch() {
  const inp = document.getElementById("search-input");
  if (inp) inp.value = "";
  setSearchRating(0);
  renderCurrent();
}

// Το ΕΝΙΑΙΟ σημείο rendering — ΠΡΟΣΘΕΤΙΚΟ (OR): κάθε κριτήριο ΠΡΟΣΘΕΤΕΙ αποτελέσματα.
// Ένα βίντεο εμφανίζεται αν ταιριάζει σε ΟΠΟΙΟΔΗΠΟΤΕ ενεργό κριτήριο (tag Ή rating Ή κείμενο).
function renderCurrent() {
  _chanDirty = false;
  const q = document.getElementById("search-input").value.trim();
  // Αν υπάρχει κείμενο → ασύγχρονη αναζήτηση στο backend (και εκεί OR).
  if (q) {
    runSearch(q);
    return;
  }
  // Χωρίς κείμενο: προσθετική ένωση (rating + tags).
  let res = unionFilters(allVideos);
  const hasFilter = searchRating > 0 || selectedTags.size > 0;
  ACTIVE_FILTER = hasFilter;
  document.getElementById("videos").innerHTML = renderVideos(res);
  setupDrag();
  updateToggleAllBtn();
  updateSearchClearBtn();
  fetchColors(res.map(v => v.video_id));
  if (hasFilter) showUnifiedBanner(res.length);
  else hideFilterBanner();
  // ✅ LAZY: μετά το re-render, γέμισε τα grids των καναλιών που είναι ΑΝΟΙΧΤΑ.
  if (currentTab === "channels") {
    document.querySelectorAll("#videos .channel-group").forEach(grp => {
      if (!grp.classList.contains("collapsed")) fillChannelGrid(grp);
    });
  }
  staggerFade();
}

// ⚡ Στιγμιαία εμφάνιση (χωρίς stagger/fade) — το αίτημα για «flawless ταχύτητα».
function staggerFade() {
  // No-op: τα βίντεα εμφανίζονται άμεσα, χωρίς καθυστέρηση.
}

// Ενώνει (OR) τα αποτελέσματα από κάθε ενεργό tag + το rating.
function unionFilters(res) {
  const active = searchRating > 0 || selectedTags.size > 0;
  if (!active) return res;
  const seen = new Set();
  const out = [];
  for (const v of res) {
    let match = false;
    for (const t of selectedTags) {
      if (videoTags(v).includes(t)) { match = true; break; }
    }
    if (!match && searchRating && (v.rating || 0) === searchRating) match = true;
    if (match && !seen.has(v.video_id)) {
      seen.add(v.video_id);
      out.push(v);
    }
  }
  return out;
}

// Άμεση αναζήτηση (button / Enter) — χωρίς debounce.
async function doSearchNow() {
  clearTimeout(searchTimer);
  const inp = document.getElementById("search-input");
  const q = inp ? inp.value : "";
  await runSearch(q);
}

// Live αναζήτηση καθώς πληκτρολογείς (με μικρό debounce).
function doSearch(q) {
  // Άμεση εμφάνιση του στρογγυλού × (χωρίς να περιμένει το debounce).
  const el = document.getElementById("input-clear");
  if (el) el.style.display = (q && q.trim()) ? "inline-flex" : "none";
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => runSearch(q), 150);
}

// Αναζήτηση με κείμενο (backend) — γράφει στο #videos, με εικονίδια. ΠΡΟΣΘΕΤΙΚΟ (OR):
// ένωση των αποτελεσμάτων κειμένου με τα tag/rating αποτελέσματα.
async function runSearch(q) {
  const qs = (q || "").trim();
  if (!qs) {
    // χωρίς κείμενο → γύρνα στο τοπικό φίλτρο (rating/tags)
    renderCurrent();
    return;
  }
  try {
    const d = await (await fetch("/api/search?q=" + encodeURIComponent(qs))).json();
    const textResults = d.results || [];
    // Προσθετική ένωση: κείμενο + tags + rating (χωρίς διπλότυπα).
    const seen = new Set();
    let out = [];
    const push = (arr) => {
      for (const v of arr) {
        if (!seen.has(v.video_id)) { seen.add(v.video_id); out.push(v); }
      }
    };
    push(textResults);
    if (searchRating > 0 || selectedTags.size > 0) {
      push(unionFilters(allVideos));
    }
    // 🎯 Αναζήτηση = ενεργό φίλτρο → όλα τα matching κανάλια ΑΝΟΙΓΟΥΝ.
    ACTIVE_FILTER = true;
    document.getElementById("videos").innerHTML = renderVideos(out);
    setupDrag();
    updateToggleAllBtn();
    updateSearchClearBtn();
    showUnifiedBanner(out.length);
  } catch {
    document.getElementById("videos").innerHTML = '<span class="empty">σφάλμα δικτύου</span>';
  }
}

// Ενεργό φίλτρο: αντί για μπλε μπάρα, δείχνει τον αριθμό βίντεο ΜΕΣΑ στο «Κανάλια».
function showUnifiedBanner(count) {
  hideFilterBanner();
  const fc = document.getElementById("filter-count");
  if (fc) fc.textContent = `· ${count} βίντεο`;
}

// Αφαιρεί ΜΟΝΟ τη λέξη αναζήτησης (κρατά τα tags/rating).
function removeSearchText() {
  document.getElementById("search-input").value = "";
  renderCurrent();
}

// Αφαιρεί ΜΟΝΟ αυτό το tag από το ΦΙΛΤΡΟ (δεν αγγίζει το tagging system).
function removeFilterTag(tag) {
  selectedTags.delete(tag);
  renderTagFilter();
  renderCurrent();
}

// Αφαιρεί ΜΟΝΟ το rating φίλτρο.
function removeRating() {
  setSearchRating(0);
}

/* --- Προσωπικό TAG system + rating --- */
let allVideos = [];
let SEARCH_VIDEOS = [];   // τελευταία αποτελέσματα αναζήτησης (για το floating player)
let SEARCH_MODE = "videos";  // "videos" | "channels" | "both"
let SEARCH_OFFSET = 0;        // σελίδα (offset) για τα βίντεο
let SEARCH_QUERY = "";        // τελευταίο query
let SEARCH_BUSY = false;
let SEARCH_HAS_MORE = false;  // υπάρχει επόμενη σελίδα;
let NEW_CHANNELS = new Set(); // κανάλια που προστέθηκαν πρόσφατα (μπλε banner)
let RECENT_SEARCHES = [];     // πρόσφατες αναζητήσεις (από τον server/SQLite)
let VIDEO_NOTES = {};         // video_id -> [notes] (για τα cards)
let ALL_TAGS = [];
let CHANNEL_TAGS = {};
let ALL_CATEGORIES = [];   // ταξινομημένη λίστα ονομάτων (από τη βάση)
let selectedTags = new Set();  // φίλτρο (κενό = όλα)
let tagPopTarget = null;
let tagPopBtn = null;
let catPopTarget = null;   // {type='video', id} για το popover κατηγορίας
let catPopBtn = null;
let currentTab = 'search';  // 'search' | 'channels' | 'categories'
let _chanDirty = true;      // τα Κανάλια χρειάζονται ξαναζωγράφισμα (νέα δεδομένα από load)
let _catDirty = true;       // οι Κατηγορίες χρειάζονται ξαναζωγράφισμα
// ξαναζωγράφισε τα RSS panels που είχαν ήδη φορτωθεί (χάνονται σε κάθε re-render των καναλιών)
function redrawRssPanels() {
  Object.keys(RSS_DATA).forEach(cid => {
    if (RSS_DATA[cid] !== undefined) renderRssPanel(cid);
  });
}
let collapsedCats = new Set(); // κατηγορίες που έκλεισε ο χρήστης στο tab Κατηγορίες
let selectedCats = new Set();  // κατηγορίες τσεκαρισμένες ως ΦΙΛΤΡΟ (κενό = όλες)
let catOrder = [];             // σειρά κατηγοριών (από τη βάση, επιμένει)
let tabOrder = [];             // ↕️ σειρά TABS (dragable, επιμένει στη βάση)
let pinnedCats = new Set();    // καρφιτσωμένες κατηγορίες (μωβ, επιμένει)
let collapsedChannels = new Set();  // legacy (συμβατότητα με παλιά δεδομένα)
let expandedChannels  = new Set();  // ✅ ΝΕΟ: ποια κανάλια ΑΝΟΙΞΕ ο χρήστης (default: ΟΛΑ ΚΛΕΙΣΤΑ)
let ACTIVE_FILTER = false;          // true όταν τρέχει φίλτρο (αναζήτηση/αστεράκια/tag) → matching ανοιχτά
let _initialized = false;           // true μετά το πρώτο load (ο κανόνας "watched→κλειστό" ισχύει μόνο αρχικά)
let channelOrder = [];              // από τη βάση (επιμένει & στο incognito)
let WATCHED_CHANNELS = {};          // map channel_id -> 1/0 (RSS watchdog toggle)
let WATCHED_META = {};              // map channel_id -> {enabled, name} (εισαγμένα subscriptions)
let RSS_DATA = {};                  // channel_id -> [νέα βίντεο που σου ξέφυγαν] (cache από /check_new)
let rssShown = 6;                   // ΠΟΣΑ νέα βίντεα δείχνει το feed (ΚΟΙΝΟ για όλα τα κανάλια, επιμένει στη βάση)

// --- Εικονίδια καμπάνας (emoji) ---
function bellIcon() { return refreshIcon(); }      // refresh icon (πριν/μετά το fetch)
function bellOffIcon() { return refreshIcon(); }    // ίδιο εικονίδιο — στατικό όταν δεν πατάς

// 🔄 Refresh icon (δύο στρογγυλά βελάκια) — SVG, κάνει spin κατά το fetch.
function refreshIcon() {
  return `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>`;
}
function watchBellHtml(on) { return on ? bellIcon() : bellOffIcon(); }

function videoTags(v) {
  const set = new Set(v.my_tags || []);
  const key = v.channel_id || v.channel || "__unknown__";
  for (const t of (CHANNEL_TAGS[key] || [])) set.add(t);
  return [...set];
}

// Ποιo κριτήριο ταίριαξε σε αυτό το βίντεο (για το match-highlight).
// Επιστρέφει { tagChannel, tagVideo, rating, titleMatch }.
function matchInfo(v) {
  const q = (document.getElementById("search-input").value || "").trim().toLowerCase();
  const info = { tagChannel: false, tagVideo: false, rating: false, titleMatch: null };
  // tags
  for (const t of selectedTags) {
    const key = v.channel_id || v.channel || "__unknown__";
    if ((CHANNEL_TAGS[key] || []).includes(t)) info.tagChannel = true;
    if ((v.my_tags || []).includes(t)) info.tagVideo = true;
  }
  // rating
  if (searchRating && (v.rating || 0) === searchRating) info.rating = true;
  // τίτλος (λέξη του search)
  if (q) {
    const title = (v.title || "");
    const idx = title.toLowerCase().indexOf(q);
    if (idx >= 0) info.titleMatch = { idx, len: q.length };
  }
  return info;
}

// Τονίζει τη λέξη αναζήτησης στον τίτλο (bold κόκκινο).
function highlightTitle(title, info) {
  if (!info.titleMatch) return esc(title);
  const { idx, len } = info.titleMatch;
  const before = esc(title.slice(0, idx));
  const hit = esc(title.slice(idx, idx + len));
  const after = esc(title.slice(idx + len));
  return `${before}<mark class="hl">${hit}</mark>${after}`;
}

function renderTagFilter() {
  const panel = document.getElementById("tag-filter-panel");
  const totalEl = document.getElementById("tag-total");
  const activeEl = document.getElementById("tag-active");
  if (!panel) return;

  // Ενημέρωση κουμπιού: σύνολο + ενεργά.
  const total = ALL_TAGS.length;
  const active = selectedTags.size;
  if (totalEl) totalEl.textContent = `(${total})`;
  if (activeEl) activeEl.textContent = active > 0 ? `· ${active} ενεργά` : "";

  if (!ALL_TAGS.length) {
    panel.innerHTML = '<span class="lbl" style="font-size:12px">🏷️ Πάτα το 🏷️ σε ένα βίντεο ή κανάλι για να φτιάξεις tags.</span>';
    return;
  }
  const inSearch = isSearchMode();
  const tags = [...ALL_TAGS].sort();
  panel.innerHTML = tags.map(t => {
    const on = selectedTags.has(t);
    const delBtn = inSearch
      ? ''
      : `<span class="tag-filter-x" title="Διαγραφή του tag «${esc(t)}» από παντού" onclick="confirmDeleteTag('${esc(t)}', this); event.stopPropagation();">×</span>`;
    return `<label class="tag-chk green ${on ? 'on' : ''}">
      <input type="checkbox" ${on ? 'checked' : ''} onchange="toggleFilterTag('${esc(t)}', this.checked)">${esc(t)}
      ${delBtn}
    </label>`;
  }).join('');
}

function toggleTagPanel() {
  const panel = document.getElementById("tag-filter-panel");
  if (!panel) return;
  const show = panel.style.display === "none";
  panel.style.display = show ? "block" : "none";
  const chev = document.getElementById("tag-chevron");
  if (chev) chev.textContent = show ? "▴" : "▾";
}

// Είμαστε σε search mode αν υπάρχει κείμενο, rating Ή επιλεγμένο tag.
function isSearchMode() {
  const q = document.getElementById("search-input").value.trim();
  return !!(q || searchRating > 0 || selectedTags.size > 0);
}

function toggleFilterTag(tag, on) {
  if (on) selectedTags.add(tag); else selectedTags.delete(tag);
  renderTagFilter();
  renderCurrent();
}

function hideFilterBanner() {
  const b = document.getElementById("filter-banner");
  if (b) b.remove();
  const fc = document.getElementById("filter-count");
  if (fc) fc.textContent = "";
}

// Εμφανίζει/κρύβει το «✕ Clear All» ανάλογα με το αν υπάρχει ενεργό φίλτρο.
function updateSearchClearBtn() {
  const q = document.getElementById("search-input").value.trim();
  const el = document.getElementById("input-clear");
  if (el) el.style.display = q ? "inline-flex" : "none";
}

// Αδειάζει ΜΟΝΟ τη λέξη του search field (κρατά αστεράκια + tags).
function clearSearchText() {
  const inp = document.getElementById("search-input");
  if (inp) inp.value = "";
  renderCurrent();
}

/* --- Tag popover --- */
function openTagPop(btn, type, id) {
  const pop = document.getElementById("tag-pop");
  // Toggle: αν είναι ήδη ανοιχτό για το ίδιο target → κλείσε με pop-out.
  if (pop.classList.contains("open") && tagPopTarget && tagPopTarget.type === type && tagPopTarget.id === id) {
    closeTagPop();
    return;
  }
  tagPopTarget = { type, id };
  tagPopBtn = btn;
  const currentTags = type === 'video'
    ? (allVideos.find(x => x.video_id === id)?.my_tags || [])
    : (CHANNEL_TAGS[id] || []);
  renderTagPopList(currentTags);
  // σβήσε τυχόν closing class + inline display πριν το νέο άνοιγμα
  pop.classList.remove("closing");
  pop.style.display = "";
  pop.classList.add("open");
  repositionTagPop();
}

function repositionTagPop() {
  const pop = document.getElementById("tag-pop");
  if (!pop.classList.contains("open") || !tagPopBtn) return;
  const r = tagPopBtn.getBoundingClientRect();
  // αν το button βγει από το viewport (πάνω ή κάτω), κλείσε το popover
  if (r.bottom < 0 || r.top > window.innerHeight) {
    pop.classList.remove("open");
    tagPopTarget = null;
    tagPopBtn = null;
    return;
  }
  pop.style.left = Math.max(8, Math.min(r.left, window.innerWidth - 236)) + "px";
  pop.style.top = Math.min(r.bottom + 6, window.innerHeight - pop.offsetHeight - 8) + "px";
}

function renderTagPopList(currentTags) {
  const list = document.getElementById("tag-pop-list");
  if (!ALL_TAGS.length) {
    list.innerHTML = '<span class="muted" style="font-size:12px">Γράψε το πρώτο σου tag 👇</span>';
    return;
  }
  list.innerHTML = ALL_TAGS.map(t => `
    <div class="tag-pop-item">
      <label class="tag-pop-label">
        <input type="checkbox" value="${esc(t)}" ${currentTags.includes(t) ? 'checked' : ''} onchange="toggleTag()">${esc(t)}
      </label>
      <button class="tag-del" title="Διαγραφή του tag «${esc(t)}» από παντού" onclick="confirmDeleteTag('${esc(t)}', this)">×</button>
    </div>
  `).join("");
}

function confirmDeleteTag(tag, btn) {
  // κλείσε τυχόν προηγούμενο confirm
  closeDeleteConfirm();
  const rect = btn.getBoundingClientRect();
  const pop = document.createElement("div");
  pop.className = "del-confirm";
  pop.id = "del-confirm";
  pop.innerHTML = `
    <div class="dc-msg">Θα σβηστεί το tag <b>${esc(tag)}</b> από <b>ΟΛΑ</b> τα βίντεο και κανάλια.<br><span class="dc-warn">Δεν ξαναγυρίζει.</span></div>
    <div class="dc-btns">
      <button class="dc-yes" onclick="doDeleteTag('${esc(tag)}')">✓ Ναι, σβήστο</button>
      <button class="dc-no" onclick="closeDeleteConfirm()">✕ Άκυρο</button>
    </div>`;
  document.body.appendChild(pop);
  // τοποθέτησε δίπλα στο κουμπί (αν χωράει κάτω, αλλιώς πάνω)
  const popW = 280, popH = 96;
  let left = rect.left;
  let top = rect.bottom + 6;
  if (top + popH > window.innerHeight) top = rect.top - popH - 6;
  if (left + popW > window.innerWidth) left = window.innerWidth - popW - 8;
  pop.style.left = Math.max(8, left) + "px";
  pop.style.top = Math.max(8, top) + "px";
}

function closeDeleteConfirm() {
  const p = document.getElementById("del-confirm");
  if (p) p.remove();
}

function doDeleteTag(tag) {
  closeDeleteConfirm();
  fetch("/delete_tag", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ tag }),
  }).then(() => {
    // ενημέρωση τοπικά
    ALL_TAGS = ALL_TAGS.filter(t => t !== tag);
    selectedTags.delete(tag);
    for (const v of allVideos) {
      if (v.my_tags) v.my_tags = v.my_tags.filter(t => t !== tag);
    }
    for (const k in CHANNEL_TAGS) {
      CHANNEL_TAGS[k] = (CHANNEL_TAGS[k] || []).filter(t => t !== tag);
    }
    // ξανασχεδίασε τα πάντα
    renderTagFilter();
    renderCurrent();
    // κλείσε το popover (το target μπορεί να έχει χάσει το tag)
    closeTagPop();
  });
}

function toggleTag() {
  if (!tagPopTarget) return;
  const checked = [...document.querySelectorAll("#tag-pop-list input:checked")].map(i => i.value);
  const url = tagPopTarget.type === 'video' ? '/set_video_tags' : '/set_channel_tags';
  const body = tagPopTarget.type === 'video'
    ? { video_id: tagPopTarget.id, tags: checked }
    : { channel_id: tagPopTarget.id, tags: checked };
  fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
  if (tagPopTarget.type === 'video') {
    const v = allVideos.find(x => x.video_id === tagPopTarget.id);
    if (v) v.my_tags = checked;
  } else {
    CHANNEL_TAGS[tagPopTarget.id] = checked;
  }
  // ξανατρέξε το ενεργό φίλτρο (αν υπάρχει) με τα νέα tags
  renderCurrent();
}

function addNewTag() {
  const input = document.getElementById("tag-pop-new-input");
  const name = input.value.trim();
  if (!name) return;
  if (!ALL_TAGS.includes(name)) ALL_TAGS.push(name);
  input.value = "";

  if (tagPopTarget) {
    const current = tagPopTarget.type === 'video'
      ? (allVideos.find(x => x.video_id === tagPopTarget.id)?.my_tags || [])
      : (CHANNEL_TAGS[tagPopTarget.id] || []);
    if (!current.includes(name)) current.push(name);
    renderTagPopList(current);
    toggleTag();
  }
  renderTagFilter();
}

function closeTagPop() {
  const pop = document.getElementById("tag-pop");
  // Pop-out animation πριν το πραγματικό κλείσιμο.
  if (pop.classList.contains("open") && !pop.classList.contains("closing")) {
    pop.classList.remove("open");
    pop.classList.add("closing");
    setTimeout(() => {
      pop.classList.remove("closing");
      pop.style.display = "none";
      tagPopTarget = null;
      tagPopBtn = null;
      load();
    }, 150);
    return;
  }
  pop.classList.remove("open");
  tagPopTarget = null;
  tagPopBtn = null;
  load();
}

document.addEventListener("click", (e) => {
  const pop = document.getElementById("tag-pop");
  if (pop.classList.contains("open") && !pop.contains(e.target) && !e.target.closest(".tag-btn")) {
    closeTagPop();
  }
  const cpop = document.getElementById("cat-pop");
  if (cpop.classList.contains("open") && !cpop.contains(e.target) && !e.target.closest(".cat-btn")) {
    closeCatPop();
  }
});

// Το popover ακολουθεί το button καθώς σκρολάρεις· κλείνει μόνο όταν βγει από το viewport.
window.addEventListener("scroll", repositionTagPop, true);
window.addEventListener("scroll", repositionCatPop, true);

/* --- Rating --- */
function rateVideo(videoId, rating) {
  fetch("/set_video_rating", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId, rating }),
  }).then(() => {
    const v = allVideos.find(x => x.video_id === videoId);
    if (v) v.rating = rating;
    // ξανασχεδίασε το ΣΩΣΤΟ tab (κανάλια ή κατηγορίες)
    if (currentTab === "categories") renderCategories();
    else renderCurrent();
  });
}

/* --- Seen (άνοιξε το βίντεο → ιστορικό + ξεμόβισμα του NEW) --- */
function markSeen(videoId) {
  // Καταγράφει ιστορικό + ξεμοβίζει το «NEW» badge — ΣΙΩΠΗΛΑ, χωρίς full re-render.
  // (Απλά σβήνει το unseen στο allVideos + αφαιρεί το badge από την καρτέλα στο DOM.)
  fetch("/mark_seen", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId }),
  }).catch(() => {});
  fetch("/mark_unseen_off", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId }),
  }).then(() => {
    const v = allVideos.find(x => x.video_id === videoId);
    if (v) v.unseen = 0;
    // 🎯 αφαίρεσε το NEW badge + το unseen class από την καρτέλα (χωρίς reload)
    const card = document.querySelector(`.v-card[data-id="${CSS.escape(videoId)}"]`);
    if (card) {
      card.classList.remove("unseen");
      const badge = card.querySelector(".new-badge");
      if (badge) badge.remove();
    }
  }).catch(() => {});
}

/* --- ✓ το είδα — ξεμοβίζει ΧΕΙΡΟΚΙΝΗΤΑ το «ΝΕΟ» βίντεο --- */
/* --- Backup: Εξαγωγή / Εισαγωγή --- */
function backupStatus(msg, isError) {
  const el = document.getElementById("backup-status");
  if (!el) return;
  el.textContent = msg;
  el.style.color = isError ? "var(--danger)" : "var(--muted)";
}

function doExport() {
  backupStatus("….φτιάχνω το export…");
  fetch("/export", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" })
    .then(r => r.json())
    .then(d => {
      if (d.cancelled) { backupStatus(""); return; }
      if (!d.ok) { backupStatus("⚠️ Σφάλμα: " + (d.error || "άγνωστο"), true); return; }
      backupStatus("✅ Αποθηκεύτηκε: " + d.path);
    })
    .catch(e => backupStatus("⚠️ Δεν απαντά ο server", true));
}

// 🔄 Έλεγχος για ενημέρωση — ρωτάει το backend (/update_check), που τσεκάρει το GitHub.
function checkUpdate() {
  const btn = document.getElementById("update-btn");
  if (btn) { btn.disabled = true; btn.textContent = "…έλεγχος…"; }
  fetch("/update_check", { method: "GET" })
    .then(r => r.json())
    .then(d => {
      if (btn) { btn.disabled = false; btn.textContent = "🔄 Ενημέρωση"; }
      if (!d.ok) {
        showUpdatePopup(false, d.current, null, d.error || "Δεν κατάφερα να ελέγξω.");
        return;
      }
      showUpdatePopup(true, d.current, d);
    })
    .catch(e => {
      if (btn) { btn.disabled = false; btn.textContent = "🔄 Ενημέρωση"; }
      showUpdatePopup(false, null, null, "Δεν απαντά ο server.");
    });
}

function showUpdatePopup(ok, current, data, errMsg) {
  closeUpdatePopup();
  const pop = document.createElement("div");
  pop.className = "del-confirm center";
  pop.id = "update-pop";
  let inner = "";
  if (ok && data && data.newer) {
    // 🧠 Η εφαρμογή ΑΠΟΦΑΣΙΖΕΙ μόνη της — όχι ο χρήστης.
    //    update_kind == "frontend" → αυτόματο UI update (χωρίς reinstall).
    //    update_kind == "full"     → «out of date» + link για κατέβασμα νέου setup.
    const kind = (data.update_kind || "full").toLowerCase();
    const dlUrl = data.download_url || data.url || "";
    if (kind === "frontend" && data.frontend_url) {
      inner = `
      <div class="dc-msg">🆕 <b>Νέα έκδοση διαθέσιμη!</b><br>
      <span class="muted">Τρέχουσα: v${esc(current)} · Τελευταία: v${esc(data.latest)}</span><br>
      ${data.notes ? `<span class="dc-warn">${esc(data.notes)}</span>` : ""}</div>
      <div class="dc-btns">
        <button class="dc-yes" onclick="doFrontendUpdate('${esc(data.frontend_url)}')">✨ Ενημέρωση τώρα</button>
        <button class="dc-no" onclick="closeUpdatePopup()">Αργότερα</button>
      </div>`;
    } else {
      inner = `
      <div class="dc-msg">⚠️ <b>Η εφαρμογή είναι παλιά (out of date)</b><br>
      <span class="muted">Έχεις v${esc(current)} · η τελευταία είναι v${esc(data.latest)}.</span><br>
      <span class="muted">Πρέπει να κατεβάσεις και να εγκαταστήσεις τη νέα έκδοση.</span><br>
      ${data.notes ? `<span class="dc-warn">${esc(data.notes)}</span>` : ""}</div>
      <div class="dc-btns" style="flex-wrap:wrap;">
        <button class="dc-yes" onclick="window.open('${esc(dlUrl)}', '_blank')">⬇ Κατέβασε τη νέα έκδοση</button>
        <button class="dc-no" onclick="closeUpdatePopup()">Αργότερα</button>
      </div>`;
    }
  } else if (ok) {
    inner = `
      <div class="dc-msg">✅ <b>Έχεις την τελευταία έκδοση</b><br>
      <span class="muted">v${esc(current)}</span></div>
      <div class="dc-btns">
        <button class="dc-no" onclick="closeUpdatePopup()">Οκ</button>
      </div>`;
  } else {
    inner = `
      <div class="dc-msg">⚠️ <b>Έλεγχος απέτυχε</b><br>
      <span class="muted">${esc(errMsg || "άγνωστο σφάλμα")}</span><br>
      ${current ? `<span class="muted">Τρέχουσα: v${esc(current)}</span>` : ""}</div>
      <div class="dc-btns">
        <button class="dc-no" onclick="closeUpdatePopup()">Οκ</button>
      </div>`;
  }
  pop.innerHTML = inner;
  document.body.appendChild(pop);
}

function closeUpdatePopup() {
  const p = document.getElementById("update-pop");
  if (p) p.remove();
}

function doFrontendUpdate(url) {
  // 🚀 Αυτόματο frontend update: καλεί το backend να κατεβάσει το νέο index.html
  //    στο μόνιμο override φάκελο. ΔΕΝ χρειάζεται reinstall — μόνο restart.
  const pop = document.getElementById("update-pop");
  if (pop) pop.innerHTML = `
    <div class="dc-msg">⏳ <b>Ενημέρωση UI…</b><br>
    <span class="muted">Κατεβάζω το νέο interface (δεν χρειάζεται reinstall).</span></div>`;
  fetch("/frontend_update", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ frontend_url: url }),
  })
    .then(r => r.json())
    .then(d => {
      if (d.ok) {
        if (pop) pop.innerHTML = `
          <div class="dc-msg">✅ <b>Ενημέρωση ολοκληρώθηκε!</b><br>
          <span class="muted">Κλείσε την εφαρμογή και ξανάνοιξέ την για να δεις το νέο interface.</span></div>
          <div class="dc-btns">
            <button class="dc-no" onclick="closeUpdatePopup()">Οκ</button>
          </div>`;
      } else {
        if (pop) pop.innerHTML = `
          <div class="dc-msg">⚠️ <b>Η ενημέρωση απέτυχε</b><br>
          <span class="muted">${esc(d.error || "άγνωστο σφάλμα")}</span></div>
          <div class="dc-btns">
            <button class="dc-no" onclick="closeUpdatePopup()">Οκ</button>
          </div>`;
      }
    })
    .catch(() => {
      if (pop) pop.innerHTML = `
        <div class="dc-msg">⚠️ <b>Δεν απαντά ο server</b></div>
        <div class="dc-btns"><button class="dc-no" onclick="closeUpdatePopup()">Οκ</button></div>`;
    });
}

function doImport() {
  showImportModePopup(mode => {
    if (!mode) { backupStatus(""); return; }
    backupStatus(mode === "replace" ? "….εισαγωγή (αντικατάσταση)…" : "….εισαγωγή (συγχώνευση)…");
    fetch("/import", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ mode }),
    })
      .then(r => r.json())
      .then(d => {
        if (d.cancelled) { backupStatus(""); return; }
        if (!d.ok) { backupStatus("⚠️ Σφάλμα: " + (d.error || "άγνωστο"), true); return; }
        backupStatus("✅ Εισαγωγή ολοκληρώθηκε (" + (mode === "replace" ? "αντικατάσταση" : "συγχώνευση") + ")");
        load();  // ξαναφόρτωσε με τα νέα δεδομένα
      })
      .catch(e => backupStatus("⚠️ Δεν απαντά ο server", true));
  });
}

function doImportSubscriptions() {
  // 📡 Εισαγωγή καναλιών από το subscriptions.csv (Google Takeout) → γίνονται «παρακολουθούμενα».
  backupStatus("….εισαγωγή καναλιών…");
  fetch("/import_subscriptions", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: "{}",
  })
    .then(r => r.json())
    .then(d => {
      if (d.cancelled) { backupStatus(""); return; }
      if (!d.ok) { backupStatus("⚠️ " + (d.error || "Σφάλμα"), true); return; }
      backupStatus("✅ Εισήχθησαν " + d.count + " κανάλια ως «παρακολουθούμενα»");
      load();
    })
    .catch(() => backupStatus("⚠️ Δεν απαντά ο server", true));
}

function showImportModePopup(onChoice) {
  // Αφαιρεί τυχόν παλιό popup
  document.querySelectorAll(".import-pop").forEach(p => p.remove());

  const overlay = document.createElement("div");
  overlay.className = "import-pop";
  overlay.innerHTML = `
    <div class="import-pop-card">
      <div class="import-pop-title">Πώς θες να γίνει η εισαγωγή;</div>
      <p class="import-pop-sub">Διάλεξε αν θα αντικατασταθούν τα τρέχοντα δεδομένα ή θα συγχωνευτούν (χωρίς διπλότυπα).</p>
      <div class="import-pop-actions">
        <button class="backup-btn imp-replace">🔄 Αντικατάσταση</button>
        <button class="backup-btn imp-merge">🔗 Συγχώνευση</button>
        <button class="backup-btn imp-cancel">Ακύρωση</button>
      </div>
    </div>`;
  overlay.querySelector(".imp-replace").onclick = () => { document.querySelectorAll(".import-pop").forEach(p => p.remove()); onChoice("replace"); };
  overlay.querySelector(".imp-merge").onclick = () => { document.querySelectorAll(".import-pop").forEach(p => p.remove()); onChoice("merge"); };
  overlay.querySelector(".imp-cancel").onclick = () => { document.querySelectorAll(".import-pop").forEach(p => p.remove()); onChoice(null); };
  document.body.appendChild(overlay);
}

/* --- RSS Watchdog (🔔 νέα βίντεο ΜΕΣΑ σε κάθε κανάλι) --- */
function toggleWatch(channelId, btn) {
  // 🔄 Το refresh icon = κουμπί FETCH (όχι toggle). Κάθε πάτημα φέρνει νέα βίντεο για αυτό το κανάλι.
  // Το κανάλι ενεργοποιείται (enabled=1) μόνιμα μόλις πατήσεις πρώτη φορά.
  const isOn = (WATCHED_CHANNELS[channelId] === 1) ? 1 : 0;
  const target = 1;   // πάντα on (το fetch δεν κλείνει πια — μόνο φέρνει)
  WATCHED_CHANNELS[channelId] = target;
  if (target === 1) NEW_CHANNELS.add(channelId);
  const group = btn ? btn.closest(".channel-group") : document.querySelector(`.channel-group[data-key="${CSS.escape(channelId)}"]`);
  const setSpin = (spinning) => {
    if (btn) {
      if (spinning) {
        btn.classList.add("loading");
        btn.innerHTML = refreshIcon();
      } else {
        btn.classList.remove("loading", "on");
        // 🔄 Μετά το fetch, το refresh icon επιστρέφει σε στατική κατάσταση —
        // ώστε να ξέρεις ότι μπορείς να το ξαναπατήσεις για άλλα νέα.
        btn.innerHTML = refreshIcon();
      }
    }
  };
  // Γράψε enabled=1 (πρώτη φορά) — μετά, κάθε πάτημα απλά κάνει fetch.
  const write = fetch("/watch_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: channelId, enabled: true }),
  });
  // Άνοιξε το κανάλι (αν είναι κλειστό) ώστε να φαίνεται το grid με τα νέα.
  if (group && group.classList.contains("collapsed")) {
    group.classList.remove("collapsed");
    expandedChannels.add(channelId);
    saveUiState();
    updateToggleAllBtn();
  }
  // ⏱️ ΕΛΑΧΙΣΤΟΣ ΧΡΟΝΟΣ SPIN (π.χ. 600ms): όταν η απάντηση έρχεται ακαριαία (από την cache),
  //    χωρίς αυτό η ένδειξη «αναβοσβήνει» και δεν προλαβαίνει να τη δει ο χρήστης.
  const _spinStart = Date.now();
  const setSpinMin = (spinning) => {
    if (spinning) { setSpin(true); return; }
    const elapsed = Date.now() - _spinStart;
    const wait = Math.max(0, 600 - elapsed);
    setTimeout(() => setSpin(false), wait);
  };
  // 🔄 ΕΝΙΑΙΑ διαδρομή: η ίδια συνάρτηση με το «Επόμενα» — κάνει promote κίτρινου,
  //    κατέβασμα με cache, offset, has_more. (Το παλιό fetchChannelNew δεν τα είχε.)
  write.then(() => fetchChannelNext(channelId, null, setSpinMin))
       .catch(() => setSpinMin(false));
}

function fetchChannelNext(cid, btn, setSpinFn) {
  // ⬇️ «Επόμενα» στο τέλος του καναλιού. ΔΥΟ καταστάσεις μόνο:
  //    «Επόμενα →»  = έχει κι άλλα     |     «Τέλος» = δεν έχει άλλα.
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  if (!group) return;
  if (btn) {
    if (btn.dataset.busy === "1") return;
    btn.dataset.busy = "1";
    btn.disabled = true;
    btn.textContent = "…";
  }
  if (typeof setSpinFn === "function") setSpinFn(true);

  const key = "chnext_" + cid;
  if (typeof window[key] !== "number") window[key] = 0;
  let grid = group.querySelector(".v-card-grid");

  fetch("/fetch_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: cid, limit: 24, offset: window[key] }),
  }).then(r => r.json()).then(async d => {
    const videos = (d && d.videos) || [];
    const wasImported = group.classList.contains("imported");

    if (videos.length) {
      // 🟡→⚪ κίτρινο → πλήρες κανάλι, πριν από τα υπόλοιπα κίτρινα.
      if (wasImported) { promoteChannelToFull(cid); grid = group.querySelector(".v-card-grid"); }
      try {
        await fetch("/add_many", { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: videos.map(v => ({ video_id: v.video_id, title: v.title || v.video_id,
            channel: v.channel || "", channel_id: cid, mark_unseen: true })) }) });
      } catch (e) {}
      if (grid) for (const v of videos) {
        const vv = { video_id: v.video_id, title: v.title || v.video_id, channel: v.channel || "",
                     channel_id: cid, rating: 0, unseen: true, watch_count: 1, category: "" };
        if (!allVideos.some(x => x.video_id === v.video_id)) allVideos.push(vv);
        const w = document.createElement("div");
        w.innerHTML = cardHtml(vv, "channel");
        grid.appendChild(w.firstElementChild);
      }
      window[key] = (typeof d.next_offset === "number") ? d.next_offset : (window[key] + videos.length);
      const muted = group.querySelector(".muted");
      if (muted) muted.textContent = "· " + group.querySelectorAll(".v-card").length + " βίντεο";
      try { setupDrag(); } catch (e) {}
      if (wasImported) { try { placeBeforeFirstImported(cid); } catch (e) {} }
    }
    if (btn) {
      // 🔚 Δύο μόνο μηνύματα: «Επόμενα →» ή «Τέλος». Χωρίς τίποτα άλλο.
      if (videos.length && d && d.has_more === true) { btn.textContent = "Επόμενα →"; btn.disabled = false; }
      else { btn.textContent = "Τέλος"; btn.disabled = true; }
      delete btn.dataset.busy;
    }
    if (typeof setSpinFn === "function") setSpinFn(false);
  }).catch(() => {
    // Απλό: αν δεν φόρτωσε, ξαναπροσπάθησε. Καμία άλλη πληροφορία.
    if (btn) { btn.textContent = "Επόμενα →"; btn.disabled = false; delete btn.dataset.busy; }
    if (typeof setSpinFn === "function") setSpinFn(false);
  });
}

function deleteBtnBusy(btn) { if (btn) delete btn.dataset.busy; }

function fetchChannelNew(cid, setSpin) {
  // 📡 Fetch για ΕΝΑ κανάλι: φέρνει τα νέα (μέχρι 24) και τα ΠΡΟΣΘΕΤΕΙ στο grid ως καρτέλες.
  // Αν είναι imported (κίτρινο, χωρίς grid/βίντεο) → φτιάχνουμε το grid + το κάνουμε «άσπρο» (κανονικό).
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  if (!group) { if (setSpin) setSpin(false); return; }
  let grid = group.querySelector(".v-card-grid");
  if (!grid) {
    // 🟡 imported κανάλι → φτιάξε το grid μέσα στο channel-body + βγάλε το imported (κίτρινο) class.
    grid = document.createElement("div");
    grid.className = "v-card-grid";
    const body = group.querySelector(".channel-body");
    if (!body) { if (setSpin) setSpin(false); return; }
    body.appendChild(grid);
    group.classList.remove("imported");
    group.classList.add("new");
  }
  fetch("/fetch_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: cid, limit: 24 }),
  }).then(r => r.json()).then(async d => {
    // ελάχιστος χρόνος εμφάνισης (να μην «αναβοσβήνει» το κουμπί)
    await new Promise(res => setTimeout(res, 400));
    const videos = d.videos || [];
    if (videos.length) {
      // 🚀 Μαζική προσθήκη (ένα request) — δεν κάνουμε 24 χωριστά /add (αργό).
      const items = videos.map(v => ({
        video_id: v.video_id,
        title: v.title || v.video_id,
        channel: v.channel || "",
        channel_id: cid,
        mark_unseen: true,
      }));
      try {
        await fetch("/add_many", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items }),
        });
      } catch (e) { /* ignore */ }
    }
    // ➕ append όλες τις καρτέλες στο grid (χωρίς reload)
    for (const v of videos) {
      const vv = { video_id: v.video_id, title: v.title || v.video_id, channel: v.channel || "", channel_id: cid, rating: 0, unseen: true, watch_count: 1, category: "" };
      if (!allVideos.some(x => x.video_id === v.video_id)) allVideos.push(vv);
      const wrapper = document.createElement("div");
      wrapper.innerHTML = cardHtml(vv, "channel");
      grid.appendChild(wrapper.firstElementChild);
    }
    // 🔢 Ενημέρωσε το μετρητή βίντεο στο banner (ζωντανά, χωρίς reload)
    const group = grid.closest(".channel-group");
    const muted = group ? group.querySelector(".muted") : null;
    if (muted) {
      const count = grid.querySelectorAll(".v-card").length;
      muted.textContent = "· " + count + " βίντεο";
    }
    setupDrag();
    if (setSpin) setSpin(false);
  }).catch(() => {
    if (setSpin) setSpin(false);
  });
}

function renderRssPanel(cid) {
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  if (!group) return;
  let panel = group.querySelector(".rss-panel");
  if (!panel) {
    panel = document.createElement("div");
    panel.className = "rss-panel";
    // Μέσα στο .rss-slot, ΠΡΙΝ τα βίντεα → News Feed πάνω-πάνω.
    // Το slot είναι μέσα στο .channel-body, άρα κλείνει ΜΑΖΙ με τα βίντεα (συζευγμένο με το ▾).
    const slot = group.querySelector(".rss-slot");
    slot.appendChild(panel);
  }
  if (!rssShown || rssShown < 1) rssShown = 6;
  const all = RSS_DATA[cid] || [];
  if (!all.length) {
    panel.innerHTML = '<div class="rss-empty">✅ Είσαι ενημερωμένος — δεν υπάρχουν νέα βίντεο.</div>';
    return;
  }
  // Το −/+ ορίζει ΠΟΣΑ χωράνε «με την πρώτη ματιά» (ύψος), ΟΧΙ πόσα κόβονται.
  // Όλα τα νέα φαίνονται πάντα — τα υπόλοιπα μέσα από scroll.
  const rowH = 63;                       // ~ύψος .new-row (47px thumb + padding)
  const viewH = Math.max(1, Math.min(rssShown, all.length)) * rowH;
  const remaining = all.length - rssShown;
  panel.innerHTML = `
    <div class="rss-head">
      <span class="rss-title">🆕 Νέα βίντεο (${all.length})</span>
      <span class="rss-count">
        ${remaining > 0 ? `<span class="rss-total">(+${remaining})</span>` : ""}
        <button class="rss-countbtn" onclick="setRssCount('${esc(cid)}', -1)" title="Λιγότερα">−</button>
        <span class="rss-num">${rssShown}</span>
        <button class="rss-countbtn" onclick="setRssCount('${esc(cid)}', 1)" title="Περισσότερα">+</button>
      </span>
    </div>
    <div class="rss-list" style="max-height:${viewH}px">
      ${all.map(n => `
      <div class="new-row" data-vid="${esc(n.video_id)}">
        <img class="thumb" src="/thumb/${esc(n.video_id)}" loading="lazy" onerror="this.style.display='none'" alt="">
        <div class="vinfo">
          <a class="vtitle" href="#" onclick="event.preventDefault(); openLightbox('${esc(n.video_id)}', 'feed'); return false;" title="Παίξε το μέσα στην εφαρμογή">${esc(n.title)}</a>
          <div class="vmeta"><span class="muted">${n.published ? shortDate(n.published) : ""}</span></div>
        </div>
        <button class="icon-btn" title="Πρόσθεσε στο ιστορικό μου" onclick="addFromRSS('${esc(cid)}', '${esc(n.video_id)}')">➕</button>
        <button class="icon-btn del" title="Δεν με ενδιαφέρει (δεν θα ξαναεμφανιστεί)" onclick="dismissFromRSS('${esc(cid)}', '${esc(n.video_id)}')">×</button>
      </div>`).join("")}
    </div>
  `;
}

function setRssCount(cid, dir) {
  const total = (RSS_DATA[cid] || []).length;
  rssShown = Math.max(1, Math.min(total, rssShown + dir));
  saveUiState();
  renderRssPanel(cid);
  // ενημέρωσε ΚΑΙ τα υπόλοιπα ανοιχτά panels (κοινή τιμή για όλα)
  Object.keys(RSS_DATA).forEach(k => { if (k !== cid) renderRssPanel(k); });
}

function addFromRSS(cid, videoId) {
  const url = "https://www.youtube.com/watch?v=" + videoId;
  const meta = WATCHED_META[cid] || {};
  fetch("/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url, approve: true, channel_id: cid, channel: meta.name || null }),
  }).then(r => r.json()).then(d => {
    // 📌 κράτα το title ΠΡΙΝ το φιλτράρισμα (για να το βάλουμε στο κανάλι)
    const feedItem = (RSS_DATA[cid] || []).find(n => n.video_id === videoId)
      || { title: d.title || videoId };
    // αφαίρεσέ το από τα «νέα» αυτού του καναλιού — ΜΟΝΟ το panel, χωρίς να κλείσει/διπλώσει τίποτα.
    RSS_DATA[cid] = (RSS_DATA[cid] || []).filter(n => n.video_id !== videoId);
    renderRssPanel(cid);
    // ➕ πρόσθεσε ΚΑΙ ορατά το βίντεο μέσα στο κανάλι (σιωπηλά, χωρίς reload).
    const meta = WATCHED_META[cid] || {};
    appendVideoToChannel(cid, {
      video_id: videoId,
      title: feedItem.title || d.title || videoId,
      channel: meta.name || d.title || cid,
      channel_id: cid,
      rating: 0,
      unseen: false,
    });
  });
}

// Βοηθητική: προσθέτει ορατά ένα βίντεο μέσα στο κανάλι (σιωπηλά, χωρίς reload).
// Βρίσκει το group μόνο με data-key (ΟΧΙ .imported — γιατί μπορεί να έγινε ήδη μπλε).
function appendVideoToChannel(cid, v) {
  // 🔑 ΠΑΝΤΑ πρόσθεσε στο allVideos πρώτα — ώστε να φαίνεται σε όλα τα tabs
  //    (κατηγορίες/αναζήτηση), ακόμα κι αν το κανάλι δεν είναι στο τρέχον DOM.
  if (!allVideos.some(x => x.video_id === v.video_id)) allVideos.push(v);
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  _catDirty = true;
  if (!group) { _chanDirty = true; return; }   // το κανάλι δεν είναι στο DOM → ζωγραφίζεται στο επόμενο άνοιγμα
  group.classList.remove("imported");  // 🎯 πορτοκαλί → μπλε επιτόπου
  const grid = group.querySelector(".v-card-grid");
  if (!grid) return;
  if (!grid.querySelector(`.v-card[data-id="${CSS.escape(v.video_id)}"]`)) {
    const wrap = document.createElement("div");
    wrap.innerHTML = cardHtml(v, "channel");
    grid.appendChild(wrap.firstElementChild);
    const muted = group.querySelector(".muted");
    const count = grid.querySelectorAll(".v-card").length;
    if (muted) muted.textContent = "· " + count + " βίντεο";
  }
}

// 🟡→⚪ «Ωρίμασε» ένα κίτρινο (imported) κανάλι σε ΠΛΗΡΕΣ κανάλι, μετά το πρώτο fetch.
// Φτιάχνει grid + μετρητή + κουμπί «Επόμενα», βγάζει το κίτρινο, και το ΜΕΤΑΚΙΝΕΙ
// αμέσως ΠΑΝΩ από τα υπόλοιπα κίτρινα (στη δική του ζώνη) — από εκεί και πέρα
// συμπεριφέρεται σαν κάθε άλλο άσπρο κανάλι.
function promoteChannelToFull(cid) {
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  if (!group) return null;
  const head = group.querySelector(".channel-head");
  const body = group.querySelector(".channel-body");
  if (!body) return null;

  // 1) Μετρητής βίντεο (το κίτρινο δεν τον έχει)
  if (head && !head.querySelector(".muted")) {
    const sp = head.querySelector(".head-spacer");
    const muted = document.createElement("span");
    muted.className = "muted";
    muted.textContent = "· 0 βίντεο";
    if (sp && sp.nextSibling) head.insertBefore(muted, sp.nextSibling);
    else if (sp) sp.after(muted);
    else head.appendChild(muted);
  }

  // 2) Grid βίντεο + κουμπί «Επόμενα» (αν λείπουν)
  let grid = body.querySelector(".v-card-grid");
  if (!grid) {
    // Το rss-slot μένει ΠΡΩΤΟ (το News Feed πάει πάνω-πάνω), μετά το grid.
    grid = document.createElement("div");
    grid.className = "v-card-grid";
    const slot = body.querySelector(".rss-slot");
    if (slot) slot.after(grid); else body.appendChild(grid);
  }
  if (!body.querySelector(".yt-next-wrap")) {
    const nx = document.createElement("div");
    nx.className = "yt-next-wrap";
    nx.innerHTML = `<button class="yt-next-btn" onclick="fetchChannelNext(this.dataset.cid, this)" data-cid="${esc(cid)}">Επόμενα →</button>`;
    grid.after(nx);
  }

  // 3) Ξε-κίτρινο: γίνεται κανονικό άσπρο κανάλι
  group.classList.remove("imported");
  if (!Object.prototype.hasOwnProperty.call(collapsedChannels, cid)) {
    // (κρατά ό,τι κατάσταση είχε· δεν την πειράζουμε)
  }
  return group;
}

// Τοποθετεί το (τώρα άσπρο) κανάλι ΜΕΣΑ στη ζώνη των άσπρων:
// ΑΜΕΣΩΣ ΠΡΙΝ από το πρώτο κίτρινο (δηλαδή μετά το τελευταίο άσπρο). Αν δεν υπάρχει
// κίτρινο, το βάζει στο τέλος. Έτσι ένα κανάλι που «ωρίμασε» δεν μένει σφηνωμένο
// ανάμεσα στα κίτρινα — πάει με τα δικά του.
function placeBeforeFirstImported(cid) {
  const group = document.querySelector(`.channel-group[data-key="${CSS.escape(cid)}"]`);
  const host = document.getElementById("videos");
  if (!group || !host) return;
  const imported = [...host.querySelectorAll(".channel-group.imported")];
  if (imported.length) {
    imported[0].before(group);        // ← αμέσως πριν το ΠΡΩΤΟ κίτρινο
  } else {
    host.appendChild(group);          // κανένα κίτρινο → τέλος
  }
  // Κράτα τη σειρά για το επόμενο load.
  try { saveChannelOrder(); } catch (e) {}
}

function dismissFromRSS(cid, videoId) {
  fetch("/dismiss_video", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId }),
  }).then(() => {
    RSS_DATA[cid] = (RSS_DATA[cid] || []).filter(n => n.video_id !== videoId);
    renderRssPanel(cid);
  });
}

function renderVideos(videos) {
  if (!videos.length) return '<span class="empty">Άδεια — δες ένα βίντεο στο YouTube.</span>';
  // Όταν υπάρχει ενεργό φίλτρο (αναζήτηση/αστεράκια/tag), ΟΛΑ τα matching ΑΝΟΙΓΟΥΝ.
  // ✅ ΝΕΟ: κλειστό = ΔΕΝ είναι στο expandedChannels. Όλα κλειστά by default.
  //    (Το key ελέγχεται απευθείας στο loop — δεν χρειάζεται το arr.)
  const isCollapsed = (key) => !ACTIVE_FILTER && !expandedChannels.has(key);
  const orderIndex = new Map(channelOrder.map((k, i) => [k, i]));
  // group ανά κανάλι
  const groups = new Map();
  for (const v of videos) {
    const key = v.channel_id || v.channel || "__unknown__";
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(v);
  }
  // ταξινόμηση groups (Keep-στυλ): pinned ζώνη πάνω → unpinned ζώνη κάτω → channelOrder εντός ζώνης.
  const arr = [...groups.entries()].sort((a, b) => {
    const pinnedA = a[1].some(v => v.pinned) ? 1 : 0;
    const pinnedB = b[1].some(v => v.pinned) ? 1 : 0;
    if (pinnedB !== pinnedA) return pinnedB - pinnedA;   // pinned πάνω
    const ia = orderIndex.has(a[0]) ? orderIndex.get(a[0]) : 9999;
    const ib = orderIndex.has(b[0]) ? orderIndex.get(b[0]) : 9999;
    if (ia !== ib) return ia - ib;
    return (b[1][0].last_watched_at || "") > (a[1][0].last_watched_at || "") ? 1 : -1;
  });
  let html = "";
  for (const [key, vids] of arr) {
    const first = vids[0];
    const sorted = vids.slice().sort((a, b) =>
      (b.rank || 0) - (a.rank || 0) || (b.watch_count || 0) - (a.watch_count || 0)
    );
    // Match highlight για το κανάλι: συνειδητά ΑΦΑΙΡΕΘΗΚΕ (ο χρήστης δεν θέλει περίγραμμα στο avatar).
    const chanAvatarCls = 'avatar-wrap';
    const chanHref = first.channel_id
      ? `https://www.youtube.com/channel/${esc(first.channel_id)}`
      : `https://www.youtube.com/results?search_query=${encodeURIComponent(first.channel || "")}`;
    html += `<div class="channel-group ${isCollapsed(key) ? 'collapsed' : ''} ${first.pinned ? 'pinned' : ''} ${NEW_CHANNELS.has(key) ? 'new' : ''}" data-key="${esc(key)}">
      <div class="channel-head" onclick="toggleChannel(this)">
        <span class="chevron">▾</span>
        <a class="chan-link" href="${chanHref}" target="_blank" rel="noopener" onclick="event.stopPropagation()" draggable="false" title="Άνοιξε το κανάλι στο YouTube">
          <span class="${chanAvatarCls}">${avatarHtml(first)}</span>
          <span class="channel-name">${esc(first.channel || "Άγνωστο κανάλι")}</span>
        </a>
        <span class="head-spacer"></span>
        <span class="muted">· ${vids.length} βίντεο</span>
        <button class="icon-btn tag-btn" style="width:32px;height:32px;font-size:16px" title="Tags καναλιού (σε όλα τα βίντεο)" onclick="event.stopPropagation();openTagPop(this, 'channel', '${esc(key)}')">🏷️</button>
        <button class="icon-btn watch-tgl" style="width:32px;height:32px;font-size:17px" title="Fetch νέα βίντεο" onclick="event.stopPropagation();toggleWatch('${esc(key)}', this)">${watchBellHtml(false)}</button>
        <button class="icon-btn ch-pin ${first.pinned ? 'active top' : ''}" title="Καρφίτσωμα (στην κορυφή)" onclick="event.stopPropagation();togglePinChannel('${esc(key)}', this)">${first.pinned ? '🔴' : '📌'}</button>
        <button class="icon-btn" title="Κανάλι μία θέση πάνω" onclick="event.stopPropagation();moveChannel(this, -1)">↑</button>
        <button class="icon-btn" title="Κανάλι μία θέση κάτω" onclick="event.stopPropagation();moveChannel(this, 1)">↓</button>
        <button class="icon-btn del" title="Διαγραφή καναλιού" onclick="event.stopPropagation();confirmDeleteChannel('${esc(key)}', this)">−</button>
      </div>
      <div class="channel-body">
        <div class="rss-slot"></div>
        <div class="v-card-grid">${isCollapsed(key) ? "" : sorted.map(v => cardHtml(v, "channel")).join("")}</div>
        <div class="yt-next-wrap"><button class="yt-next-btn" onclick="fetchChannelNext(this.dataset.cid, this)" data-cid="${esc(key)}">Επόμενα →</button></div>
      </div>
    </div>`;
  }
  // 📡 Εισαγμένα κανάλια (συνδρομές, χωρίς βίντεο) — στο κάτω μέρος, πορτοκαλί banner, καμπανάκι on/off.
  const existingKeys = new Set(groups.keys());
  for (const cid of Object.keys(WATCHED_META)) {
    if (existingKeys.has(cid)) continue;  // ήδη εμφανίζεται (έχει βίντεο)
    const meta = WATCHED_META[cid] || {};
    const name = meta.name || cid;
    const isOn = meta.enabled === 1;
    html += `<div class="channel-group imported" data-key="${esc(cid)}">
        <div class="channel-head" onclick="toggleChannel(this)">
          <span class="chevron">▾</span>
          <a class="chan-link" href="https://www.youtube.com/channel/${esc(cid)}" target="_blank" rel="noopener" onclick="event.stopPropagation()" draggable="false" title="Άνοιξε το κανάλι στο YouTube">
            <span class="avatar-wrap"><span class="avatar-fallback">${esc((name || '?').charAt(0).toUpperCase())}</span><img class="avatar" src="/avatar/${esc(cid)}" loading="lazy" decoding="async" onerror="this.style.display='none'" alt=""></span>
            <span class="channel-name">${esc(name)}</span>
          </a>
          <span class="head-spacer"></span>
          <button class="icon-btn tag-btn" style="width:32px;height:32px;font-size:16px" title="Tags καναλιού (σε όλα τα βίντεο)" onclick="event.stopPropagation();openTagPop(this, 'channel', '${esc(cid)}')">🏷️</button>
          <button class="icon-btn watch-tgl" style="width:32px;height:32px;font-size:17px" title="Fetch νέα βίντεο" onclick="event.stopPropagation();toggleWatch('${esc(cid)}', this)">${watchBellHtml(false)}</button>
          <button class="icon-btn ch-pin" title="Καρφίτσωμα (στην κορυφή)" onclick="event.stopPropagation();togglePinChannel('${esc(cid)}', this)">📌</button>
          <button class="icon-btn" title="Κανάλι μία θέση πάνω" onclick="event.stopPropagation();moveChannel(this, -1)">↑</button>
          <button class="icon-btn" title="Κανάλι μία θέση κάτω" onclick="event.stopPropagation();moveChannel(this, 1)">↓</button>
          <button class="icon-btn del" title="Διαγραφή καναλιού" onclick="event.stopPropagation();confirmDeleteChannel('${esc(cid)}', this)">−</button>
        </div>
        <div class="channel-body">
          <div class="rss-slot"></div>
        </div>
      </div>`;
    }
  return html;
}

function avatarHtml(v) {
  const initial = (v.channel || "?").trim().charAt(0).toUpperCase();
  const img = v.channel_id
    ? `<img class="avatar" src="/avatar/${esc(v.channel_id)}" loading="lazy" decoding="async" onerror="this.style.display='none'" alt="">`
    : "";
  return `<span class="avatar-fallback">${esc(initial)}</span>${img}`;
}

/* 🃏 Καρτέλα βίντεο (grid, σαν την αναζήτηση) — ίδια interactive λειτουργία με το row, σε κάρτα. */
function cardHtml(v, ctx) {
  const ctx2 = ctx || "channel";
  const info = matchInfo(v);
  const tags = videoTags(v);
  const chips = tags.map(t => {
    const on = selectedTags.has(t);
    return `<span class="tag-chip ${on ? 'match-chip' : ''}">${esc(t)}</span>`;
  }).join("");
  let stars = `<span class="stars ${info.rating ? 'match-stars' : ''}" title="Βαθμολόγησε 1-5">`;
  for (let i = 1; i <= 5; i++) {
    stars += `<button type="button" class="st ${i <= (v.rating || 0) ? 'on' : ''}" onclick="event.stopPropagation(); rateVideo('${esc(v.video_id)}', ${i})">★</button>`;
  }
  stars += `</span>`;
  const title = highlightTitle(v.title, info);
  const unseen = v.unseen ? true : false;
  const notes = VIDEO_NOTES[v.video_id] || [];
  const noteChip = notes.length
    ? `<span class="note-chip" title="${esc(notes.map(n => `▶ ${fmtTs(n.timestamp_sec)} ${n.title || n.note || ""}`).join(" · "))}">⏱️ ${notes.length}</span>`
    : '';
  return `
    <div class="v-card ${unseen ? 'unseen' : ''}" data-id="${esc(v.video_id)}">
      <div class="v-card-thumb-wrap" onclick="openLightbox('${esc(v.video_id)}', '${ctx2}')" title="Παίξε το βίντεο">
        <div class="v-card-thumb-ph" data-vid="${esc(v.video_id)}" ${v.color ? `style="background:${v.color}"` : ''}></div>
        <img class="v-card-thumb" src="/thumb/${esc(v.video_id)}" loading="lazy" decoding="async" onload="this.classList.add('loaded')" onerror="this.style.display='none'" alt="">
        <span class="v-card-play">▶</span>
      </div>
      <div class="v-card-title">${title}${unseen ? '<span class="new-badge">ΝΕΟ</span>' : ''}</div>
      <div class="v-card-meta">
        ${v.category ? `<span class="cat-chip">${esc(v.category)}</span>` : ''}
        ${stars}
      </div>
      <div class="v-card-meta">${chips}${noteChip}</div>
      <div class="v-card-actions">
        <button class="icon-btn tag-btn" title="Tags" onclick="event.stopPropagation();openTagPop(this, 'video', '${esc(v.video_id)}')">🏷️</button>
        <button class="icon-btn cat-btn" title="Κατηγορία" onclick="event.stopPropagation();openCatPop(this, '${esc(v.video_id)}')">📁</button>
        <button class="icon-btn lift-btn" title="Lift — απογείωσέ την" onclick="event.stopPropagation();toggleLiftCard('${esc(v.video_id)}', this)">⏫</button>
        <span class="spacer"></span>
        <button class="icon-btn del" title="Διαγραφή" onclick="event.stopPropagation();doDeleteVideo('${esc(v.video_id)}')">−</button>
      </div>
    </div>`;
}

/* --- Drag & drop (βίντεο μέσα στο group + κανάλια μεταξύ τους) --- */
let dragged = null;
let draggedType = null; // "video" ή "channel"
let dragMoved = false;  // true αν πραγματικά μετακινήθηκε (για να ΜΗΝ toggle-αρουμε μετά από drag)
let suppressClickUntil = 0;  // timestamp: μέχρι πότε αγνοούμε clicks (ghost click μετά το drag)
let lastDropTarget = null;   // cached ref στο τρέχον drop-target (αποφεύγει querySelectorAll κάθε frame)
// 🎯 Αποκλειστικές καταστάσεις αλληλεπίδρασης (μία μόνο ενεργή κάθε φορά):
//    "idle" | "dragging" | "lifting"
let interactionMode = "idle";

// Παγκόσμιο capture listener — καταπίνει το ghost click που ακολουθεί ΑΜΕΣΩΣ ένα drag,
// ώστε να μην πέφτει σε λάθος στοιχείο (αυτό που πήρε τη θέση του dragged).
document.addEventListener("click", (e) => {
  if (Date.now() < suppressClickUntil) {
    e.preventDefault();
    e.stopPropagation();
  }
}, true);

function setupDrag() {
  // ⚡ POINTER-BASED drag (60fps, μηδέν reflow κατά το drag).
  //    Videos: η κάρτα πετάει (fixed) + placeholder. Groups: όλο το group πετάει + placeholder.
  //    Στο pointerup: ΜΙΑ αλλαγή DOM + save. (Το Lift/Down είναι ΞΕΧΩΡΙΣΤΟ σύστημα.)

  if (document.body.dataset.pointerDrag === "1") return;
  document.body.dataset.pointerDrag = "1";

  let d = null;          // {type, el, startX, startY, moved, group, fromParent, dx, dy, dropRef, dropAfter}
  let ghost = null;      // το floating στοιχείο που ακολουθεί τον κέρσορα
  let dropSlot = null;   // placeholder στη ροή (κρατά το κενό)
  const DRAG_THRESHOLD = 5;

  function startDrag(e, type, el) {
    const groupEl = el.closest(".channel-group") || el.closest(".cat-group");
    d = {
      type, el,
      startX: e.clientX, startY: e.clientY,
      moved: false,
      group: groupEl,
      fromParent: (type === "video") ? el.parentNode : (groupEl ? groupEl.parentNode : el.parentNode),
    };
  }

  function onMove(e) {
    if (!d) return;
    if (!d.moved) {
      if (Math.hypot(e.clientX - d.startX, e.clientY - d.startY) < DRAG_THRESHOLD) return;
      d.moved = true;
      interactionMode = "dragging";
      beginVisualDrag(e);
    }
    moveVisualDrag(e);
  }

  // Κοινό: κάνει το στοιχείο floating (fixed) — ακολουθεί τον κέρσορα.
  function makeGhost(el, rect) {
    el.classList.add("pointer-dragging");
    el.style.width = rect.width + "px";
    el.style.height = rect.height + "px";
    el.style.left = rect.left + "px";
    el.style.top = rect.top + "px";
    document.body.appendChild(el);   // εκτός flow
    ghost = el;
  }

  function beginVisualDrag(e) {
    const el = d.el;
    if (d.type === "video") {
      // Videos: σηκώνεται η ίδια η κάρτα.
      const rect = el.getBoundingClientRect();
      dropSlot = document.createElement("div");
      dropSlot.className = "drag-slot";
      dropSlot.style.width = rect.width + "px";
      dropSlot.style.height = rect.height + "px";
      el.parentNode.insertBefore(dropSlot, el);
      makeGhost(el, rect);
      d.dx = e.clientX - rect.left;
      d.dy = e.clientY - rect.top;
    } else {
      // Groups (κανάλες/κατηγορίες): σηκώνεται ΜΟΝΟ το banner (head).
      const head = el;   // το head είναι το draggable
      const group = head.closest(".channel-group, .cat-group");
      const rect = head.getBoundingClientRect();
      // 🔒 ΑΠΟΘΗΚΕΥΣΕ το pin state ΤΩΡΑ (πριν φύγει το head στο body — αλλιώς χάνεται).
      d.dragPinned = (d.type === "channel")
        ? !!head.querySelector(".ch-pin.active")
        : group.classList.contains("pinned");
      // Placeholder στη θέση ΤΟΥ GROUP (κρατά τη θέση στη λίστα).
      dropSlot = document.createElement("div");
      dropSlot.className = "drag-slot";
      dropSlot.style.width = rect.width + "px";
      dropSlot.style.height = rect.height + "px";
      group.parentNode.insertBefore(dropSlot, group);
      // 📌 Κρύψε το ΟΛΟΚΛΗΡΟ το group από τη ροή — αλλιώς μετράει ΔΙΠΛΑ
      //    (group + placeholder) και το save βγαίνει λάθος.
      group.style.display = "none";
      head.classList.add("pointer-dragging-head");
      makeGhost(head, rect);   // 👈 ghost = το head, όχι το group
      d.group = group;         // για το τελικό insert
      d.dx = e.clientX - rect.left;
      d.dy = e.clientY - rect.top;
    }
  }

  function moveVisualDrag(e) {
    if (!ghost) return;
    ghost.style.left = (e.clientX - d.dx) + "px";
    ghost.style.top = (e.clientY - d.dy) + "px";
    findTarget(e);
  }

  function findTarget(e) {
    const gRect = ghost.getBoundingClientRect();
    const gcx = gRect.left + gRect.width / 2, gcy = gRect.top + gRect.height / 2;

    if (d.type === "video") {
      const grid = d.fromParent.closest(".v-card-grid") || d.group?.querySelector(".v-card-grid");
      if (!grid) return;
      const cards = [...grid.querySelectorAll(":scope > .v-card")].filter(c => c !== ghost);
      let best = null, minD = Infinity;
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        const dd = Math.hypot((r.left + r.width / 2) - gcx, (r.top + r.height / 2) - gcy);
        if (dd < minD) { minD = dd; best = c; }
      }
      if (!best) return;
      const r = best.getBoundingClientRect();
      const bx = r.left + r.width / 2, by = r.top + r.height / 2;
      const horiz = Math.abs(gcx - bx) > Math.abs(gcy - by);
      const after = horiz ? (gcx > bx) : (gcy > by);
      if (after) { if (best.nextElementSibling !== dropSlot) best.insertAdjacentElement("afterend", dropSlot); }
      else { if (best.previousElementSibling !== dropSlot) grid.insertBefore(dropSlot, best); }
    } else {
      const parent = d.fromParent;
      const headSel = d.type === "channel" ? ".channel-head" : ".cat-head";
      const heads = [...parent.querySelectorAll(headSel)];
      const dragPinned = d.dragPinned;
      // 🎯 Ίδια λογική με το βελάκι: βρες το ΚΟΝΤΙΝΟΤΕΡΟ group ΙΔΙΑΣ ζώνης, και
      //    τοποθέτησε το placeholder «πριν» ή «μετά» ανάλογα με την πλευρά του κέντρου.
      let best = null, minD = Infinity;
      for (const h of heads) {
        const grp = h.closest(".channel-group, .cat-group");
        if (grp === d.group) continue;
        const tgtPinned = d.type === "channel" ? !!grp.querySelector(".ch-pin.active") : grp.classList.contains("pinned");
        if (dragPinned !== tgtPinned) continue;   // 🚫 zoning (ίδιο με βελάκι)
        const r = h.getBoundingClientRect();
        const dd = Math.abs((r.top + r.height / 2) - gcy);
        if (dd < minD) { minD = dd; best = grp; }
      }
      if (!best) return;
      const r = best.getBoundingClientRect();
      // «Πριν» αν το ghost είναι πάνω από το κέντρο του best (→ πάει προς τα πάνω), αλλιώς «μετά».
      const before = gcy < r.top + r.height / 2;
      if (before) {
        if (best.previousElementSibling !== dropSlot) parent.insertBefore(dropSlot, best);
      } else {
        if (best.nextElementSibling !== dropSlot) best.insertAdjacentElement("afterend", dropSlot);
      }
    }
  }

  function onUp() {
      if (!d) return;
      if (!d.moved) { d = null; return; }   // ήταν click, όχι drag
      interactionMode = "idle";
      suppressClickUntil = Date.now() + 100;

      if (d.type === "video") {
        // Videos: το ghost (η κάρτα) επιστρέφει στη θέση του placeholder.
        if (ghost && dropSlot && dropSlot.parentNode) dropSlot.parentNode.insertBefore(ghost, dropSlot);
        if (dropSlot) { dropSlot.remove(); dropSlot = null; }
        if (ghost) { ghost.classList.remove("pointer-dragging"); ghost.style.cssText = ""; }
      } else {
        // Groups: το ghost είναι το HEAD· το GROUP μετακινείται στη θέση του placeholder.
        const group = d.group;
        // 1) βάλε το group στη θέση του placeholder,
        // 2) βγάλε το placeholder,
        // 3) επανάφερε το head μέσα στο group + εμφάνισε το group.
        if (group && dropSlot && dropSlot.parentNode) {
          dropSlot.parentNode.insertBefore(group, dropSlot);
        }
        if (dropSlot) { dropSlot.remove(); dropSlot = null; }
        if (ghost && group && ghost.parentNode !== group) {
          group.insertBefore(ghost, group.firstChild);
        }
        if (group) group.style.display = "";   // 👈 επανάφερε το group στη ροή
        if (ghost) { ghost.classList.remove("pointer-dragging"); ghost.style.cssText = ""; }
        if (d.el) d.el.classList.remove("pointer-dragging-head");
      }
      if (lastDropTarget) { lastDropTarget.classList.remove("drop-target"); lastDropTarget = null; }

      // Αποθήκευση σειράς ανά τύπο.
      if (d.type === "video") saveOrder();
      else if (d.type === "channel") saveChannelOrder();
      else {
        catOrder = [...document.querySelectorAll("#categories-list .cat-group:not([data-cat='__uncategorized__'])")].map(g => g.dataset.cat);
        saveCatState();
      }
      ghost = null; d = null;
    }

  document.addEventListener("pointerdown", (e) => {
    if (interactionMode === "lifting") return;   // Lift ενεργό → όχι drag
    if (e.button !== 0) return;
    const card = e.target.closest(".v-card");
    const chHead = e.target.closest(".channel-head");
    const catHead = e.target.closest(".cat-head");
    if (chHead) { startDrag(e, "channel", chHead); return; }
    if (catHead) { startDrag(e, "category", catHead); return; }
    if (card) { startDrag(e, "video", card); return; }
  });
  document.addEventListener("pointermove", onMove);
  document.addEventListener("pointerup", onUp);
  document.addEventListener("pointercancel", onUp);
}

/* --- 🚀 Lift / Down (καρτέλα «απογειώνεται» και «προσγειώνεται» στο grid) --- */
let liftedCard = null;        // η καρτέλα που είναι στον αέρα (ή null)
let liftedChannel = null;      // το channel-group (τείχος) που την περιέχει

function toggleLiftCard(videoId, btn) {
  // 🚫 Lift μπορείς να κάνεις ΜΟΝΟ σε idle (όχι κατά το drag).
  if (interactionMode === "dragging") return;
  // 🔍 Βρες την καρτέλα ΚΟΝΤΑ στο κουμπί που πατήθηκε (αποφεύγει duplicate video_id σε άλλα context).
  const card = (btn ? btn.closest(".v-card") : null) || document.querySelector(`.v-card[data-id="${CSS.escape(videoId)}"]`);
  if (!card) return;
  if (liftedCard === card) {
    landCard(card);
  } else {
    // αν υπάρχει ήδη lifted καρτέλα, προσγείωσέ την πρώτα
    if (liftedCard) landCard(liftedCard);
    liftCard(card);
  }
}

function liftCard(card) {
  const rect = card.getBoundingClientRect();
  // απογείωση: fixed στη θέση που βρισκόταν (η θέση στη ροή αφήνει ένα προσωρινό κενό)
  card.classList.add("lifted");
  card.style.top = rect.top + "px";
  card.style.left = rect.left + "px";
  liftedCard = card;
  liftedChannel = card.closest(".channel-group, .cat-group");  // το τείχος (κανάλι Ή κατηγορία)
  liftOriginTop = rect.top;   // σταθερή θέση στην οθόνη — εδώ μένει
  interactionMode = "lifting";   // 🎯 ΜΟΝΟ ο lift listener ενεργός — κανένα drag/click/play
  // άλλαξε το κουμπί σε "Down"
  const btn = card.querySelector(".lift-btn");
  if (btn) { btn.textContent = "⏬"; btn.title = "Down — προσγείωσέ την"; }
  // ενεργοποίησε τον boundary listener (ΈΝΑΣ μόνο — αφαιρείται πάντα στο landCard)
  window.addEventListener("scroll", clampLiftedCard, { passive: true });
  window.addEventListener("resize", clampLiftedCard, { passive: true });
}

/* 🧱 Τείχος καναλιού: η καρτέλα μένει ΣΤΑΘΕΡΗ. Μόνο αν τα όρια του καναλιού την "χτυπήσουν"
   (πάνω/κάτω τείχος φτάνει στη θέση της), τότε σπρώχνεται για να μην βγει έξω από το κανάλι. */
let liftOriginTop = 0;        // σταθερή θέση της καρτέλας στην οθόνη (top από το lift)

function clampLiftedCard() {
  if (!liftedCard || !liftedChannel) return;
  const chRect = liftedChannel.getBoundingClientRect();
  const cardH = liftedCard.getBoundingClientRect().height;

  const pad = 8;
  const minTop = chRect.top + pad;                 // πάνω τείχος (αρχή καναλιού)
  const maxTop = chRect.bottom - cardH - pad;      // κάτω τείχος (τέλος καναλιού) — πιθανόν > minTop

  // Η καρτέλα θέλει να μείνει στο liftOriginTop. Πιέζεται μόνο όταν το τείχος την φτάσει.
  let top = liftOriginTop;
  if (top < minTop) top = minTop;       // χτυπάει στο πάνω τείχος
  if (top > maxTop) top = maxTop;       // χτυπάει στο κάτω τείχος

  liftedCard.style.top = top + "px";
}

function landCard(card) {
  // 🛑 Σταμάτα τον boundary listener (ΈΝΑΣ μόνο — αυτός σβήνει εδώ, πάντα).
  window.removeEventListener("scroll", clampLiftedCard, { passive: true });
  window.removeEventListener("resize", clampLiftedCard, { passive: true });

  // 📍 Σταθερή καρτέλα → σωστή σειρά (Y) + σωστή στήλη (X).
  //    Ζητούμενο (ασύμμετρο κατώφλι):
  //      • Προς τα πάνω:  εναλλαγή όταν καλυφθεί ~30% της από πάνω (εύκολα).
  //      • Προς τα κάτω: εναλλαγή όταν καλυφθεί ~70% της από κάτω (δύσκολα).
  const grid = card.closest(".v-card-grid");
  let targetIndex = -1;   // -1 → append στο τέλος
  if (grid) {
    const cardRect = card.getBoundingClientRect();
    const cardCenterY = cardRect.top + cardRect.height / 2;
    const dropX = cardRect.left + cardRect.width / 2;

    // 🎯 Διάβασε τις ΠΡΑΓΜΑΤΙΚΕΣ στήλες από το computed style — όχι hardcoded.
    //    Δουλεύει σε 4, 3, 2, 1 στήλες και σε κάθε breakpoint.
    let cols = 1;
    try {
      const tpl = getComputedStyle(grid).gridTemplateColumns;
      const n = tpl.split(" ").filter(x => x && x !== "none").length;
      if (n > 0) cols = n;
    } catch (_) {}
    const gridRect = grid.getBoundingClientRect();
    const colWidth = gridRect.width / cols;
    let column = Math.floor((dropX - gridRect.left) / colWidth);
    if (column < 0) column = 0;
    if (column > cols - 1) column = cols - 1;

    const siblings = [...grid.querySelectorAll(".v-card")].filter(c => c !== card);
    if (siblings.length === 0) {
      targetIndex = -1;
    } else {
      // Κρατάμε μόνο τις καρτέλες της ΙΔΙΑΣ στήλης.
      const colCards = siblings.filter(s => {
        const r = s.getBoundingClientRect();
        const sCol = Math.floor((r.left + r.width / 2 - gridRect.left) / colWidth);
        return sCol === column;
      });
      const pool = colCards.length > 0 ? colCards : siblings;

      // Βρες την πιο κοντινή καρτέλα (πάνω ή κάτω) και την απόσταση σε Υ.
      // Χρησιμοποιούμε center-to-center για να βρούμε τη γειτονιά.
      let nearest = null, nearestDist = Infinity;
      for (const s of pool) {
        const r = s.getBoundingClientRect();
        const centerY = r.top + r.height / 2;
        const d = Math.abs(centerY - cardCenterY);
        if (d < nearestDist) { nearestDist = d; nearest = s; }
      }

      if (nearest) {
        const nr = nearest.getBoundingClientRect();
        const nearestCenterY = nr.top + nr.height / 2;
        const nearestIdx = siblings.indexOf(nearest);
        const nearestRow = Math.floor(nearestIdx / cols);

        // Κατεύθυνση: πάνω ή κάτω;
        const goingUp = nearestCenterY < cardCenterY;

        // Ασύμμετρο κατώφλι (ποσοστό του ΎΨΟΥΣ της γειτονικής καρτέλας):
        //   πάνω:  εναλλαγή "εύκολα"  → όριο μετατόπισης προς τα πάνω = 30% της nearest
        //   κάτω:  εναλλαγή "δύσκολα" → όριο μετατόπισης προς τα κάτω = 70% της nearest
        const threshold = goingUp ? 0.10 : 0.90;
        // Το όριο: πόσο μακριά πρέπει να "μπει" το κέντρο της card μέσα στη nearest για να εναλλαγεί.
        // Για να πάει ΠΑΝΩ (στην πάνω καρτέλα), το κέντρο της card πρέπει να ανέβει πάνω από
        //   top(nearest) + (1 - threshold)*height(nearest)  [δηλ. μέσα κατά threshold*height από το κάτω]
        // Απλοποιημένα: αν το κέντρο της card πέρασε το "σημείο απόφασης" της nearest → εναλλαγή.
        let switchPoint;
        if (goingUp) {
          // nearest είναι πάνω: το σημείο εναλλαγής = bottom(nearest) - 30%*height(nearest)
          switchPoint = nr.bottom - threshold * nr.height;
        } else {
          // nearest είναι κάτω: το σημείο εναλλαγής = top(nearest) + 70%*height(nearest)
          switchPoint = nr.top + threshold * nr.height;
        }

        let row;
        if (goingUp) {
          // θέλει να πάει πάνω (στην nearest). Εναλλαγή μόνο αν το κέντρο πέρασε το switchPoint.
          if (cardCenterY <= switchPoint) {
            row = nearestRow;           // μπαίνει στη σειρά της πάνω καρτέλας
          } else {
            row = nearestRow + 1;       // μένει από κάτω
          }
        } else {
          // θέλει να πάει κάτω. Εναλλαγή μόνο αν το κέντρο πέρασε το switchPoint (70%).
          if (cardCenterY >= switchPoint) {
            row = nearestRow + 1;       // μπαίνει κάτω από τη nearest
          } else {
            row = nearestRow;           // μένει στη σειρά της nearest
          }
        }

        targetIndex = row * cols + column;
        if (targetIndex < 0) targetIndex = 0;
      }
    }
  }
  card.classList.remove("lifted");
  card.style.top = "";
  card.style.left = "";
  // 🎯 Τοποθέτησε στη σωστή θέση (targetIndex). Αν -1 ή εκτός ορίων → τέλος.
  if (grid) {
    const children = [...grid.querySelectorAll(".v-card")];
    const idxInChildren = children.indexOf(card);
    if (idxInChildren !== -1) children.splice(idxInChildren, 1);
    if (targetIndex >= 0 && targetIndex < children.length) {
      grid.insertBefore(card, children[targetIndex]);
    } else {
      grid.appendChild(card);
    }
  }
  const btn = card.querySelector(".lift-btn");
  if (btn) { btn.textContent = "⏫"; btn.title = "Lift — απογείωσέ την"; }
  liftedCard = null;
  liftedChannel = null;
  liftOriginTop = 0;
  interactionMode = "idle";   // 🎯 επιστροφή — τώρα επιτρέπονται ξανά click/drag/play
  saveOrder();
}

function saveOrder() {
  // Κανάλια → /reorder (rank). Κατηγορίες → /reorder_cat (cat_rank). Ανεξάρτητα!
  document.querySelectorAll(".channel-group").forEach(group => {
    const ids = [...group.querySelectorAll(".vrow, .v-card")].map(r => r.dataset.id);
    fetch("/reorder", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ordered_ids: ids }),
    });
  });
  document.querySelectorAll(".cat-group").forEach(group => {
    const ids = [...group.querySelectorAll(".vrow, .v-card")].map(r => r.dataset.id);
    fetch("/reorder_cat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ordered_ids: ids }),
    });
  });
}

function saveChannelOrder() {
  // 🔧 Αγνόησε τυχόν groups που είναι προσωρινά κρυμμένα (σε drag) — δεν πρέπει να μπουν στη σειρά.
  channelOrder = [...document.querySelectorAll(".channel-group")]
    .filter(g => g.style.display !== "none")
    .map(g => g.dataset.key);
  saveUiState();
}

function muteSugg(term, btn) {
  let hidden = JSON.parse(localStorage.getItem("hiddenSugg") || "[]");
  if (!hidden.includes(term)) hidden.push(term);
  localStorage.setItem("hiddenSugg", JSON.stringify(hidden));
  btn.closest(".sugg-item").remove();
}

function doDeleteVideo(id) {
  closeDeleteConfirm();
  // ⚡ Στιγμιαία διαγραφή (χωρίς pop-up, χωρίς reload) — αφαιρεί μόνο την καρτέλα.
  fetch("/delete", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: id }),
  }).then(() => {
    allVideos = allVideos.filter(x => x.video_id !== id);
    // 🎯 αφαίρεσε την καρτέλα από το DOM (χωρίς full re-render)
    const card = document.querySelector(`.v-card[data-id="${CSS.escape(id)}"]`);
    if (card) {
      const grid = card.closest(".v-card-grid");
      card.remove();
      // ενημέρωσε το μετρητή του banner
      if (grid) {
        const group = grid.closest(".channel-group");
        const muted = group ? group.querySelector(".muted") : null;
        if (muted) muted.textContent = "· " + grid.querySelectorAll(".v-card").length + " βίντεο";
      }
    } else {
      renderCurrent();
    }
  });
}

function confirmDeleteChannel(key, btn) {
  // 🗑️ Pop-up επιβεβαίωσης διαγραφής καναλιού (κεντραρισμένο, spring) — όπως στα βίντεο.
  closeDeleteConfirm();
  const meta = WATCHED_META[key] || {};
  const vids = allVideos.filter(v => (v.channel_id || v.channel) === key);
  const name = meta.name || (vids[0] && vids[0].channel) || key;
  const n = vids.length;
  const pop = document.createElement("div");
  pop.className = "del-confirm center";
  pop.id = "del-confirm";
  pop.innerHTML = `
    <div class="dc-msg">Θα διαγραφεί το κανάλι:<br><b>${esc(name)}</b>${n ? `<br><span class="dc-warn">Μαζί με ${n} βίντεό του. Δεν ξαναγυρίζει.</span>` : `<br><span class="dc-warn">Δεν ξαναγυρίζει.</span>`}</div>
    <div class="dc-btns">
      <button class="dc-yes" onclick="doDeleteChannel('${esc(key)}')">✓ Ναι, σβήστο</button>
      <button class="dc-no" onclick="closeDeleteConfirm()">✕ Άκυρο</button>
    </div>`;
  document.body.appendChild(pop);
}

function doDeleteChannel(key) {
  closeDeleteConfirm();
  // ⚡ Στιγμιαία αφαίρεση καναλιού (και των βίντεων του).
  fetch("/delete_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: key }),
  }).then(() => {
    allVideos = allVideos.filter(v => (v.channel_id || v.channel) !== key);
    delete WATCHED_CHANNELS[key];
    delete WATCHED_META[key];
    renderCurrent();
  });
}

/* ✅ ΜΙΑ πηγή αλήθειας για το lazy γέμισμα ενός καναλιού.
   Χρησιμοποιείται από: toggleChannel, toggleAllChannels, και μετά από re-render. */
function fillChannelGrid(group) {
  if (!group) return;
  const g = group.querySelector(".v-card-grid");
  if (!g || g.dataset.filled) return;
  const k = group.dataset.key;
  const vids = allVideos.filter(v => (v.channel_id || v.channel || "__unknown__") === k);
  const sorted = vids.slice().sort((a, b) =>
    (b.rank || 0) - (a.rank || 0) || (b.watch_count || 0) - (a.watch_count || 0));
  g.innerHTML = sorted.map(v => cardHtml(v, "channel")).join("");
  g.dataset.filled = "1";
  setupDrag();
}

function toggleChannel(head) {
  const group = head.closest(".channel-group");
  const key = group.dataset.key;

  // 🟡 ImOorted (κίτρινο) κανάλι: το πάτημα στο banner = «υιοθέτησέ το» → αυτόματο fetch (spin),
  // αφαιρεί το κίτρινο και το κάνει άσπρο. Μόνο την ΠΡΩΤΗ φορά (μετά γίνεται άσπρο).
  if (group.classList.contains("imported")) {
    const refreshBtn = group.querySelector(".watch-tgl");
    toggleWatch(key, refreshBtn);
    return;
  }

  // Ο χρήστης «είδε» το κανάλι → σβήσε το μπλε banner (και ζωντανά στο DOM).
  if (NEW_CHANNELS.delete(key)) group.classList.remove("new");
  group.classList.toggle("collapsed");
  const opening = !group.classList.contains("collapsed");
  if (opening) {
    expandedChannels.add(key);
    fillChannelGrid(group);                 // ✅ LAZY: γέμισε το grid
  } else {
    expandedChannels.delete(key);
    // 🔄 Καθάρισε το flag, ώστε το επόμενο άνοιγμα να ξαναγεμίσει σωστά.
    const gClr = group.querySelector(".v-card-grid");
    if (gClr) { gClr.innerHTML = ""; delete gClr.dataset.filled; }
  }
  saveUiState();
  updateToggleAllBtn();

  // 📚 Σημείωση: το fetch πλέον γίνεται ΜΟΝΟ με το refresh icon (toggleWatch), ΟΧΙ με το ▾.
  // Το άνοιγμα του καναλιού (▾) απλώς εμφανίζει το grid με τα βίντεα που ήδη έχεις.
}

function toggleAllChannels() {
  // Αν ΟΛΑ είναι κλειστά → άνοιξε όλα. Αλλιώς → κλείσε όλα.
  const groups = [...document.querySelectorAll("#videos .channel-group")];
  const keys = groups.map(g => g.dataset.key);
  const allClosed = keys.length > 0 && keys.every(k => !expandedChannels.has(k));

  if (allClosed) {
    // άνοιξε όλα
    groups.forEach(g => { g.classList.remove("collapsed"); fillChannelGrid(g); });  // ✅ LAZY: γέμισε κάθε grid
    keys.forEach(k => expandedChannels.add(k));
  } else {
    // κλείσε όλα
    groups.forEach(g => {
      g.classList.add("collapsed");
      const gg = g.querySelector(".v-card-grid");
      if (gg) { gg.innerHTML = ""; delete gg.dataset.filled; }   // 🔄 καθάρισε
    });
    keys.forEach(k => expandedChannels.delete(k));
  }
  saveUiState();
  updateToggleAllBtn();
}

function updateToggleAllBtn() {
  const btn = document.getElementById("toggle-all");
  updateListHeadLabel();
  if (!btn) return;
  const keys = [...document.querySelectorAll("#videos .channel-group")].map(g => g.dataset.key);
  const allClosed = keys.length > 0 && keys.every(k => !expandedChannels.has(k));
  btn.classList.toggle("all-closed", allClosed);
  btn.textContent = allClosed ? "▸" : "▾";
}

// Ετικέτα "Κανάλια N" (κλειστά) ή "Κανάλια N · Βίντεο M" (ανοιχτά).
// Χρησιμοποιεί τα ήδη γνωστά totals (χωρίς να ξαναμετράει), αλλάζει μόνο η ένδειξη.
function updateListHeadLabel() {
  const el = document.getElementById("list-head-count");
  if (!el) return;
  const groups = [...document.querySelectorAll("#videos .channel-group")];
  const chCount = groups.length;
  const allClosed = chCount > 0 && groups.every(g => g.classList.contains("collapsed"));
  // Μ = όλα τα βίντεο που εμφανίζονται αυτή τη στιγμή (σύνολο των φορτωμένων)
  const vidTotal = allVideos.length;
  el.innerHTML = allClosed ? `${chCount}` : `${chCount} · Βίντεο ${vidTotal}`;
}

function saveUiState() {
  fetch("/ui_state", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      expanded: [...expandedChannels],     // ✅ ΝΕΟ: ποια άνοιξε ο χρήστης
      collapsed: [...collapsedChannels],   // legacy (κρατάμε για συμβατότητα)
      order: channelOrder,
      tab_order: tabOrder,
      rss_shown: rssShown,
    }),
  });
}

function togglePinChannel(key, btn) {
  // 📌 Keep-στυλ: απλό toggle (pinned ↔ unpinned), χωρίς popup.
  fetch("/pin_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: key }),
  }).then(r => r.json()).then(() => {
    // spring feedback στο κουμπί
    if (btn) { btn.classList.add("pinning"); }
    load();
  }).catch(() => {});
}

// Μετακινεί το κανάλι μία θέση πάνω/κάτω στη λίστα — ΣΕΒΕΤΑΙ τη ζώνη (pinned/unpinned).
function moveChannel(btn, dir) {
  const group = btn.closest(".channel-group");
  if (!group) return;
  const isGroupPinned = !!group.querySelector(".ch-pin.active");
  const sibling = dir < 0 ? group.previousElementSibling : group.nextElementSibling;
  if (sibling && sibling.classList.contains("channel-group")) {
    // Keep-στυλ: unpinned ΔΕΝ προσπερνά pinned (και αντίστροφα).
    const isSiblingPinned = !!sibling.querySelector(".ch-pin.active");
    if (isGroupPinned !== isSiblingPinned) return;   // δεν αλλάζουν ζώνη
    const parent = group.parentNode;
    if (dir < 0) parent.insertBefore(group, sibling);
    else parent.insertBefore(sibling, group);
    // ενημέρωσε το channelOrder ώστε να επιμένει
    channelOrder = [...document.querySelectorAll(".channel-group")].map(g => g.dataset.key);
    saveUiState();
  }
}

/* ================= Κατηγορίες (tab) ================= */

/* --- ↕️ Dragable Tabs: ο χρήστης φτιάχνει τη σειρά όπως θέλει (επιμένει) --- */
function applyTabOrder() {
  const nav = document.getElementById("tabs");
  if (!nav || !tabOrder.length) return;
  const btns = [...nav.querySelectorAll(".tab")];
  const byKey = {};
  btns.forEach(b => { byKey[b.dataset.tab] = b; });
  tabOrder.forEach(k => { if (byKey[k]) nav.appendChild(byKey[k]); });         // σειρά χρήστη
  btns.forEach(b => { if (!tabOrder.includes(b.dataset.tab)) nav.appendChild(b); }); // ό,τι περισσέψει → τέλος
}

function saveTabOrder() {
  const nav = document.getElementById("tabs");
  if (!nav) return;
  tabOrder = [...nav.querySelectorAll(".tab")].map(b => b.dataset.tab);
  saveUiState();
}

// Το drag των tabs δουλεύει ΚΑΙ με κλικ (switchTab) — ξεχωρίζουμε drag vs tap με κατώφλι 5px.
function initTabDrag() {
  const nav = document.getElementById("tabs");
  if (!nav || nav.dataset.tabDragReady) return;
  nav.dataset.tabDragReady = "1";

  let dragBtn = null, overEl = null, startX = 0, moved = false;

  function onDown(e) {
    const btn = e.target.closest(".tab");
    if (!btn || (e.button !== undefined && e.button !== 0)) return;
    dragBtn = btn; overEl = null; moved = false; startX = e.clientX;
    document.addEventListener("pointermove", onMove);
    document.addEventListener("pointerup", onUp, { once: true });
    document.addEventListener("pointercancel", onUp, { once: true });
  }

  function onMove(e) {
    if (!dragBtn) return;
    if (!moved && Math.abs(e.clientX - startX) < 5) return;   // 🖱️ ακόμα «κλικ», όχι drag
    if (!moved) { moved = true; dragBtn.classList.add("tab-dragging"); }
    const el = document.elementFromPoint(e.clientX, e.clientY);
    const target = el && el.closest ? el.closest(".tab") : null;
    if (!target || target === dragBtn) return;
    if (overEl && overEl !== target) overEl.classList.remove("tab-over");
    overEl = target; overEl.classList.add("tab-over");
    const r = target.getBoundingClientRect();
    if (e.clientX > r.left + r.width / 2) target.insertAdjacentElement("afterend", dragBtn);
    else target.insertAdjacentElement("beforebegin", dragBtn);
  }

  function onUp(e) {
    document.removeEventListener("pointermove", onMove);
    if (dragBtn) dragBtn.classList.remove("tab-dragging");
    if (overEl) { overEl.classList.remove("tab-over"); overEl = null; }
    if (moved) {
      // 🚫 Το drag ΔΕΝ πρέπει να αλλάξει tab — κατάπνιξε το επερχόμενο click.
      nav.dataset.suppressClick = "1";
      setTimeout(() => { delete nav.dataset.suppressClick; }, 0);
      saveTabOrder();
      dragBtn = null;
      return;
    }
    dragBtn = null;
  }

  nav.addEventListener("pointerdown", onDown);
  // Αν έγινε drag, το click δεν πρέπει να αλλάξει tab.
  nav.addEventListener("click", (e) => {
    if (nav.dataset.suppressClick) { e.stopPropagation(); e.preventDefault(); }
  }, true);
}

function switchTab(name) {
  currentTab = name;
  document.getElementById("tab-channels").classList.toggle("active", name === "channels");
  document.getElementById("tab-categories").classList.toggle("active", name === "categories");
  document.getElementById("tab-search").classList.toggle("active", name === "search");
  document.getElementById("tab-subs").classList.toggle("active", name === "subs");
  document.getElementById("view-channels").style.display = name === "channels" ? "" : "none";
  document.getElementById("view-categories").style.display = name === "categories" ? "" : "none";
  document.getElementById("view-search").style.display = name === "search" ? "" : "none";
  document.getElementById("view-subs").style.display = name === "subs" ? "" : "none";
  // 🚀 ΜΗΝ ξαναζωγραφίζεις τις Κατηγορίες αν δεν άλλαξαν! (3531 κάρτες = ακριβό)
  //    Πριν: κάθε κλικ στην καρτέλα ξανάχτιζε 3.531 κάρτες → 7.062 στο DOM, 151.531 nodes συνολικά.
  if (name === "channels" && _chanDirty) { renderCurrent(); redrawRssPanels(); }
  if (name === "categories" && _catDirty) renderCategories();
  if (name === "subs") renderSubs();
  if (name === "search") {
    document.getElementById("yt-search-input").focus();
    refreshBubbleField();
  } else {
    hideBubbleField();
  }
}

/* ===== 📥 Subscriptions tab (Φάση 1: UI + οδηγίες) ===== */
function openSubsHelp() {
  const ov = document.getElementById("subs-help-overlay");
  if (ov) ov.classList.add("open");
}
function closeSubsHelp() {
  const ov = document.getElementById("subs-help-overlay");
  if (ov) ov.classList.remove("open");
}
// Esc κλείνει το modal οδηγιών
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") closeSubsHelp();
});

// Το Subscriptions tab = πόρτα εισόδου (import + οδηγίες).
// Τα κανάλια πάνε στα Κανάλια (κίτρινα, στο τέλος) — η οργάνωση γίνεται εκεί.
function renderSubs() {
  // Δεν υπάρχει λίστα εδώ — μόνο info box + κουμπιά. (Τίποτα να render-άρουμε.)
}

function fmtViews(n) {
  n = Number(n) || 0;
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}

function fmtDuration(s) {
  s = Number(s) || 0;
  if (s <= 0) return "";
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  const mm = h > 0 ? String(m).padStart(2, "0") : String(m);
  return h > 0 ? `${h}:${mm}:${String(sec).padStart(2, "0")}` : `${mm}:${String(sec).padStart(2, "0")}`;
}

let RECENT_LOADED = false;  // έχουμε ήδη φέρει τις αναζητήσεις από τον server;

function saveRecentSearch(q) {
  // Αποθήκευση στον server (SQLite) — επιμένει μεταξύ sessions, privacy-safe.
  fetch("/recent_search", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ q })
  }).then(r => r.json()).then(d => {
    if (d.searches) { RECENT_SEARCHES = d.searches; RECENT_LOADED = true; }
  }).catch(() => {});
}

function showRecentSearches() {
  const box = document.getElementById("yt-recent");
  if (RECENT_LOADED) { renderRecent(box); return; }
  // Πρώτη φορά: φέρε από τον server → κράτα στη μνήμη (να μην ξαναγίνει fetch σε κάθε focus).
  fetch("/api/recent-searches").then(r => r.json()).then(d => {
    RECENT_SEARCHES = (d.searches && d.searches.length) ? d.searches : [];
    RECENT_LOADED = true;
    renderRecent(box);
  }).catch(() => {
    RECENT_SEARCHES = [];
    RECENT_LOADED = true;
    renderRecent(box);
  });
}

function renderRecent(box) {
  const list = RECENT_SEARCHES;
  if (!list.length) { box.style.display = "none"; return; }
  box.innerHTML = `<div class="yt-recent-head">Πρόσφατες αναζητήσεις</div>` +
    `<div class="yt-recent-grid">` +
    list.map(s =>
      `<div class="yt-recent-item" onclick="useRecentSearch('${esc(s).replace(/'/g, "\\\\'")}')">${esc(s)}</div>`
    ).join("") +
    `</div>`;
  box.style.display = "";
}

function useRecentSearch(q) {
  document.getElementById("yt-search-input").value = q;
  document.getElementById("yt-recent").style.display = "none";
  doYouTubeSearch();
}

// Κλείσε το dropdown όταν κλικάρεις οπουδήποτε αλλού.
document.addEventListener("click", (e) => {
  const recent = document.getElementById("yt-recent");
  if (!recent || recent.style.display === "none") return;
  if (e.target.id !== "yt-search-input" && !recent.contains(e.target)) {
    recent.style.display = "none";
  }
});

function setSearchMode(mode) {
  SEARCH_MODE = mode;
  document.getElementById("ym-videos").classList.toggle("active", mode === "videos");
  document.getElementById("ym-channels").classList.toggle("active", mode === "channels");
  // αν υπάρχει ήδη αποτέλεσμα → ξαναψάξε από την αρχή με το νέο mode
  const q = document.getElementById("yt-search-input").value.trim();
  if (q) doYouTubeSearch();
}

function doYouTubeSearch() {
  // Νέα αναζήτηση: offset 0 (πρώτη σελίδα)
  SEARCH_OFFSET = 0;
  hideBubbleField();   // αναζήτηση → τα bubbles φεύγουν
  runYTSearch(0);
}

// ♾️ INFINITE SCROLL — το ζήτησε ο Ανδρίκος («να φορτώνει όσο σκρολάρω»).
//    Διαφέρει από το v39 που απέτυχε: τώρα το prefetch έχει ΗΔΗ φέρει τα δεδομένα
//    (ο «ταμίας»), οπότε το γέμισμα είναι ακαριαίο και το κύμα τρέχει πάνω σε
//    ΥΠΑΡΧΟΝΤΑ δεδομένα — δεν περιμένει δίκτυο.
let _infBound = false, _infTick = null;
function armInfiniteScroll() {
  // ♾️ ΑΞΙΟΠΙΣΤΟΣ ΤΡΟΠΟΣ: περιοδικός έλεγχος (polling) — ΟΧΙ events.
  //    Γιατί όχι events: (α) ο IntersectionObserver δένει σε κόμβο που ξαναχτίζεται,
  //    (β) το scroll event μπορεί να χαθεί σε γρήγορο/προγραμματιστικό scroll.
  //    Ο τακτικός έλεγχος δεν χάνει ΠΟΤΕ — απλώς ρωτά «πλησιάζει ο πάτος;».
  if (_infBound) return;
  _infBound = true;
  window.addEventListener("scroll", _maybeLoadMore, { passive: true });  // γρήγορη αντίδραση
  _infTick = setInterval(_maybeLoadMore, 500);                            // δίχτυ ασφαλείας
  _maybeLoadMore();
}

function _maybeLoadMore() {
  if (!SEARCH_HAS_MORE || SEARCH_BUSY) return;
  const box = document.getElementById("yt-search-results");
  if (!box) return;
  const r = box.getBoundingClientRect();
  // Όταν ο πάτος της λίστας πλησιάζει (1,2 οθόνες πριν), φόρτωσε την επόμενη.
  if (r.bottom < window.innerHeight + 1200) {
    SEARCH_BUSY = true;
    runYTSearch(SEARCH_OFFSET + 24);
  }
}

let _nextQueued = false;
function searchNextPage() {
  // Επόμενη σελίδα — 24 ανά σελίδα.
  // 🔒 ΚΛΕΙΔΩΜΑ (δύο ταυτόχρονες = στοίβαγμα) ΑΛΛΑ χωρίς χαμένα κλικ:
  //    αν είναι απασχολημένο, ΘΥΜΗΣΟΥ το κλικ και τρέξ' το μόλις ελευθερωθεί.
  //    (Πριν, το κλικ χανόταν σιωπηλά και φαινόταν σαν «κόλλημα».)
  if (!SEARCH_HAS_MORE) return;
  if (SEARCH_BUSY) { _nextQueued = true; return; }
  SEARCH_BUSY = true;
  runYTSearch(SEARCH_OFFSET + 24);
}

function releaseSearchBusy() {
  // 🔓 Ξεκλείδωσε — και αν περίμενε κλικ, τρέξ' το ΑΜΕΣΩΣ (τότε δεν φαίνεται κόλλημα).
  SEARCH_BUSY = false;
  // ♾️ Αν ο χρήστης είναι ΑΚΟΜΑ στο κάτω μέρος, συνέχισε το infinite scroll.
  setTimeout(() => { try { _maybeLoadMore(); } catch (e) {} }, 120);
  if (_nextQueued) {
    _nextQueued = false;
    setTimeout(() => { if (SEARCH_HAS_MORE && !SEARCH_BUSY) searchNextPage(); }, 30);
  }
}

// 🦴 Skeleton loading: 24 πλαίσια ΑΜΕΣΑ (πριν απαντήσει το YouTube), μετά γεμίζουν τίτλοι + εικόνες.
let _waveTimers = [];
function clearWaveTimers() {
  // 🧹 Σταματά τα εκκρεμή «κύματα» — χωρίς αυτό, τα παλιά setTimeout σωρεύονταν
  //    (288 timers σε βαθύ σκρολ) και κόλλαγε το UI.
  _waveTimers.forEach(t => clearTimeout(t));
  _waveTimers = [];
}

let _rearmTimer = null;
let _prefetchDone = {};
let _prefetchBusy = false;      // 🔒 ΕΝΑ prefetch τη φορά — αλλιώς στοιβάζονταν
                                //    (3 ταυτόχρονα × κάθε κλικ = ουρά 9+ yt-dlp κλήσεων
                                //     → κόλλαγε γύρω στα 120, που το yt-dlp αργεί).

function prefetchNextPage() {
  // 🛒 Ο «ΤΑΜΙΑΣ» — ΜΙΑ σελίδα μπροστά, ΠΟΤΕ ταυτόχρονα δύο.
  //    Ίδιο «ακαριαίο Επόμενα», χωρίς ουρά που στοιβάζεται και κολλάει.
  // Αν η ΚΥΡΙΑ αναζήτηση είναι σε εξέλιξη, το prefetch περιμένει (προτεραιότητα στον χρήστη).
  if (_prefetchBusy || SEARCH_BUSY || !SEARCH_HAS_MORE || !SEARCH_QUERY) return;
  const off = SEARCH_OFFSET + 24;                 // 24 = page size
  // 🧱 Σταματά το prefetch σε βάθος: μετά τα ~168 το YouTube δίνει άσχετα
  //    (ο Ανδρίκος το παρατήρησε: «UI» → «Samsung UI») — δεν αξίζει τον χρόνο.
  if (off >= 168) return;
  const key = SEARCH_MODE + "|" + SEARCH_QUERY + "|" + off;
  if (_prefetchDone[key]) return;
  _prefetchDone[key] = true;
  _prefetchBusy = true;
  fetch("/search", {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ q: SEARCH_QUERY, mode: SEARCH_MODE, offset: off, limit: 24 }),
  }).then(r => r.json()).then(() => { _prefetchBusy = false; })
    .catch(() => { _prefetchBusy = false; delete _prefetchDone[key]; });
}

function fillCardsProgressive(box, items, append, kind) {
  // 🪜 ΣΚΑΛΟΠΑΤΙΑ (ιδέα Ανδρίκου): οι πρώτες 6 με 200ms (γρήγορη «πρώτη εικόνα»),
  //    οι υπόλοιπες με 120ms (πιο πυκνά — «συμπληρώνεται»). Η παρουσίαση ΚΑΛΥΠΤΕΙ
  //    τον χρόνο της αναζήτησης, οπότε ο χρήστης νιώθει ότι όλα ήρθαν ακαριαία.
  //    🔚 Ό,τι skeleton ΠΕΡΙΣΣΕΨΕ σβήνεται — ποτέ λευκές κάρτες.
  const FIRST_N = 6;      // πόσες στο πρώτο σκαλοπάτι
  const STEP_1  = 200;    // ms ανά κάρτα — πρώτες 6 (το βλέπεις να έρχονται)
  const STEP_2  = 120;    // ms ανά κάρτα — οι υπόλοιπες (πιο γρήγορα)
  const sel     = kind === "channel" ? ".yt-channel" : ".yt-video";
  const hostSel = kind === "channel" ? ".yt-channels" : ".yt-videos";
  const render  = kind === "channel" ? channelCardHtml : videoCardHtml;

  let host = box.querySelector(hostSel);
  if (!host) {
    box.insertAdjacentHTML("beforeend",
      (kind === "channel"
        ? '<div class="yt-sec-title">📺 Κανάλια</div><div class="yt-channels"></div>'
        : '<div class="yt-sec-title">🎬 Βίντεο</div><div class="yt-videos"></div>'));
    host = box.querySelector(hostSel);
  }

  // 🔚 Πρώτα-πρώτα: καθάρισε τα περισσευούμενα skeletons ΑΜΕΣΩΣ, κρατώντας
  //    τόσα όσα είναι τα πραγματικά αποτελέσματα (για το κύμα).
  const leftovers = host.querySelectorAll(sel + ".skeleton");
  for (let i = items.length; i < leftovers.length; i++) leftovers[i].remove();

  // ⏱️ Υπολόγισε την ώρα κάθε κάρτας: πρώτες 6 με STEP_1, μετά με STEP_2.
  const startAt = [];
  let t = 0;
  items.forEach((_, i) => { startAt.push(t); t += (i < FIRST_N ? STEP_1 : STEP_2); });

  if (!append) clearWaveTimers();     // νέα αναζήτηση → σκότωσε τα παλιά κύματα
  items.forEach((it, i) => {
    _waveTimers.push(setTimeout(() => {
      const sk = host.querySelector(sel + ".skeleton");
      const tmp = document.createElement("div");
      tmp.innerHTML = render(it).trim();
      const card = tmp.firstElementChild;
      card.style.opacity = "0";                 // ξεκίνα «θολό»...
      if (sk) sk.replaceWith(card); else host.appendChild(card);
      requestAnimationFrame(() => { card.style.opacity = ""; });   // ...και ξεθόλωσε
      if (typeof setupDrag === "function" && kind === "channel") { try { setupDrag(); } catch (e) {} }
    }, startAt[i]));
  });

  // 🎯 Όσο το κύμα τρέχει, ο «ταμίας» προ-φορτώνει την επόμενη σελίδα.
  _waveTimers.push(setTimeout(() => { prefetchNextPage(); }, startAt[Math.min(6, items.length - 1)]));

  // ♾️ Ξανα-όπλισε τον infinite scroll με ΞΕΧΩΡΙΣΤΟ timer.
  //    ⚠️ ΔΕΝ μπαίνει στο _waveTimers: αυτά καθαρίζονται στο τέλος του κύματος,
  //    οπότε ο οπλισμός χανόταν και ο observer έμενε δεμένος σε νεκρό sentinel.
  clearTimeout(_rearmTimer);
  _rearmTimer = setTimeout(() => { armInfiniteScroll(); }, t + 300);

  // 🔚 Δίχτυ ασφαλείας + καθαρισμός του πίνακα timers.
  _waveTimers.push(setTimeout(() => {
    if (host.isConnected) host.querySelectorAll(sel + ".skeleton").forEach(s => s.remove());
    _waveTimers = [];
  }, t + 400));
}

function appendSearchSkeletons(box) {
  // Προσθέτει 16 skeleton κάρτες στο ΤΕΛΟΣ της υπάρχουσας λίστας (για το «Επόμενα»).
  const n = 24;
  if (SEARCH_MODE === "channels") {
    let host = box.querySelector(".yt-channels");
    if (!host) {
      box.insertAdjacentHTML("beforeend", '<div class="yt-sec-title">📺 Κανάλια</div><div class="yt-channels"></div>');
      host = box.querySelector(".yt-channels");
    }
    let html = "";
    for (let i = 0; i < n; i++) {
      html += `<div class="yt-channel skeleton">
        <div class="yt-channel-logo-wrap"><div class="sk-avatar"></div></div>
        <div class="yt-channel-name"><span class="skeleton-line" style="width:70%"></span></div>
        <button class="yt-btn add yt-add-btn" disabled>➕ Παρακολούθησε</button>
      </div>`;
    }
    host.insertAdjacentHTML("beforeend", html);
  } else {
    let host = box.querySelector(".yt-videos");
    if (!host) {
      box.insertAdjacentHTML("beforeend", '<div class="yt-sec-title">🎬 Βίντεο</div><div class="yt-videos"></div>');
      host = box.querySelector(".yt-videos");
    }
    let html = "";
    for (let i = 0; i < n; i++) {
      html += `<div class="yt-video skeleton">
        <div class="yt-thumb-wrap"><div class="yt-thumb-ph"></div><span class="yt-play-icon">▶</span></div>
        <div class="yt-video-title"><span class="skeleton-line" style="width:90%"></span></div>
        <div class="yt-video-meta"><span class="skeleton-line" style="width:55%"></span></div>
        <button class="yt-btn add yt-add-btn" disabled>➕ Add</button>
      </div>`;
    }
    host.insertAdjacentHTML("beforeend", html);
  }
}

function showSearchSkeletons() {
  const results = document.getElementById("yt-search-results");
  results.innerHTML = "";
  if (SEARCH_MODE === "channels") {
    let html = `<div class="yt-sec-title">📺 Κανάλια</div><div class="yt-channels">`;
    for (let i = 0; i < 24; i++) {
      html += `
        <div class="yt-channel skeleton">
          <div class="yt-channel-logo-wrap"><div class="sk-avatar"></div></div>
          <div class="yt-channel-name"><span class="skeleton-line" style="width:70%"></span></div>
          <button class="yt-btn add yt-add-btn" disabled>➕ Παρακολούθησε</button>
        </div>`;
    }
    html += `</div>`;
    results.innerHTML = html;
  } else {
    let html = `<div class="yt-sec-title">🎬 Βίντεο</div><div class="yt-videos">`;
    for (let i = 0; i < 24; i++) {
      html += `
        <div class="yt-video skeleton">
          <div class="yt-thumb-wrap">
            <div class="yt-thumb-ph"></div>
            <span class="yt-play-icon">▶</span>
          </div>
          <div class="yt-video-title"><span class="skeleton-line" style="width:90%"></span></div>
          <div class="yt-video-meta"><span class="skeleton-line" style="width:55%"></span></div>
          <button class="yt-btn add yt-add-btn" disabled>➕ Add</button>
        </div>`;
    }
    html += `</div>`;
    results.innerHTML = html;
  }
}

function runYTSearch(offset) {
  const q = document.getElementById("yt-search-input").value.trim();
  if (!q) return;
  SEARCH_QUERY = q;
  SEARCH_OFFSET = offset;
  // Αποθήκευσε μόνο τις ΝΕΕΣ αναζητήσεις (όχι το "next page").
  if (offset === 0) saveRecentSearch(q);
  const status = document.getElementById("yt-search-status");
  const results = document.getElementById("yt-search-results");
  if (offset === 0) {
    _prefetchDone = {};          // 🧹 νέα αναζήτηση → καθάρισε τα προ-φορτωμένα
    // πρώτη σελίδα: 24 skeletons ΑΜΕΣΑ (όχι spinner) — ο χρήστης βλέπει κάτι ακαριαία.
    status.style.display = "none";
    showSearchSkeletons();
  } else {
    // 🖼️ επόμενη σελίδα: 16 SKELETON κάρτες ΑΜΕΣΩΣ στο κάτω μέρος (Pinterest-style),
    //    όχι spinner — ο χώρος δεσμεύεται ακαριαία και γεμίζει με blur-up.
    status.style.display = "none";
    const oldNext = document.getElementById("yt-next-wrap");
    if (oldNext) oldNext.remove();
    appendSearchSkeletons(results);
  }
  fetch("/search", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ q, mode: SEARCH_MODE, offset, limit: 24 }),   // 📄 24/σελίδα (ίδιο με το κατέβασμα)
  }).then(r => r.json()).then(d => {
    const loader = document.getElementById("yt-loading");
    if (loader) loader.remove();
    status.style.display = "none";
    if (d.ok) {
      // 🔚 «Τέλος» = πήρα λιγότερα από 24 (βίντεο ή κανάλια) — ίδια λογική με το fetch καναλιών.
      //    Ο server στέλνει has_more· αν λείψει, το συμπεραίνουμε από το πλήθος.
      const gotV = (d.videos || []).length, gotC = (d.channels || []).length;
      releaseSearchBusy();                     // 🔓 ξεκλείδωσε (+ τρέξε τυχόν ουρά)
      SEARCH_HAS_MORE = (typeof d.has_more === "boolean")
        ? d.has_more
        : (SEARCH_MODE === "channels" ? (gotC >= 24) : (gotV >= 24));
      renderYTSearch(d.videos || [], d.channels || [], q, offset > 0);
    } else {
      status.style.display = "";
      status.textContent = "⚠️ " + (d.error || "Σφάλμα");
    }
  }).catch(() => {
    releaseSearchBusy();                       // 🔓 ξεκλείδωσε ακόμα κι αν απέτυχε
    const loader = document.getElementById("yt-loading");
    if (loader) loader.remove();
    status.style.display = "";
    status.textContent = "⚠️ Σφάλμα σύνδεσης — τρέχει ο server;";
  });
}

function videoCardHtml(v) {
  return `
    <div class="yt-video">
      <div class="yt-thumb-wrap" onclick="openSearchVideo('${esc(v.video_id)}')" title="Δες το βίντεο">
        <div class="yt-thumb-ph" data-vid="${esc(v.video_id)}" ${v.color ? `style="background:${v.color}"` : ''}></div>
        <img class="yt-thumb" src="${v.thumb}" onload="this.classList.add('loaded')" alt="">
        ${v.duration ? `<span class="yt-dur">${fmtDuration(v.duration)}</span>` : ""}
        <span class="yt-play-icon">▶</span>
      </div>
      <div class="yt-video-title">${esc(v.title)}</div>
      <div class="yt-video-meta">${esc(v.channel)}${v.views ? ` · ${fmtViews(v.views)}` : ""}</div>
      <button class="yt-btn add yt-add-btn" onclick="event.stopPropagation();addVideoFromSearch('${esc(v.video_id)}', this)">➕ Add</button>
    </div>`;
}

function channelCardHtml(c) {
  const watched = WATCHED_CHANNELS[c.channel_id] === 1;
  return `
    <div class="yt-channel" onclick="openChannelPreview('${esc(c.channel_id)}','${esc(c.name).replace(/'/g, "\\'")}')" title="Δες το κανάλι">
      <div class="yt-channel-logo-wrap">
        <div class="yt-channel-avatar-ph"></div>
        <img class="yt-channel-avatar" src="/avatar/${esc(c.channel_id)}" onload="this.classList.add('loaded')" alt="" onerror="this.style.display='none'">
      </div>
      <div class="yt-channel-name">${esc(c.name)}</div>
      <button class="yt-btn ${watched ? "watched" : "add"} yt-add-btn" onclick="event.stopPropagation();watchChannelFromSearch('${esc(c.channel_id)}')">
        ${watched ? "✓ Παρακολουθείς" : "➕ Παρακολούθησε"}
      </button>
    </div>`;
}

function renderYTSearch(videos, channels, q, append) {
  const box = document.getElementById("yt-search-results");
  if (append) {
    // Σε επόμενη σελίδα: κράτα τα ήδη υπάρχοντα, πρόσθεσε νέα κάτω, και ξαναστοίβαξε το Next.
    SEARCH_VIDEOS = SEARCH_VIDEOS.concat(videos || []);
    // βγάλε το παλιό Next πριν προσθέσουμε τα νέα
    const oldNext = document.getElementById("yt-next-wrap");
    if (oldNext) oldNext.remove();
  } else {
    SEARCH_VIDEOS = videos || [];
    box.innerHTML = "";
  }
  if (!videos.length && !channels.length && !append) {
    box.innerHTML = `<div class="yt-empty">Δεν βρέθηκαν αποτελέσματα για «${esc(q)}».</div>`;
    return;
  }
  let html = "";

  if (videos.length) {
    // 🌊 «Κύμα»: γέμισε τις κάρτες μία-μία (50ms η καθεμιά) πάνω στα skeletons —
    //    το blur-up transition αναλαμβάνει το ομαλό «ξεθολώμα».
    fillCardsProgressive(box, videos, append, "video");
  }

  if (channels.length) {
    fillCardsProgressive(box, channels, append, "channel");
  }

  // 🔽 INFINITE SCROLL: αόρατος αισθητήρας + ΜΙΚΡΟ κουμπί από κάτω (fallback/χειροκίνητο).
  //    Όσο έχει κι άλλα → ο αισθητήρας φορτώνει μόλις τον πλησιάσεις.
  //    Στο τέλος → διακριτικό «— τέλος —».
  // ♾️ Ο αισθητήρας ζει στο ΤΕΛΟΣ της λίστας (μέσα στο grid container), ώστε να
  //    ξανα-οπλίζεται σωστά σε κάθε σελίδα. Το «— τέλος —» μπαίνει στο wrap.
  html += `<div class="yt-next-wrap" id="yt-next-wrap">` +
    (SEARCH_HAS_MORE ? `` : `<span class="yt-the-end">— τέλος —</span>`) +
    `</div>`;
  if (SEARCH_HAS_MORE) html += `<div class="yt-sentinel" id="yt-sentinel" aria-hidden="true"></div>`;

  box.insertAdjacentHTML("beforeend", html);
  armInfiniteScroll();          // 👁️ μόλις σκρολάρεις κοντά στο τέλος → φόρτωσε την επόμενη
  // ⚠️ ΔΕΝ καλούμε fetchColors στην αναζήτηση: ζητά 48 thumbnails από το YouTube και
  //    σε αργή σύνδεση (πλοίο) επιβαρραίνει. Τα placeholders έχουν shimmer + blur-up.
}

function addVideoFromSearch(videoId, btn) {
  fetch("/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url: "https://www.youtube.com/watch?v=" + videoId }),
  }).then(r => r.json()).then(d => {
    if (!d.ok) { alert(d.error || "Σφάλμα"); return; }
    // ✅ Άμεσο feedback: πρασινίζει + γίνεται ✓ με spring (όπως στο lightbox).
    if (btn) {
      btn.innerHTML = "✓ Add";
      btn.classList.add("added");
    }
    // 🔄 Πλήρες reload (όπως πριν) — τα δεδομένα ενημερώνονται.
    setTimeout(() => { try { load(); } catch (e) {} }, 420);
  }).catch(() => alert("Σφάλμα σύνδεσης"));
}

function watchChannelFromSearch(channelId) {
  const want = WATCHED_CHANNELS[channelId] === 1 ? 0 : 1;
  fetch("/watch_channel", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: channelId, enabled: want === 1 }),
  }).then(r => r.json()).then(() => {
    WATCHED_CHANNELS[channelId] = want;
    // Νέο κανάλι → μπλε banner (μέχρι να το «δει»/ανοίξει ο χρήστης).
    if (want === 1) NEW_CHANNELS.add(channelId);
    const q = document.getElementById("yt-search-input").value.trim();
    if (q) renderYTSearch(window._lastSearchVideos || [], window._lastSearchChannels || [], q);
    // ξαναφέρε τα αποτελέσματα με ενημερωμένο state — απλά ξαναψάξε
    doYouTubeSearch();
  }).catch(() => alert("Σφάλμα σύνδεσης"));
}

function openVidInTab(videoId) {
  window.open("https://www.youtube.com/watch?v=" + videoId, "_blank");
}

function openSearchVideo(videoId) {
  // Παίζει ένα βίντεο των αποτελεσμάτων στο floating player (δεν ανοίγει YouTube).
  openLightbox(videoId, "search");
}

let CW_CHANNEL_ID = null;

function openChannelPreview(channelId, nameFallback) {
  CW_CHANNEL_ID = channelId;
  const cw = document.getElementById("cw");
  cw.style.display = "flex";
  // άμεσο feedback πριν έρθουν τα δεδομένα
  document.getElementById("cw-avatar").style.display = "none";
  document.getElementById("cw-title").textContent = nameFallback || channelId;
  const watchBtn = document.getElementById("cw-watch");
  const watched = WATCHED_CHANNELS[channelId] === 1;
  watchBtn.textContent = watched ? "✓ Παρακολουθείς" : "➕ Παρακολούθησε";
  watchBtn.classList.toggle("watched", watched);
  watchBtn.classList.toggle("add", !watched);
  document.getElementById("cw-videos").innerHTML = '<div class="yt-empty">…φόρτωση βίντεο…</div>';

  fetch("/channel_preview", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ channel_id: channelId }),
  }).then(r => r.json()).then(d => {
    if (!d.ok || !d.preview) {
      document.getElementById("cw-videos").innerHTML = '<div class="yt-empty">Δεν μπόρεσα να φέρω το κανάλι.</div>';
      return;
    }
    const p = d.preview;
    document.getElementById("cw-title").textContent = p.name || channelId;
    const av = document.getElementById("cw-avatar");
    if (p.avatar) {
      av.src = p.avatar;
      av.style.display = "";
      // fallback στο δικό μας /avatar endpoint αν σπάσει το og:image
      av.onerror = function () { this.src = "/avatar/" + channelId; };
    }
    const vids = document.getElementById("cw-videos");
    if (!p.videos || !p.videos.length) {
      vids.innerHTML = '<div class="yt-empty">Κανένα πρόσφατο βίντεο.</div>';
      return;
    }
    vids.innerHTML = p.videos.map(v => `
      <div class="cw-video" onclick="openVidInTab('${esc(v.video_id)}')" title="Δες στο YouTube">
        <img class="cw-video-thumb" src="${v.thumb}" loading="lazy" alt="" onerror="this.style.display='none'">
        <span class="cw-video-title">${esc(v.title)}</span>
      </div>`).join("");
  }).catch(() => {
    document.getElementById("cw-videos").innerHTML = '<div class="yt-empty">Σφάλμα σύνδεσης.</div>';
  });
}

function closeChannelPreview() {
  document.getElementById("cw").style.display = "none";
  CW_CHANNEL_ID = null;
}

function watchChannelFromWindow() {
  const channelId = CW_CHANNEL_ID;
  if (!channelId) return;
  watchChannelFromSearch(channelId);
  // ενημέρωσε το κουμπί στο window
  const watched = WATCHED_CHANNELS[channelId] === 1;
  const btn = document.getElementById("cw-watch");
  btn.textContent = watched ? "✓ Παρακολουθείς" : "➕ Παρακολούθησε";
  btn.classList.toggle("watched", watched);
  btn.classList.toggle("add", !watched);
}

function addCategory() {
  const input = document.getElementById("cat-new-input");
  const name = input.value.trim();
  if (!name) return;
  fetch("/create_category", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ name }),
  }).then(() => {
    input.value = "";
    if (!ALL_CATEGORIES.includes(name)) { ALL_CATEGORIES.push(name); ALL_CATEGORIES.sort(); }
    renderCategories();
  });
}

function confirmDeleteCategory(name, btn) {
  closeCatConfirm();
  const rect = btn.getBoundingClientRect();
  const pop = document.createElement("div");
  pop.className = "del-confirm";
  pop.id = "cat-confirm";
  pop.innerHTML = `
    <div class="dc-msg">Θα σβηστεί η κατηγορία <b>${esc(name)}</b> από <b>ΟΛΑ</b> τα βίντεο.<br><span class="dc-warn">Τα βίντεό της θα γίνουν ακατηγοριοποίητα. Δεν ξαναγυρίζει.</span></div>
    <div class="dc-btns">
      <button class="dc-yes" onclick="doDeleteCategory('${esc(name)}')">✓ Ναι, σβήστο</button>
      <button class="dc-no" onclick="closeCatConfirm()">✕ Άκυρο</button>
    </div>`;
  document.body.appendChild(pop);
  const popW = 280, popH = 110;
  let left = rect.left;
  let top = rect.bottom + 6;
  if (top + popH > window.innerHeight) top = rect.top - popH - 6;
  if (left + popW > window.innerWidth) left = window.innerWidth - popW - 8;
  pop.style.left = Math.max(8, left) + "px";
  pop.style.top = Math.max(8, top) + "px";
}

function closeCatConfirm() {
  const p = document.getElementById("cat-confirm");
  if (p) p.remove();
}

function doDeleteCategory(name) {
  closeCatConfirm();
  fetch("/delete_category", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ name }),
  }).then(() => {
    ALL_CATEGORIES = ALL_CATEGORIES.filter(c => c !== name);
    allVideos.forEach(v => { if (v.category === name) v.category = ""; });
    closeCatPop();
    renderCategories();
    renderCurrent();
  });
}

/* --- Search μέσα στο tab Κατηγορίες --- */
let catSearchRating = 0;   // 0 = κανένα, 1-5 = ακριβές rating
let catSearchTimer = null;

function setCatSearchRating(n) {
  catSearchRating = n;
  const stars = document.querySelectorAll("#cat-search-stars .st");
  stars.forEach((s, i) => s.classList.toggle("on", i < n));
  // ✕ πάντα ορατό — κόκκινο + glow μόνο όταν υπάρχει ενεργό rating
  const clr = document.getElementById("cat-rating-clear");
  if (clr) clr.classList.toggle("active", n > 0);
  renderCategories();
}

// Φιλτράρει τα βίντεο του tab κατηγοριών (κείμενο + rating + επιλεγμένες κατηγορίες) — τοπικά.
function catFilteredVideos() {
  const q = (document.getElementById("cat-search-input").value || "").trim().toLowerCase();
  const hasCatFilter = selectedCats.size > 0;
  return allVideos.filter(v => {
    // κατηγορίες (OR ένωση): αν έχω τσεκάρει, το βίντεο πρέπει να ανήκει σε ΜΙΑ από αυτές
    if (hasCatFilter && !selectedCats.has(((v.category || v.user_category) || "").trim())) return false;
    if (catSearchRating && (v.rating || 0) !== catSearchRating) return false;
    if (!q) return true;
    const tags = videoTags(v).join(" ");
    const hay = `${v.title || ""} ${v.channel || ""} ${tags} ${v.category || ""}`.toLowerCase();
    return hay.includes(q);
  });
}

function toggleFilterCat(name, on) {
  if (on) selectedCats.add(name); else selectedCats.delete(name);
  renderCategories();
}

function doCatSearch(q) {
  clearTimeout(catSearchTimer);
  catSearchTimer = setTimeout(() => renderCategories(), 150);
}

function doCatSearchNow() {
  clearTimeout(catSearchTimer);
  renderCategories();
}

function renderCategories() {
  _catDirty = false;
  const el = document.getElementById("categories-list");
  if (!el) return;
  // φιλτράρισμα (search text + rating + επιλεγμένες κατηγορίες) — όπως στα κανάλια
  const filtered = catFilteredVideos();
  const hasFilter = !!(document.getElementById("cat-search-input").value.trim() || catSearchRating > 0);
  // ομαδοποίηση βίντεο ανά user_category + τα ακατηγοριοποίητα ξεχωριστά
  const byCat = new Map();
  const uncategorized = [];
  for (const v of filtered) {
    const cat = ((v.category || v.user_category) || "").trim();
    if (!cat) { uncategorized.push(v); continue; }
    if (!byCat.has(cat)) byCat.set(cat, []);
    byCat.get(cat).push(v);
  }
  // σειρά κατηγοριών: catOrder πρώτα, μετά όσες δεν είναι στη λίστα (αλφαβητικά)
  const allNames = [...new Set([...ALL_CATEGORIES, ...byCat.keys()])].sort();
  const orderedNames = [
    ...catOrder.filter(n => allNames.includes(n)),
    ...allNames.filter(n => !catOrder.includes(n)),
  ];
  // 🟣 Pinned πρώτα (ζώνη), μετά unpinned — όπως τα κανάλια.
  const sortedNames = [
    ...orderedNames.filter(n => pinnedCats.has(n)),
    ...orderedNames.filter(n => !pinnedCats.has(n)),
  ];
  const cntEl = document.getElementById("list-head-cat-count");
  if (cntEl) cntEl.textContent = allNames.length ? `(${allNames.length})` : "";

  // Πτυσσόμενο panel κατηγοριών (κίτρινο κουμπί δίπλα στο «Κατηγορίες») — checkbox φίλτρο + × διαγραφή
  renderCatFilterPanel(allNames);

  let html = "";
  // Κατηγοριοποιημένα → ομάδες με 📌 / ↑ / ↓ / − (όπως τα κανάλια)
  for (const name of sortedNames) {
    const vids = (byCat.get(name) || []).slice().sort((a, b) =>
      (b.cat_rank || 0) - (a.cat_rank || 0) || (b.rank || 0) - (a.rank || 0)
    );
    const open = !collapsedCats.has(name);
    const pinned = pinnedCats.has(name);
    const rows = `<div class="v-card-grid">${vids.map(v => cardHtml(v, "category")).join("")}</div>`;
    html += `<div class="cat-group ${pinned ? 'pinned' : ''} ${open ? '' : 'collapsed'}" data-cat="${esc(name)}">
      <div class="cat-head" onclick="toggleCatGroup(this)">
        <span class="cat-chevron">${open ? '▾' : '▸'}</span>
        <span class="cat-name">${esc(name)}</span>
        <span class="cat-count">· ${vids.length} βίντεο</span>
        <span class="head-spacer"></span>
        <button class="icon-btn ch-pin ${pinned ? 'active top' : ''}" title="Καρφίτσωμα κατηγορίας" onclick="event.stopPropagation();togglePinCategory('${esc(name)}', this)">${pinned ? '🔴' : '📌'}</button>
        <button class="icon-btn" title="Κατηγορία μία θέση πάνω" onclick="event.stopPropagation();moveCategory(this, -1)">↑</button>
        <button class="icon-btn" title="Κατηγορία μία θέση κάτω" onclick="event.stopPropagation();moveCategory(this, 1)">↓</button>
        <button class="icon-btn del" title="Διαγραφή κατηγορίας" onclick="event.stopPropagation();confirmDeleteCategory('${esc(name)}', this)">−</button>
      </div>
      <div class="cat-body">${rows}</div>
    </div>`;
  }
  // Ακατηγοριοποίητα → τελευταία, κάτω-κάτω
  if (uncategorized.length) {
    const open = !collapsedCats.has("__uncategorized__");
    const unc = uncategorized.slice().sort((a, b) => (b.cat_rank || 0) - (a.cat_rank || 0) || (b.rank || 0) - (a.rank || 0));
    const rows = `<div class="v-card-grid">${unc.map(v => cardHtml(v, "category")).join("")}</div>`;
    html += `<div class="cat-group ${open ? '' : 'collapsed'}" data-cat="__uncategorized__">
      <div class="cat-head" onclick="toggleCatGroup(this)">
        <span class="cat-chevron">${open ? '▾' : '▸'}</span>
        <span class="cat-name" style="color:var(--muted)">Ακατηγοριοποίητα</span>
        <span class="cat-count">· ${uncategorized.length} βίντεο</span>
        <span class="head-spacer"></span>
      </div>
      <div class="cat-body">${rows}</div>
    </div>`;
  }
  el.innerHTML = html || '<span class="empty">Κανένα βίντεο.</span>';
  try { setupDrag(); } catch (e) {}
  updateToggleAllCatBtn();
}

function toggleCatGroup(head) {
  const group = head.closest(".cat-group");
  const key = group.dataset.cat;
  const chev = head.querySelector(".cat-chevron");
  if (group.classList.contains("collapsed")) {
    group.classList.remove("collapsed");
    collapsedCats.delete(key);
    if (chev) chev.textContent = "▾";   // ανοιχτό → κάτω
  } else {
    group.classList.add("collapsed");
    collapsedCats.add(key);
    if (chev) chev.textContent = "▸";   // κλειστό → δεξιά
  }
  saveCatState();
}

function renderCatFilterPanel(allNames) {
  const panel = document.getElementById("cat-filter-panel");
  const totalEl = document.getElementById("cat-total");
  const activeEl = document.getElementById("cat-active");
  if (!panel) return;
  if (totalEl) totalEl.textContent = `(${allNames.length})`;
  if (activeEl) activeEl.textContent = selectedCats.size > 0 ? `· ${selectedCats.size} ενεργά` : "";
  if (!allNames.length) {
    panel.innerHTML = '<span class="lbl" style="font-size:12px">📁 Φτιάξε κατηγορίες για να φιλτράρεις.</span>';
    return;
  }
  panel.innerHTML = allNames.map(name => {
    const on = selectedCats.has(name);
    return `<label class="tag-chk yellow ${on ? 'on' : ''}">
      <input type="checkbox" ${on ? 'checked' : ''} onchange="toggleFilterCat('${esc(name)}', this.checked)">${esc(name)}
      <span class="tag-filter-x" title="Διαγραφή κατηγορίας «${esc(name)}»" onclick="event.stopPropagation();confirmDeleteCategory('${esc(name)}', this)">×</span>
    </label>`;
  }).join("");
}

function toggleCatPanel() {
  const panel = document.getElementById("cat-filter-panel");
  if (!panel) return;
  const show = panel.style.display === "none";
  panel.style.display = show ? "block" : "none";
  const chev = document.getElementById("cat-chevron");
  if (chev) chev.textContent = show ? "▴" : "▾";
}

function toggleAllCategories() {
  const groups = [...document.querySelectorAll("#categories-list .cat-group")];
  if (!groups.length) return;
  const allClosed = groups.every(g => g.classList.contains("collapsed"));
  groups.forEach(g => {
    const key = g.dataset.cat;
    if (allClosed) {
      g.classList.remove("collapsed");
      collapsedCats.delete(key);
    } else {
      g.classList.add("collapsed");
      collapsedCats.add(key);
    }
  });
  saveCatState();
  updateToggleAllCatBtn();
}

function updateToggleAllCatBtn() {
  const btn = document.getElementById("toggle-all-cat");
  if (!btn) return;
  const groups = [...document.querySelectorAll("#categories-list .cat-group")];
  const allClosed = groups.length > 0 && groups.every(g => g.classList.contains("collapsed"));
  btn.textContent = allClosed ? "▸" : "▾";
  btn.classList.toggle("all-closed", allClosed);
}

// Αποθηκεύει σειρά + collapsed κατηγοριών στη βάση (μαζί με το ui_state των καναλιών).
function saveCatState() {
  fetch("/ui_state", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      expanded: [...expandedChannels],
      collapsed: [...collapsedChannels],
      order: channelOrder,
      tab_order: tabOrder,
      rss_shown: rssShown,
      cat_order: [...document.querySelectorAll("#categories-list .cat-group:not([data-cat='__uncategorized__'])")].map(g => g.dataset.cat),
      cat_collapsed: [...collapsedCats],
      cat_pinned: [...pinnedCats],
    }),
  });
}

function moveCategory(btn, dir) {
  const group = btn.closest(".cat-group");
  if (!group) return;
  const isPinned = group.classList.contains("pinned");
  const sibling = dir < 0 ? group.previousElementSibling : group.nextElementSibling;
  if (sibling && sibling.classList.contains("cat-group") && sibling.dataset.cat !== "__uncategorized__") {
    // 🚫 Zoning: pinned ↔ unpinned ΔΕΝ αλλάζουν ζώνη (όπως τα κανάλια).
    const sibPinned = sibling.classList.contains("pinned");
    if (isPinned !== sibPinned) return;
    const parent = group.parentNode;
    if (dir < 0) parent.insertBefore(group, sibling);
    else parent.insertBefore(sibling, group);
    saveCatState();
  }
}

function togglePinCategory(name, btn) {
  // 📌 Toggle (pinned ↔ unpinned), όπως τα κανάλια. Αμέσως μωβ/άσπρο + σώζει.
  if (pinnedCats.has(name)) pinnedCats.delete(name);
  else pinnedCats.add(name);
  if (btn) { btn.classList.add("pinning"); }
  saveCatState();
  renderCategories();
}

/* --- Popover κατηγοριών (📁) --- */
function openCatPop(btn, videoId) {
  // 🎯 Toggle: αν το pop-up είναι ήδη ανοιχτό για το ίδιο βίντεο, κλείσ' το.
  const pop = document.getElementById("cat-pop");
  if (pop.classList.contains("open") && catPopTarget === videoId) {
    closeCatPop();
    return;
  }
  catPopTarget = videoId;
  catPopBtn = btn;
  const v = allVideos.find(x => x.video_id === videoId);
  const current = v?.category || "";
  renderCatPopList(current);
  pop.classList.add("open");
  repositionCatPop();
}

function closeCatPop() {
  document.getElementById("cat-pop").classList.remove("open");
  catPopTarget = null;
  catPopBtn = null;
}

function renderCatPopList(currentCat) {
  const list = document.getElementById("cat-pop-list");
  let html = `<div class="tag-pop-item">
      <label class="tag-pop-label">
        <input type="radio" name="cat-radio" value="" ${!currentCat ? 'checked' : ''} onchange="setVideoCategory('')">(καμία κατηγορία)
      </label>
    </div>`;
  for (const c of ALL_CATEGORIES) {
    html += `<div class="tag-pop-item">
      <label class="tag-pop-label">
        <input type="radio" name="cat-radio" value="${esc(c)}" ${currentCat === c ? 'checked' : ''} onchange="setVideoCategory('${esc(c)}')">${esc(c)}
      </label>
      <button class="tag-del" title="Διαγραφή κατηγορίας «${esc(c)}» από παντού" onclick="confirmDeleteCategory('${esc(c)}', this)">×</button>
    </div>`;
  }
  list.innerHTML = html;
}

function setVideoCategory(cat) {
  if (!catPopTarget) return;
  fetch("/set_category", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: catPopTarget, category: cat }),
  }).then(() => {
    const v = allVideos.find(x => x.video_id === catPopTarget);
    if (v) v.category = cat;
    if (cat && !ALL_CATEGORIES.includes(cat)) { ALL_CATEGORIES.push(cat); ALL_CATEGORIES.sort(); }
    closeCatPop();
    renderCurrent();
    renderCategories();
  });
}

function saveVideoCategory() {
  const input = document.getElementById("cat-pop-new-input");
  const name = input.value.trim();
  if (!name) return;
  input.value = "";
  setVideoCategory(name);
}

function repositionCatPop() {
  const pop = document.getElementById("cat-pop");
  if (!pop.classList.contains("open") || !catPopBtn) return;
  const r = catPopBtn.getBoundingClientRect();
  if (r.bottom < 0 || r.top > window.innerHeight) { closeCatPop(); return; }
  pop.style.top = Math.min(r.bottom + 6, window.innerHeight - pop.offsetHeight - 8) + "px";
  pop.style.left = Math.max(8, Math.min(r.left, window.innerWidth - 300)) + "px";
}

function addVideo() {
  const input = document.getElementById("add-url");
  const url = input.value.trim();
  if (!url) return;
  fetch("/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url }),
  }).then(r => r.json()).then(d => {
    if (d.ok) {
      input.value = "";
      load();
    } else {
      alert(d.error || "Σφάλμα");
    }
  }).catch(() => alert("Σφάλμα σύνδεσης — τρέχει ο server;"));
}

function esc(s) {
  return String(s ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
}

// 📸 Blur-up: delegated load listener (capture) — ξεθολώνει εικόνες μόλις φορτώσουν (και cached).
document.addEventListener("load", (e) => {
  const t = e.target;
  if (t && t.classList && (t.classList.contains("v-card-thumb") || t.classList.contains("yt-thumb") || t.classList.contains("yt-channel-avatar"))) {
    t.classList.add("loaded");
  }
}, true);

// 🎨 Φέρνει τα dominant colors ασύγχρονα (ΜΕΤΑ το render) — δεν μπλοκάρει το search.
async function fetchColors(ids) {
  ids = (ids || []).filter(Boolean).slice(0, 48);
  if (!ids.length) return;
  try {
    const r = await fetch("/colors", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ids }),
    });
    const d = await r.json();
    if (d.ok && d.colors) {
      for (const id in d.colors) {
        document.querySelectorAll(`.v-card-thumb-ph[data-vid="${CSS.escape(id)}"], .yt-thumb-ph[data-vid="${CSS.escape(id)}"]`).forEach(ph => {
          ph.style.background = d.colors[id];
        });
      }
    }
  } catch (e) {}
}

// 🎛️ Keyboard shortcuts ΟΤΑΝ το lightbox είναι ανοιχτό
//    ← → : προηγούμενο/επόμενο βίντεο · Space : play/pause · N : σημειώσεις · Esc : κλείσιμο
document.addEventListener("keydown", (e) => {
  const lb = document.getElementById("lb");
  if (!lb || lb.style.display === "none") return;     // μόνο όταν ο player είναι ανοιχτός
  const tag = (e.target && e.target.tagName || "").toLowerCase();
  const typing = (tag === "input" || tag === "textarea" || (e.target && e.target.isContentEditable));

  if (e.key === "Escape" || e.key === "Esc") {
    if (typing) return;                                // άφησε το Esc στο πεδίο
    e.preventDefault(); closeLightbox(); return;
  }
  if (typing) return;                                  // μη κλέβεις τα πλήκτρα όταν γράφει σημείωση

  if (e.key === "ArrowLeft")  { e.preventDefault(); stepLightbox(-1); return; }
  if (e.key === "ArrowRight") { e.preventDefault(); stepLightbox(1);  return; }
  if (e.key === " " || e.code === "Space") { e.preventDefault(); playerToggle(); return; }
  if (e.key === "n" || e.key === "N") { e.preventDefault(); toggleNotes(); return; }
  if (e.key === "s" || e.key === "S") { e.preventDefault(); toggleSpeedMenu(); return; }
});

// Esc = έξοδος από search/filter mode (ακόμα κι αν το focus είναι στο input)
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" || e.key === "Esc") {
    // αν το lightbox (floating player) είναι ανοιχτό, το Esc ΔΕΝ πρέπει να ξαναχτίσει τη λίστα
    const lb = document.getElementById("lb");
    if (lb && lb.style.display !== "none") return;
    clearSearch();
    // επίσης καθάρισε τα tag filters
    selectedTags.clear();
    renderTagFilter();
    renderCurrent();
  }
});

// 🌙/☀️ Θέμα — αποθήκευση + εφαρμογή
function applyTheme(theme, persist) {
  document.documentElement.setAttribute("data-theme", theme);
  const btn = document.getElementById("theme-toggle");
  if (btn) btn.textContent = theme === "light" ? "☀️" : "🌙";
  if (persist) {
    try { localStorage.setItem("pyt-theme", theme); } catch (e) {}
    // 💾 Και στη βάση — το localStorage ΔΕΝ επιμένει στο WebView (νέο origin κάθε εκκίνηση).
    fetch("/ui_state", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ theme: theme }),
    }).catch(() => {});
  }
}
function toggleTheme() {
  const cur = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
  // 🌗 cross-fade: απαλό flash overlay αντί για «κλικ-και-άλλαξε».
  themeFlash();
  applyTheme(cur, true);
}
function themeFlash() {
  let ov = document.getElementById("theme-flash");
  if (!ov) {
    ov = document.createElement("div");
    ov.id = "theme-flash";
    ov.style.cssText = "position:fixed;inset:0;background:var(--accent);opacity:0;pointer-events:none;z-index:9999;transition:opacity .22s ease;";
    document.body.appendChild(ov);
  }
  // δύο φάσεις: ανάβει, σβήνει
  ov.style.transition = "opacity .22s ease";
  ov.style.opacity = "0.12";
  setTimeout(() => { ov.style.opacity = "0"; }, 160);
}
function initTheme() {
  // 🌙 Αρχική εκτίμηση: localStorage (γρήγορο, χωρίς flicker).
  // Το load() θα το κάνει OVERRIDE με το theme από τη βάση (πηγή αλήθειας).
  let saved = null;
  try { saved = localStorage.getItem("pyt-theme"); } catch (e) {}
  applyTheme(saved === "dark" ? "dark" : "light", false);
}
initTheme();

/* --- 🎬 Floating player (lightbox) --- */
let LB = { queue: [], idx: 0, context: null }; // context: "channel" | "category" | "feed"

/* ⏩ Πόσα δευτερόλεπτα πάει το skip μπρος/πίσω (άλλαξέ το εδώ — το UI δείχνει 20 σταθερά,
   οπότε αν το αλλάξεις, άλλαξε και τα <span class="lb-skip-num">20</span> στο HTML). */
const SKIP_SEC = 20;
/* ⏱️ Μικρό βήμα (τα μονά βελάκια εκατέρωθεν του play). */
const SKIP_SMALL = 5;

// Χτίσε την ουρά Prev/Next ανάλογα με το πού βρίσκεσαι.
function buildQueue(context, videoId) {
  let list = [];
  const all = allVideos || [];
  if (context === "channel") {
    // όλα τα βίντεα του ίδιου καναλιού
    const v = all.find(x => x.video_id === videoId);
    const key = v ? (v.channel_id || v.channel || "__unknown__") : null;
    list = all.filter(x => (x.channel_id || x.channel || "__unknown__") === key).map(x => x.video_id);
  } else if (context === "category") {
    // όλα τα βίντεα της ίδιας κατηγορίας
    const v = all.find(x => x.video_id === videoId);
    const cat = v ? (v.category || "") : "";
    list = all.filter(x => (x.category || "") === cat).map(x => x.video_id);
  } else if (context === "search") {
    // Αποτελέσματα αναζήτησης — σειρά προβολής αριστερά→δεξιά, πάνω→κάτω.
    list = (SEARCH_VIDEOS || []).map(x => x.video_id);
  } else if (context === "feed") {
    // News Feed (όλα τα νέα του καναλιού), μετά τα κατεβασμένα του καναλιού.
    // Το videoId μπορεί να είναι ΝΕΟ βίντεο (δεν είναι ακόμα στο allVideos) → βρες το cid από το RSS_DATA.
    let cid = null;
    const v = all.find(x => x.video_id === videoId);
    if (v) {
      cid = v.channel_id || v.channel || "__unknown__";
    } else {
      for (const k in (RSS_DATA || {})) {
        if ((RSS_DATA[k] || []).some(n => n.video_id === videoId)) { cid = k; break; }
      }
    }
    if (!cid) { list = [videoId]; return list; }
    const feedIds = (RSS_DATA[cid] || []).map(n => n.video_id);
    const downloaded = all.filter(x => (x.channel_id || x.channel || "__unknown__") === cid).map(x => x.video_id);
    // feed πρώτα, μετά downloaded (χωρίς διπλότυπα)
    const seen = new Set();
    list = [...feedIds, ...downloaded].filter(id => { if (seen.has(id)) return false; seen.add(id); return true; });
  }
  if (!list.includes(videoId)) list.unshift(videoId);
  return list;
}

function openLightbox(videoId, context) {
  // 🎯 Παίζεις ελεύθερα (και με lifted καρτέλα). Μόνο κατά το drag δεν παίζεις.
  if (interactionMode === "dragging") return;
  const queue = buildQueue(context, videoId);
  if (!queue.length) return;
  LB.queue = queue;
  LB.context = context;
  LB.idx = queue.indexOf(videoId);
  if (LB.idx < 0) LB.idx = 0;
  markSeen(videoId);
  showLightbox();
}

/* ── ⏱️ Timestamp Notes ─────────────────────────────────────────── */
function fmtTs(sec) {
  sec = Number(sec) || 0;
  const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = Math.floor(sec % 60);
  const mm = h > 0 ? String(m).padStart(2, "0") : String(m);
  const ss = String(s).padStart(2, "0");
  return h > 0 ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
}

// Διάβασε το τρέχον σημείο του βίντεο — μέσω του YouTube IFrame API (γνήσιο currentTime).
let ytPlayers = {};
function currentTimestamp() {
  const vid = LB.queue[LB.idx];
  try {
    // Εάν ο player έγινε οριστικοποιημένος μέσω API, ρώτησε τον πραγματικό χρόνο.
    if (ytPlayers[vid] && typeof ytPlayers[vid].getCurrentTime === "function") {
      const t = ytPlayers[vid].getCurrentTime();
      if (typeof t === "number" && isFinite(t)) return Math.floor(t);
    }
  } catch (err) {}
  return LB._ts || 0;
}

// Ορίζεται από το YouTube IFrame API μόλις φορτώσει.
function onYouTubeIframeAPIReady() {
  window._ytReady = true;
}

// Φτιάχνει τον player μέσω του YouTube IFrame API, ώστε να διαβάζουμε το τρέχον σημείο.
// 📺 Υπότιτλοι: ΚΛΕΙΣΤΟΙ ΠΑΝΤΑ στην εκκίνηση κάθε βίντεο.
// Ο χρήστης τους ανάβει από τα κουμπιά του YouTube — δεν κρατάμε προτίμηση
// (το API δεν δίνει αξιόπιστο γεγονός για το αν τους άναψε ο χρήστης).
function applyCaptionDefault() {
  const p = currentPlayer();
  if (!p) return;
  try { if (typeof p.unloadModule === "function") { p.unloadModule("captions"); p.unloadModule("cc"); } } catch (_) {}
  try { if (typeof p.setOption === "function") p.setOption("captions", "track", {}); } catch (_) {}
}

function createYTPlayer(videoId) {
  const frame = document.getElementById("lb-frame");
  // Ξεκάθαρο div-στόχος για τον API player.
  frame.innerHTML = `<div id="yt-player-${videoId}"></div>`;
  const mount = () => {
    try {
      ytPlayers[videoId] = new YT.Player(`yt-player-${videoId}`, {
        videoId: videoId,
        playerVars: { autoplay: 1, rel: 0, enablejsapi: 1, origin: window.location.origin },
        events: {
          onReady: () => {
            // 📺 υπότιτλοι: ΠΑΝΤΑ κλειστοί στην εκκίνηση του βίντεο
            try { setTimeout(applyCaptionDefault, 150); } catch (_) {}
            // 🐇 κράτα την ταχύτητα που διάλεξε ο χρήστης σε κάθε νέο βίντεο
            try {
              const r = (typeof LB.rate === "number") ? LB.rate : 1;
              if (r !== 1 && ytPlayers[videoId] && ytPlayers[videoId].setPlaybackRate) {
                ytPlayers[videoId].setPlaybackRate(r);
              }
            } catch (_) {}
            try { updateSpeedUI(); } catch (_) {}
          },
          onStateChange: (e) => {
            // ενημέρωσε το LB._ts συνέχεια όσο παίζει (fallback αν το getCurrentTime δεν απαντήσει)
            try { if (ytPlayers[videoId] && ytPlayers[videoId].getCurrentTime) LB._ts = ytPlayers[videoId].getCurrentTime(); } catch (_) {}
            // 🎛️ ενημέρωσε το ▶/⏸ μόλις αλλάξει η κατάσταση
            try { updatePlayButton(); } catch (_) {}
            try { updateProgress(); } catch (_) {}
          },
        },
      });
    } catch (err) {
      // fallback: σκέτο iframe αν το API δεν είναι διαθέσιμο.
      frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${esc(videoId)}?autoplay=1&rel=0&enablejsapi=1" allow="autoplay; fullscreen; encrypted-media" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;
    }
    // 🎠 ο player είναι έτοιμος → συμπλήρωσε carousel + progress + state
    try { updateCarousel(); } catch (e) {}
    try { updateProgress(); } catch (e) {}
    try { updatePlayButton(); } catch (e) {}
    try { startLbPoll(); } catch (e) {}
    try { bindEdgePreview(); } catch (e) {}
  };
  if (window.YT && window.YT.Player) { mount(); }
  else if (window._ytReady) { mount(); }
  else {
    // φόρτωσε το IFrame API αν δεν έχει φορτωθεί ακόμα
    if (!document.getElementById("yt-api-script")) {
      const s = document.createElement("script");
      s.id = "yt-api-script";
      s.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(s);
    }
    const prevReady = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = () => {
      window._ytReady = true;
      if (prevReady) prevReady();
      mount();
    };
  }
}

function renderNotes() {
  const videoId = LB.queue[LB.idx];
  const box = document.getElementById("lb-notes");
  if (!box) return;
  fetch(`/api/video-notes?video_id=${encodeURIComponent(videoId)}`).then(r => r.json()).then(d => {
    const notes = d.notes || [];
    try { renderMarkers(notes); } catch (e) {}   // 🔴 markers στη progress bar
    if (!notes.length) {
      box.innerHTML = '<div class="lb-note-empty">⏱️ Κανένα σημείο σημειωμένο ακόμα.</div>';
      return;
    }
    box.innerHTML = notes.map(n => `
      <div class="lb-note-item">
        <span class="lb-note-ts" onclick="seekTo(${n.timestamp_sec})" title="Πήγαινε στο σημείο">▶ ${fmtTs(n.timestamp_sec)}</span>
        <div class="lb-note-body">
          ${n.title ? `<div class="lb-note-title">${esc(n.title)}</div>` : ""}
          ${n.note ? `<div class="lb-note-text">${esc(n.note)}</div>` : ""}
        </div>
        <button class="lb-note-del" onclick="deleteNote(${n.id})" title="Διαγραφή">🗑</button>
      </div>`).join("");
  }).catch(() => {});
}

function openNoteForm() {
  const box = document.getElementById("lb-notes");
  const ts = currentTimestamp();
  box.insertAdjacentHTML("afterbegin", `
    <div class="lb-note-form" id="lb-note-form">
      <div class="lb-note-form-row">
        <span class="ts-label">⏱️ ${fmtTs(ts)}</span>
        <input type="text" id="note-title" placeholder="Τίτλος (π.χ. Πώς ρυθμίζω ISO)">
      </div>
      <textarea id="note-text" placeholder="Σημείωση…"></textarea>
      <div class="lb-note-form-actions">
        <button onclick="closeNoteForm()">Άκυρο</button>
        <button class="primary" onclick="saveNote()">Αποθήκευση</button>
      </div>
    </div>`);
  // εστίασέ στον τίτλο
  const t = document.getElementById("note-title");
  if (t) t.focus();
}

function closeNoteForm() {
  const f = document.getElementById("lb-note-form");
  if (f) f.remove();
}

function saveNote() {
  const videoId = LB.queue[LB.idx];
  const title = (document.getElementById("note-title") || {}).value || "";
  const text = (document.getElementById("note-text") || {}).value || "";
  if (!title && !text) { closeNoteForm(); return; }
  fetch("/add_note", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId, title, note: text, timestamp_sec: currentTimestamp() })
  }).then(r => r.json()).then(() => {
    closeNoteForm();
    renderNotes();
  }).catch(() => {});
}

function deleteNote(noteId) {
  const videoId = LB.queue[LB.idx];
  fetch("/delete_note", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ note_id: noteId, video_id: videoId })
  }).then(r => r.json()).then(() => renderNotes()).catch(() => {});
}

function seekTo(sec) {
  const videoId = LB.queue[LB.idx];
  // Αν υπάρχει API player → seek πάνω του (χωρίς reload).
  if (ytPlayers[videoId] && typeof ytPlayers[videoId].seekTo === "function") {
    try { ytPlayers[videoId].seekTo(sec, true); return; } catch (err) {}
  }
  // Fallback: επαναφόρτωσε το iframe στο σημείο.
  const frame = document.getElementById("lb-frame");
  frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${esc(videoId)}?autoplay=1&rel=0&start=${Math.floor(sec)}" allow="autoplay; fullscreen; encrypted-media" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;
}

function showLightbox() {
  const videoId = LB.queue[LB.idx];
  const all = allVideos || [];
  const v = all.find(x => x.video_id === videoId);

  document.getElementById("lb").style.display = "flex";
  const frame = document.getElementById("lb-frame");

  // Προσωρινό loading (μέχρι να μάθουμε αν επιτρέπεται embed)
  frame.innerHTML = '<div class="lb-loading">…φόρτωση…</div>';

  // info: τίτλος + κανάλι + κατηγορία (αν υπάρχει στα δεδομένα)
  // Ο τίτλος ΔΕΝ γράφεται πια κάτω από το βίντεο (υπάρχει μέσα στο YouTube embed).
  // Κρατάμε μόνο το feedTitle: το χρειάζεται το «blocked» μήνυμα όταν ένα βίντεο δεν παίζει.
  let feedTitle = null;
  if (v) {
    feedTitle = v.title;
  } else {
    // News Feed ή Search — βίντεο που ΔΕΝ είναι ακόμα στη βιβλιοθήκη.
    let n = null;
    for (const k in (RSS_DATA || {})) { n = (RSS_DATA[k] || []).find(x => x.video_id === videoId); if (n) break; }
    if (n) {
      feedTitle = n.title;
    } else {
      const s = (SEARCH_VIDEOS || []).find(x => x.video_id === videoId);
      feedTitle = s ? s.title : videoId;
    }
  }

  // controls
  document.getElementById("lb-pos").textContent = `${LB.idx + 1} / ${LB.queue.length}`;
  document.getElementById("lb-prev").disabled = LB.idx <= 0;
  document.getElementById("lb-next").disabled = LB.idx >= LB.queue.length - 1;

  // ➕ add + ✕ dismiss: ΜΟΝΟ στο News Feed (context "feed") και μόνο αν το βίντεο ΔΕΝ είναι ήδη στη βιβλιοθήκη
  const isDownloaded = v !== undefined;
  const addBtn = document.getElementById("lb-add");
  const dismissBtn = document.getElementById("lb-dismiss");
  const showFeedActions = ((LB.context === "feed" || LB.context === "search") && !isDownloaded);
  // 🎯 Στην ΑΝΑΖΗΤΗΣΗ κρατάμε ΜΟΝΟ το ➕ (το κόκκινο ✕ «Δεν με ενδιαφέρει» αφαιρέθηκε).
  const showDismiss = (LB.context === "feed" && !isDownloaded);
  addBtn.style.display = showFeedActions ? "flex" : "none";
  dismissBtn.style.display = showDismiss ? "flex" : "none";
  // ⏱️ Σημείωση εδώ: ΜΟΝΟ όταν το βίντεο είναι ΔΙΚΟ ΣΟΥ (στη λίστα).
  const noteBtn = document.getElementById("lb-note-btn");
  if (noteBtn) noteBtn.style.display = isDownloaded ? "flex" : "none";
  const notesBox = document.getElementById("lb-notes");
  if (notesBox) notesBox.style.display = isDownloaded ? "" : "none";
  // Επαναφορά του ➕ στο κανονικό state κάθε φορά που αλλάζει βίντεο,
  // ώστε να μπορείς να προσθέσεις ΚΑΙ το επόμενο (δεν μένει μόνιμα «✓»).
  if (showFeedActions) {
    addBtn.textContent = "➕";
    addBtn.classList.remove("added");
    addBtn.style.opacity = "1";
    addBtn.style.pointerEvents = "auto";
  }

  // ⏱️ Φόρτωσε τα timestamp notes κάτω από το player.
  LB._ts = 0;
  updateCarousel();
  updateSpeedUI();
  try { bindEdgePreview(); previewHoverEnd(-1); previewHoverEnd(1); } catch (_) {}
  try { applyCaptionDefault(); } catch (_) {}
  renderNotes();

  // 🎬 Ρώτα το backend αν επιτρέπεται embed → iframe ή fallback.
  fetch("/embeddable", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ video_id: videoId }),
  }).then(r => r.json()).then(d => {
    if (d.embeddable === false) {
      // Owner μπλόκαρε το embed → thumbnail + κουμπί «Άνοιξε στο YouTube».
      frame.innerHTML = `
        <div class="lb-blocked">
          <img class="lb-blocked-thumb" src="/thumb/${esc(videoId)}" onerror="this.style.display='none'" alt="">
          <div class="lb-blocked-title">${esc(feedTitle)}</div>
          <button class="lb-blocked-btn" onclick="window.open('https://www.youtube.com/watch?v=${esc(videoId)}','_blank')">▶ Άνοιξε στο YouTube</button>
        </div>`;
    } else {
      // embed επιτρέπεται (ή άγνωστο → δοκιμάζουμε embed) — μέσω IFrame API για να διαβάζουμε τον χρόνο.
      createYTPlayer(videoId);
    }
  }).catch(() => {
    // Σε σφάλμα δικτύου → δοκίμασε embed (fallback-safe).
    createYTPlayer(videoId);
  });
}

// 🎯 Hover στα βελάκια αλλαγής βίντεο → σηκώνει την αντίστοιχη κάρτα (ίδιο με hover στην κάρτα).
function previewHover(dir) {
  const card = document.getElementById(dir < 0 ? "lb-side-prev" : "lb-side-next");
  if (!card || card.classList.contains("hidden")) return;
  card.classList.add("hover-preview");
}
function previewHoverEnd(dir) {
  const card = document.getElementById(dir < 0 ? "lb-side-prev" : "lb-side-next");
  if (card) card.classList.remove("hover-preview");
}
function bindEdgePreview() {
  for (const [id, dir] of [["lb-prev", -1], ["lb-next", 1]]) {
    const btn = document.getElementById(id);
    if (!btn || btn.dataset.previewBound === "1") continue;
    btn.dataset.previewBound = "1";
    btn.addEventListener("pointerenter", () => previewHover(dir));
    btn.addEventListener("pointerleave", () => previewHoverEnd(dir));
    btn.addEventListener("focus", () => previewHover(dir));
    btn.addEventListener("blur", () => previewHoverEnd(dir));
  }
}

function stepLightbox(dir) {
  const ni = LB.idx + dir;
  if (ni < 0 || ni >= LB.queue.length) return;
  LB.idx = ni;
  const videoId = LB.queue[LB.idx];
  markSeen(videoId);
  showLightbox();
  animateCarouselHandoff(dir);
}

/* ═══════════════════════════════════════════════════════════════
   🎛️ PLAYER CONTROLS + 🎠 CAROUSEL + 📝 NOTES SIDEBAR
   Χρησιμοποιεί το YouTube IFrame API (ytPlayers) που ήδη φορτώνεται.
   ═══════════════════════════════════════════════════════════════ */

// ── Ποιος player είναι ενεργός τώρα ──
function currentPlayer() {
  const vid = LB.queue[LB.idx];
  if (!vid || !ytPlayers) return null;
  const p = ytPlayers[vid];
  if (!p || typeof p.getCurrentTime !== "function") return null;
  return p;
}

// ── ⏯️ PLAY / PAUSE ──
function playerToggle() {
  const p = currentPlayer();
  // Αν δεν έχουμε API player, το iframe δεν ελέγχεται — δεν λέμε ψέματα.
  if (!p) return;
  const state = (typeof p.getPlayerState === "function") ? p.getPlayerState() : -1;
  if (state === 1) { p.pauseVideo(); }        // 1 = PLAYING
  else { p.playVideo(); }
  updatePlayButton();
}

function updatePlayButton() {
  const btn = document.getElementById("lb-play");
  if (!btn) return;
  const p = currentPlayer();
  let playing = false;
  if (p && typeof p.getPlayerState === "function") {
    try { playing = (p.getPlayerState() === 1); } catch (_) {}
  }
  btn.textContent = playing ? "⏸" : "▶";
  btn.title = playing ? "Παύση (Space)" : "Αναπαραγωγή (Space)";
  try { updateSpeedUI(); } catch (e) {}
}

// ── ⏩⏪ SKIP μέσα στο βίντεο (±10s) ──
function playerSkip(sec) {
  const p = currentPlayer();
  if (!p || typeof p.getCurrentTime !== "function") return;
  let t = 0;
  try { t = p.getCurrentTime() || 0; } catch (_) {}
  const dur = (typeof p.getDuration === "function") ? (p.getDuration() || 0) : 0;
  let next = t + sec;
  if (next < 0) next = 0;
  if (dur && next > dur - 0.5) next = dur - 1;
  try { p.seekTo(next, true); } catch (_) {}
  updateProgress();
}

// ── 📊 SEEK με κλικ στη μπάρα ──
function playerSeekAt(ev) {
  const p = currentPlayer();
  if (!p || typeof p.getDuration !== "function") return;
  const bar = document.getElementById("lb-progress");
  if (!bar) return;
  const r = bar.getBoundingClientRect();
  if (!r.width) return;
  let frac = (ev.clientX - r.left) / r.width;
  if (frac < 0) frac = 0; if (frac > 1) frac = 1;
  let dur = 0;
  try { dur = p.getDuration() || 0; } catch (_) {}
  if (!dur) return;
  try { p.seekTo(dur * frac, true); } catch (_) {}
  updateProgress();
}

// ── 🕐 Μορφή χρόνου ──
function fmtTime(sec) {
  sec = Math.max(0, Math.floor(sec || 0));
  const m = Math.floor(sec / 60), s = sec % 60;
  return m + ":" + (s < 10 ? "0" : "") + s;
}

// ── 📊 Ενημέρωση progress bar (καλείται από το poll) ──
function updateProgress() {
  const p = currentPlayer();
  const fill = document.getElementById("lb-progress-fill");
  const cur = document.getElementById("lb-time-cur");
  const tot = document.getElementById("lb-time-tot");
  if (!fill) return;
  if (!p) { fill.style.width = "0%"; if (cur) cur.textContent = "0:00"; if (tot) tot.textContent = "0:00"; return; }
  let t = 0, d = 0;
  try { t = p.getCurrentTime() || 0; } catch (_) {}
  try { d = p.getDuration() || 0; } catch (_) {}
  if (d > 0) fill.style.width = Math.min(100, (t / d) * 100) + "%";
  if (cur) cur.textContent = fmtTime(t);
  if (tot) tot.textContent = fmtTime(d);
  LB._ts = t;   // κρατάει το τρέχον σημείο για τις σημειώσεις
}

// ── 🔁 Poll κάθε 500ms όσο είναι ανοιχτό το lightbox ──
let _lbPoll = null;
function startLbPoll() {
  stopLbPoll();
  _lbPoll = setInterval(() => {
    if (document.getElementById("lb").style.display === "none") { stopLbPoll(); return; }
    updateProgress();
    updatePlayButton();
  }, 500);
}
function stopLbPoll() { if (_lbPoll) { clearInterval(_lbPoll); _lbPoll = null; } }

/* ── 🎠 CAROUSEL: prev/next thumbnails ── */
function lbThumbFor(videoId) {
  if (!videoId) return "";
  return "https://i.ytimg.com/vi/" + esc(videoId) + "/mqdefault.jpg";
}

function lbTitleFor(videoId) {
  const v = (allVideos || []).find(x => x.video_id === videoId);
  if (v) return v.title || "";
  for (const k in (RSS_DATA || {})) {
    const n = (RSS_DATA[k] || []).find(x => x.video_id === videoId);
    if (n) return n.title || "";
  }
  const s = (SEARCH_VIDEOS || []).find(x => x.video_id === videoId);
  return s ? (s.title || "") : "";
}

function updateCarousel() {
  for (const [suffix, offset] of [["prev2", -2], ["prev", -1], ["next", 1], ["next2", 2]]) {
    const card = document.getElementById("lb-side-" + suffix);
    const id = LB.queue[LB.idx + offset];
    if (!card) continue;
    card.classList.toggle("hidden", !id);
    const decorative = Math.abs(offset) === 2;
    card.setAttribute("aria-hidden", String(decorative || !id));
    card.tabIndex = !decorative && id ? 0 : -1;
    card.dataset.videoId = id || "";
    if (!id) continue;
    const img = document.getElementById("lb-thumb-" + suffix);
    img.onerror = () => { img.style.visibility = "hidden"; };
    img.onload = () => { img.style.visibility = "visible"; };
    img.src = lbThumbFor(id);
    document.getElementById("lb-title-" + suffix).textContent = lbTitleFor(id);
  }

}

/* ── 🔴 MARKERS ΣΤΗ PROGRESS BAR ─────────────────────────────── */
// Ζωγραφίζει μια τελεία για κάθε σημείωση, στο ακριβές timestamp.
// Restrained handoff spring: user navigation only, never API refresh.
const carouselMotion = new Map();
const carouselReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
function stopCarouselMotion() {
  for (const animation of carouselMotion.values()) animation.cancel();
  carouselMotion.clear();
}
carouselReducedMotion.addEventListener("change", e => { if (e.matches) stopCarouselMotion(); });
function animateCarouselHandoff(direction) {
  if (carouselReducedMotion.matches) { stopCarouselMotion(); return; }
  const sign = direction < 0 ? -1 : 1;
  const recipes = [
    [".lb-main", 26, 5, 0.986, 440],
    [".lb-side:not(.lb-side-far)", 15, 3, 0.994, 460],
    [".lb-side-far", 7, 1.5, 1, 480],
  ];
  for (const [selector, travel, rebound, startScale, duration] of recipes) {
    for (const card of document.querySelectorAll("#lb " + selector)) {
      const previous = carouselMotion.get(card);
      const style = getComputedStyle(card);
      const startTranslate = previous ? style.translate : `${sign * travel}px 0px`;
      const scale = previous ? style.scale : String(startScale);
      if (previous) { previous.cancel(); carouselMotion.delete(card); }
      if (card.classList.contains("hidden") || style.display === "none") continue;
      const animation = card.animate([
        { translate: startTranslate === "none" ? "0px 0px" : startTranslate,
          scale: scale === "none" ? "1" : scale, offset: 0, easing: "cubic-bezier(.22,.75,.28,1)" },
        { translate: `${-sign * rebound}px -${rebound}px`, scale: "1.004", offset: .62, easing: "ease-in-out" },
        { translate: `${sign * rebound * .2}px 0px`, scale: "1", offset: .82, easing: "ease-out" },
        { translate: "0px 0px", scale: "1", offset: 1 },
      ], { duration, easing: "linear", fill: "none" });
      carouselMotion.set(card, animation);
      animation.onfinish = () => {
        if (carouselMotion.get(card) === animation) carouselMotion.delete(card);
      };
    }
  }
}

function renderMarkers(notes) {
  const bar = document.getElementById("lb-progress");
  if (!bar) return;
  // καθάρισε τα παλιά
  bar.querySelectorAll(".lb-marker").forEach(m => m.remove());
  const p = currentPlayer();
  let dur = 0;
  try { dur = (p && p.getDuration) ? (p.getDuration() || 0) : 0; } catch (_) {}
  if (!dur || !notes || !notes.length) return;
  notes.forEach(n => {
    const ts = Number(n.timestamp_sec);
    if (!isFinite(ts) || ts < 0) return;
    const pct = Math.min(100, Math.max(0, (ts / dur) * 100));
    const dot = document.createElement("button");
    dot.className = "lb-marker";
    dot.style.left = pct + "%";
    dot.title = "⏱️ " + fmtTs(ts) + (n.title ? " — " + n.title : "");
    dot.onclick = (e) => { e.stopPropagation(); playerSeekTo(ts); };
    bar.appendChild(dot);
  });
}
// Μετάβαση σε απόλυτο δευτερόλεπτο (από marker click)
function playerSeekTo(sec) {
  const p = currentPlayer();
  if (!p || typeof p.seekTo !== "function") return;
  try { p.seekTo(sec, true); } catch (_) {}
  updateProgress();
}

/* ── 🐇 PLAYBACK SPEED ─────────────────────────────────────────── */
const SPEED_PRESETS = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];   /* 🌡️ ό,τι δίνει το YouTube */

function toggleSpeedMenu() {
  const pop = document.getElementById("lb-speed-popup");
  const btn = document.getElementById("lb-speed-btn");
  if (!pop) return;
  const open = pop.classList.toggle("open");
  if (btn) btn.classList.toggle("active", open);
  if (open) {
    updateSpeedUI();
    // κλείσε όταν κλικάρεις έξω
    setTimeout(() => document.addEventListener("click", _speedOutside), 0);
  } else {
    document.removeEventListener("click", _speedOutside);
  }
}
function _speedOutside(e) {
  const wrap = document.querySelector(".lb-speed-wrap");
  if (wrap && !wrap.contains(e.target)) {
    const pop = document.getElementById("lb-speed-popup");
    const btn = document.getElementById("lb-speed-btn");
    if (pop) pop.classList.remove("open");
    if (btn) btn.classList.remove("active");
    document.removeEventListener("click", _speedOutside);
  }
}

// Εφαρμογή ταχύτητας στον ενεργό player
function setSpeed(rate) {
  rate = Math.round(rate * 100) / 100;
  if (rate < 0.25) rate = 0.25;
  if (!Number.isFinite(rate)) return;
  if (rate > 2) rate = 2;
  const p = currentPlayer();
  if (p && typeof p.setPlaybackRate === "function") {
    try { p.setPlaybackRate(rate); } catch (_) {}
  }
  LB.rate = rate;                       // θυμήσου το (για το επόμενο βίντεο)
  updateSpeedUI();
}
// Pointer and thumb use the same bottom-to-top mapping; no CSS flips.
function speedFromPointer(event) {
  const rect = event.currentTarget.getBoundingClientRect();
  const fraction = Math.max(0, Math.min(1, (rect.bottom - event.clientY) / rect.height));
  setSpeed(0.25 + Math.round(fraction * 7) * 0.25);
}
function speedPointerDown(event) {
  if (event.button !== 0) return;
  event.preventDefault();
  event.currentTarget.focus();
  event.currentTarget.setPointerCapture(event.pointerId);
  speedFromPointer(event);
}
function speedPointerMove(event) {
  if (event.currentTarget.hasPointerCapture(event.pointerId)) speedFromPointer(event);
}
function speedPointerUp(event) {
  if (event.currentTarget.hasPointerCapture(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId);
}
function speedKeyDown(event) {
  const key = event.key;
  if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"].includes(key)) return;
  event.preventDefault(); event.stopPropagation();
  const rate = Number(event.currentTarget.getAttribute("aria-valuenow"));
  setSpeed(key === "Home" ? 0.25 : key === "End" ? 2 : rate + (["ArrowUp", "ArrowRight"].includes(key) ? 0.25 : -0.25));
}

function updateSpeedUI() {
  const rate = (typeof LB.rate === "number") ? LB.rate : 1;
  const val = document.getElementById("lb-speed-val");
  const range = document.getElementById("lb-speed-range");
  if (val) val.textContent = fmtRate(rate);
  if (range) {
    range.setAttribute("aria-valuenow", String(rate));
    range.setAttribute("aria-valuetext", fmtRate(rate));
    range.style.setProperty("--speed-position", ((rate - 0.25) / 1.75 * 100) + "%");
  }
  // ticks
  const ticks = document.getElementById("lb-speed-ticks");
  if (ticks && !ticks.dataset.built) {
    ticks.dataset.built = "1";
    [...SPEED_PRESETS].reverse().forEach(r => {
      const b = document.createElement("button");
      b.className = "lb-speed-tick";
      b.textContent = fmtRate(r);
      b.dataset.rate = String(r);
      b.onclick = () => setSpeed(r);
      ticks.appendChild(b);
    });
  }
  if (ticks) {
    ticks.querySelectorAll(".lb-speed-tick").forEach(b => {
      b.classList.toggle("on", Math.abs(parseFloat(b.dataset.rate) - rate) < 0.001);
    });
  }
}
function fmtRate(r) {
  r = Math.round(r * 100) / 100;
  return (Number.isInteger(r) ? r : r.toFixed(2).replace(/0$/, "")) + "x";
}

/* ── 📝 NOTES SIDEBAR ── */
function toggleNotes() {
  const panel = document.getElementById("lb-notes-panel");
  if (!panel) return;
  panel.classList.toggle("open");
  if (panel.classList.contains("open")) refreshNotesBadge();
}
function closeNotes() {
  const panel = document.getElementById("lb-notes-panel");
  if (panel) panel.classList.remove("open");
}
function refreshNotesBadge() {
  const badge = document.getElementById("lb-notes-count");
  if (!badge) return;
  const n = document.querySelectorAll("#lb-notes .lb-note-item").length;
  badge.textContent = n > 0 ? "(" + n + ")" : "";
}

function closeLightbox() {
  stopCarouselMotion();
  document.getElementById("lb").style.display = "none";
  document.getElementById("lb-frame").innerHTML = ""; // σταμάτα το βίντεο
  LB.queue = []; LB.idx = 0; LB.context = null;
  try { stopLbPoll(); } catch (e) {}
  try { closeNotes(); } catch (e) {}
  try {
    const sp = document.getElementById("lb-speed-popup");
    const sb = document.getElementById("lb-speed-btn");
    if (sp) sp.classList.remove("open");
    if (sb) sb.classList.remove("active");
    document.removeEventListener("click", _speedOutside);
  } catch (e) {}
}

function lightboxAdd() {
  const videoId = LB.queue[LB.idx];

  // Βρες το channel_id: πρώτα feed, μετά search results, μετά library.
  let cid = null;
  for (const k in (RSS_DATA || {})) {
    if ((RSS_DATA[k] || []).some(n => n.video_id === videoId)) { cid = k; break; }
  }
  if (!cid) {
    const sv = (SEARCH_VIDEOS || []).find(x => x.video_id === videoId);
    if (sv) cid = sv.channel_id || null;
  }
  if (!cid) {
    const v = (allVideos || []).find(x => x.video_id === videoId);
    if (v) cid = v.channel_id || v.channel || null;
  }

  // ➕ add ΧΩΡΙΣ να κλείσει το παράθυρο. Μένει ανοιχτό για να προχωρήσεις ΕΣΥ όποτε θες.
  const url = "https://www.youtube.com/watch?v=" + videoId;
  const lbMeta = cid ? (WATCHED_META[cid] || {}) : {};
  fetch("/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url, approve: true, channel_id: cid || null, channel: lbMeta.name || null }),
  }).then(r => r.json()).then(d => {
    if (!d.ok) { alert(d.error || "Σφάλμα"); return; }
    // Αν είναι ακόμα στην ουρά του feed, σημείωσέ το ότι προστέθηκε (αλλά ΜΗΝ προχωρήσεις αυτόματα).
    if (cid) {
      RSS_DATA[cid] = (RSS_DATA[cid] || []).filter(n => n.video_id !== videoId);
    }
    // Αλλαγή του κουμπιού ➕ σε ✓ (spring + draw animation) — το «magic moment».
    const addBtn = document.getElementById("lb-add");
    if (addBtn) {
      addBtn.innerHTML = '<svg class="add-check" width="22" height="22" viewBox="0 0 24 24" fill="none" style="display:block"><path d="M4 12.5l5.5 5.5L20 6.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="100" style="stroke-dasharray:100;stroke-dashoffset:100;animation:check-draw .4s cubic-bezier(.4,0,.2,1) .15s forwards"/></svg>';
      addBtn.classList.add("added");
      addBtn.style.pointerEvents = "none";
    }
    // ενημέρωσε ΜΟΝΟ το RSS panel του καναλιού (σιωπηλά — ΔΕΝ κλείνει/διπλώνει τίποτα).
    if (cid) renderRssPanel(cid);
    // ➕ πρόσθεσε ΚΑΙ ορατά το βίντεο μέσα στο κανάλι (όπως το ➕ του feed).
    if (cid) {
      let title = d.title || videoId;
      let channel = (WATCHED_META[cid] || {}).name || null;
      // βρες title/channel από feed, search ή library
      const fromFeed = (RSS_DATA[cid] || []).find(n => n.video_id === videoId);
      if (!fromFeed) {
        const sv = (SEARCH_VIDEOS || []).find(x => x.video_id === videoId);
        if (sv) { title = sv.title || title; channel = channel || sv.channel || null; }
        const lv = (allVideos || []).find(x => x.video_id === videoId);
        if (lv) { title = lv.title || title; channel = channel || lv.channel || null; }
      } else {
        title = fromFeed.title || title;
        channel = channel || fromFeed.channel || null;
      }
      appendVideoToChannel(cid, {
        video_id: videoId,
        title: title,
        channel: channel || d.title || cid,
        channel_id: cid,
        rating: 0,
        unseen: false,
      });
    }
    // 🔄 Κάνε Ο,ΤΙ ΚΑΝΕΙ Η ΚΑΡΤΕΛΑ: πλήρες reload των δεδομένων (load()).
    //    Αυτό ανανεώνει ΚΑΙ τα κανάλια ΚΑΙ τις κατηγορίες — χωρίς επανεκκίνηση.
    //    (Το ίδιο ακριβώς κάνει το addVideoFromSearch που δουλεύει από την καρτέλα.)
    try { load(); } catch (e) {}
  }).catch(() => alert("Σφάλμα σύνδεσης"));
}

function lightboxDismiss() {
  const videoId = LB.queue[LB.idx];
  // βρες το cid από το feed
  let cid = null;
  for (const k in (RSS_DATA || {})) {
    if ((RSS_DATA[k] || []).some(n => n.video_id === videoId)) { cid = k; break; }
  }
  if (!cid) { closeLightbox(); return; }
  dismissFromRSS(cid, videoId);
  // το dismissFromRSS αφαιρεί το βίντεο + το /dismiss_video το αποθηκεύει μόνιμα.
  // Προχώρα στο ΕΠΟΜΕΝΟ βίντεο της ουράς (ή κλείσε αν είναι το τελευταίο).
  LB.queue = LB.queue.filter(id => id !== videoId);
  if (LB.queue.length === 0) {
    closeLightbox();
    return;
  }
  if (LB.idx >= LB.queue.length) LB.idx = LB.queue.length - 1;
  showLightbox();
}

// Esc = κλείσιμο
document.addEventListener("keydown", (e) => {
  if (e.key !== "Escape" && e.key !== "Esc") return;
  const cw = document.getElementById("cw");
  if (cw && cw.style.display !== "none") {
    closeChannelPreview();
    return;
  }
  if (document.getElementById("lb").style.display !== "none") {
    closeLightbox();
  }
});

/* ═════════════════════════════════════════════════════════════════════
   🫧 BUBBLE FIELD — αιωρούμενα trending θέματα (αρχική σελίδα αναζήτησης)
   Ελαφρύ physics: ανεβαίνουν αργά, ελαφρά σύγκρουση, σκάνε στο πάνω όριο.
   Κλικ → το θέμα μπαίνει στο YouTube search field.
   ═════════════════════════════════════════════════════════════════════ */

// Λίστα trending θεμάτων (θα φτάσουμε τα 500· ξεκινάμε με δυνατό βασικό σετ).
const TRENDING_TOPICS = [
  "music","gaming","football","cooking","fitness","travel","technology","fashion",
  "health","longevity","medicine","cars","crypto","science","history","space",
  "art","photography","diy","gardening","nutrition","meditation","yoga","workout",
  "podcast","news","movies","series","anime","comedy","documentary","education",
  "psychology","philosophy","economics","investment","real estate","startup",
  "artificial intelligence","machine learning","programming","web development",
  "design","architecture","nature","animals","pets","recipes","desserts","baking",
  "makeup","skincare","hairstyle","interior design","minimalism","productivity",
  "motivation","self improvement","mental health","relationships","parenting",
  "finance","budgeting","saving","retirement","stock market","forex","bitcoin",
  "ethereum","nft","metaverse","virtual reality","robot","drone","electric car",
  "renewable energy","climate","ecology","ocean","wildlife","camping","hiking",
  "survival","bushcraft","fishing","hunting","cycling","running","swimming","boxing"
];

const BUBBLE_COLORS = [
  ["#6c8cff", "#3b5bdb"], ["#22d3a5", "#0b8f6e"], ["#f59e0b", "#b45309"],
  ["#ec4899", "#9d174d"], ["#8b5cf6", "#5b21b6"], ["#00b4d8", "#0077b6"],
  ["#e5533d", "#8f2d1e"], ["#84cc16", "#3f6212"]
];

const BUBBLE_STATE = {
  running: false,
  bubbles: [],
  raf: null,
  width: 0, height: 0,
  canvas: null, ctx: null,
  field: null,
  mouse: null,
};

function initBubbleField() {
  const field = document.getElementById("bubble-field");
  const canvas = document.getElementById("bubble-canvas");
  if (!field || !canvas) return;
  BUBBLE_STATE.field = field;
  BUBBLE_STATE.canvas = canvas;
  BUBBLE_STATE.ctx = canvas.getContext("2d");
  canvas.addEventListener("click", onBubbleClick);
  // 🖱️ Mouse tracking για hover (highlight + φούσκωμα + pointer cursor).
  canvas.addEventListener("mousemove", (e) => {
    const rect = canvas.getBoundingClientRect();
    BUBBLE_STATE.mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  });
  canvas.addEventListener("mouseleave", () => { BUBBLE_STATE.mouse = null; });
}

function showBubbleField() {
  const field = document.getElementById("bubble-field");
  if (!field) { console.warn("bubble-field not found"); return; }
  field.style.display = "block";
  // ΣΥΓΧΡΟΝΑ — χωρίς rAF (το resize έχει fallback ύψους αν clientHeight=0).
  resizeBubbleField();
  spawnBubbles();
  startBubbleLoop();
}

function hideBubbleField() {
  BUBBLE_STATE.running = false;
  if (BUBBLE_STATE.raf) { cancelAnimationFrame(BUBBLE_STATE.raf); BUBBLE_STATE.raf = null; }
  BUBBLE_STATE.bubbles = [];
  const field = document.getElementById("bubble-field");
  if (field) field.style.display = "none";
}

function resizeBubbleField() {
  const canvas = BUBBLE_STATE.canvas;
  const field = BUBBLE_STATE.field;
  if (!canvas || !field) return;
  const dpr = window.devicePixelRatio || 1;
  const w = field.clientWidth || field.offsetWidth || 800;
  // fallback ύψος αν το layout δεν έχει κάνει reflow ακόμα (clientHeight = 0)
  const h = field.clientHeight || field.offsetHeight || 460;
  BUBBLE_STATE.width = w;
  BUBBLE_STATE.height = h;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + "px";
  canvas.style.height = h + "px";
  BUBBLE_STATE.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function spawnBubbles() {
  const { width, height } = BUBBLE_STATE;
  if (!width || !height) return;
  BUBBLE_STATE.bubbles = [];
  // Πυκνότητα: ένα κάθε ~80px (ικανοποιητική αλλά όχι ασφυκτική).
  let count = Math.min(60, Math.max(20, Math.floor(width / 80)));
  const topics = [...TRENDING_TOPICS].sort(() => Math.random() - 0.5).slice(0, count);
  // Γύρνα κυκλικά αν χρειαστεί.
  while (topics.length < count) topics.push(TRENDING_TOPICS[Math.floor(Math.random() * TRENDING_TOPICS.length)]);
  const spacing = width / (count + 1);
  topics.forEach((topic, i) => {
    const idx = Math.floor(Math.random() * BUBBLE_COLORS.length);
    const [c1, c2] = BUBBLE_COLORS[idx];
    // Κάψουλα: σταθερό ύψος, πλάτος ανάλογο με τη λέξη.
    const h = 34;
    const w = Math.max(h * 1.6, h * 0.7 + topic.length * 7.7);
    // layer 0..1: 0 = πιο κάτω (αργό), 1 = πιο πάνω (γρήγορο) — το πάνω σπρώχνεται.
    const layer = i / Math.max(1, count - 1);
    // 🚀 Βγαίνουν ΜΟΝΟ από κάτω (εισέρχονται) — και ανεβαίνουν.
    const colX = spacing * (i + 1) + (Math.random() * 20 - 10);
    const rowY = height - 10 + Math.random() * (height * 0.6);  // κάτω άκρη του πεδίου
    BUBBLE_STATE.bubbles.push({
      topic,
      x: colX,
      y: rowY,
      w, h,
      layer,
      vy: 0.22 + layer * 0.18,          // σταθερή, αισθητή άνοδος
      vx: (Math.random() - 0.5) * 0.06,
      c1, c2,
      burst: 0,
      born: performance.now(),
    });
  });
}

// 🌊 Συνεχόμενη εισροή: όποτε τα bubbles λιγοστεύουν (σκάνε/ανεβαίνουν), νέα μπαίνουν από κάτω.
function refillBubbles() {
  const { bubbles, width, height } = BUBBLE_STATE;
  const target = Math.min(60, Math.max(20, Math.floor(width / 80)));
  if (bubbles.length < target) {
    const h = 34;
    const topic = TRENDING_TOPICS[Math.floor(Math.random() * TRENDING_TOPICS.length)];
    const w = Math.max(h * 1.6, h * 0.7 + topic.length * 7.7);
    const [c1, c2] = BUBBLE_COLORS[Math.floor(Math.random() * BUBBLE_COLORS.length)];
    bubbles.push({
      topic,
      x: Math.random() * width,
      y: height + 20 + Math.random() * 80,   // ξεκινά κάτω από το όριο
      w, h,
      layer: Math.random(),
      vy: 0.22 + Math.random() * 0.18,
      vx: (Math.random() - 0.5) * 0.06,
      c1, c2,
      burst: 0,
      born: performance.now(),
    });
  }
}

function startBubbleLoop() {
  if (BUBBLE_STATE.running) return;
  BUBBLE_STATE.running = true;
  const step = () => {
    if (!BUBBLE_STATE.running) return;
    stepBubbles();
    drawBubbles();
    BUBBLE_STATE.raf = requestAnimationFrame(step);
  };
  BUBBLE_STATE.raf = requestAnimationFrame(step);
}
function stepBubbles() {
  const { bubbles, width, height } = BUBBLE_STATE;
  for (const b of bubbles) {
    if (b.burst > 0) { b.burst += 0.07; continue; }
    // Σταθερή, ομαλή ταχύτητα — χωρίς boost, χωρίς φρενάρισμα.
    b.y -= b.vy;
    b.x += b.vx;
    // ελαφρύ drift (όρια με w)
    if (b.x < b.w/2 + 4) { b.x = b.w/2 + 4; b.vx = Math.abs(b.vx); }
    if (b.x > width - b.w/2 - 4) { b.x = width - b.w/2 - 4; b.vx = -Math.abs(b.vx); }
    // όταν φτάσει στο πάνω όριο (σκάνε στο search bar) → burst
    if (b.y < b.h/2 + 4) { b.burst = 0.001; }
  }
  // συγκρούσεις — μαλακό «μπουμπ»: αργή ομαλή ώθηση, χωρίς σπαστικές κινήσεις.
  for (let i = 0; i < bubbles.length; i++) {
    for (let j = i + 1; j < bubbles.length; j++) {
      const a = bubbles[i], c = bubbles[j];
      if (a.burst > 0 || c.burst > 0) continue;
      const dx = c.x - a.x, dy = c.y - a.y;
      const d = Math.hypot(dx, dy);
      // κάψουλα overlap: οριζόντια w, κάθετα h
      const minD = (a.w + c.w) * 0.55 + (a.h + c.h) * 0.2;
      if (d < minD && d > 0) {
        const nx = dx / d, ny = dy / d;
        const overlap = (minD - d) / 2;
        // «Μπουμπ»: αργή, βαριά ώθηση — μικρή δύναμη που κινεί ΟΜΑΛΑ και τα δύο.
        const push = overlap * 0.35;        // χαμηλή δύναμη (βαρύ μπαμπλ)
        // αλλάζουμε ΑΡΓΑ τη θέση (όχι απότομο teleport)
        a.x -= nx * push;
        a.y -= ny * push * 0.4;
        c.x += nx * push;
        c.y += ny * push * 0.4;
        // μεταφέρουμε ΑΡΓΑ ορμή: ανταλλάσσουμε μικρό μέρος της ταχύτητας, όχι όλο.
        const tx = a.vx; a.vx = a.vx * 0.7 + c.vx * 0.3;
        c.vx = c.vx * 0.7 + tx * 0.3;
        // Βάρος στον «μπουμπ»: μικρή κάθετη ώθηση στα δύο (χωρίς να τα σταματά).
        a.vy += ny * 0.012;
        c.vy -= ny * 0.012;
      }
    }
  }
  // Αφαίρεσε σκασμένα μπαλόνια + φέρε νέα από κάτω (συνεχόμενη ροή).
  BUBBLE_STATE.bubbles = bubbles.filter(b => b.burst <= 1.4);
  refillBubbles();
}

function drawBubbles() {
  const ctx = BUBBLE_STATE.ctx;
  const { width, height, bubbles, mouse } = BUBBLE_STATE;
  ctx.clearRect(0, 0, width, height);
  let hovering = false;
  for (const b of bubbles) {
    let alpha = 1, w = b.w, h = b.h;
    if (b.burst > 0) {
      const p = b.burst;
      w = b.w * (1 + p * 1.3);          // μεγαλώνει όταν σκάει
      h = b.h * (1 + p * 1.3);
      alpha = Math.max(0, 1 - p);
    }
    // 🖱️ Hover: αν το mouse είναι πάνω → φούσκωμα + highlight.
    let hovered = false;
    if (b.burst === 0 && mouse) {
      const dx = Math.abs(mouse.x - b.x), dy = Math.abs(mouse.y - b.y);
      if (dx <= b.w/2 + 4 && dy <= b.h/2 + 4) { hovered = true; hovering = true; }
    }
    if (hovered) { w *= 1.16; h *= 1.16; }   // φούσκωμα

    const x = b.x - w/2, y = b.y - h/2;
    const r = h/2;                     // πλήρως στρογγυλεμένη κάψουλα (pill)
    // Πολύ διάφανο fill — στο hover φωτίζει περισσότερο.
    ctx.globalAlpha = alpha * (hovered ? 0.34 : 0.16);
    ctx.fillStyle = b.c1;               // HEX — πάντα ασφαλές
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
    else ctx.rect(x, y, w, h);
    ctx.fill();
    // Λεπτό stroke — στο hover πιο έντονο.
    ctx.globalAlpha = alpha * (hovered ? 0.85 : 0.4);
    ctx.strokeStyle = b.c2;             // HEX
    ctx.lineWidth = hovered ? 1.8 : 1.2;
    ctx.stroke();
    // Κείμενο — ήπιο χρώμα, πιο φωτεινό στο hover.
    if (b.burst === 0) {
      ctx.globalAlpha = alpha * (hovered ? 1.0 : 0.85);
      ctx.fillStyle = hovered ? b.c2 : b.c1;
      ctx.font = (hovered ? "700 " : "600 ") + "15px Manrope, sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(b.topic, b.x, b.y + 0.5);
    }
  }
  // Pointer cursor μόνο όταν πάνω από bubble (clickable).
  BUBBLE_STATE.canvas.style.cursor = hovering ? "pointer" : "default";
  ctx.globalAlpha = 1;
}

function onBubbleClick(e) {
  const rect = BUBBLE_STATE.canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left;
  const my = e.clientY - rect.top;
  // βρες το μπαλόνι που χτύπησες (από το πιο πάνω → κάτω)
  let hit = null;
  for (const b of BUBBLE_STATE.bubbles) {
    if (b.burst > 0) continue;
    // κάψουλα hit-test (ορθογώνιο + στρογγυλεμένα άκρα)
    const dx = Math.abs(mx - b.x), dy = Math.abs(my - b.y);
    const hw = b.w/2, hh = b.h/2;
    if (dx <= hw && dy <= hh) { hit = b; break; }
  }
  if (!hit) return;
  // βάλε το θέμα στο search field + ψάξε
  const input = document.getElementById("yt-search-input");
  if (input) {
    input.value = hit.topic;
    // σκάσε το μπαλόνι
    hit.burst = 0.001;
    doYouTubeSearch();
  }
}

// Εμφάνιση/απόκρυψη: μόνο στην αρχική σελίδα αναζήτησης (όταν το search είναι άδειο).
function refreshBubbleField() {
  const inSearch = currentTab === "search";
  const q = (document.getElementById("yt-search-input")?.value || "").trim();
  const hasResults = document.getElementById("yt-search-results")?.children.length > 0;
  if (inSearch && !q && !hasResults) {
    showBubbleField();
  } else {
    hideBubbleField();
  }
}

window.addEventListener("resize", () => {
  if (BUBBLE_STATE.running) { resizeBubbleField(); spawnBubbles(); }
});

initBubbleField();

// Εμφάνιση bubbles — μετά το αρχικό load (μεγαλύτερο timeout για να στρώσει το layout + async load).
setTimeout(() => refreshBubbleField(), 400);
setTimeout(() => refreshBubbleField(), 1200);

// 🖱️ Αποτρέπει το αρχικό focus σε button (ώστε να μη φαίνεται tooltip στο άνοιγμα).
setTimeout(() => {
  if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
}, 80);

// 🌫️ Frosted glass: όταν ένα sticky head «κολλάει» πάνω, θολώνει ό,τι περνά από κάτω.
// Ισχύει για ΟΛΑ τα tabs (Αναζήτηση / Κανάλια / Κατηγορίες).
function updateSearchFrost() {
  document.querySelectorAll(".yt-search-sticky, .sticky-head").forEach((sticky) => {
    // Κρυμμένο tab (display:none κάπου από πάνω) → δεν έχει layout boxes. Φθηνότερο από getComputedStyle.
    if (sticky.getClientRects().length === 0) {
      sticky.classList.remove("scrolled");
      return;
    }
    sticky.classList.toggle("scrolled", sticky.getBoundingClientRect().top <= 2);
  });
}
// ⚡ Το scroll πυροδοτείται δεκάδες φορές/δευτ. → το πολύ ΜΙΑ ενημέρωση ανά frame.
let _frostRaf = 0;
function scheduleFrost() {
  if (_frostRaf) return;
  _frostRaf = requestAnimationFrame(() => { _frostRaf = 0; updateSearchFrost(); });
}
// 🔑 LICENSING — activation screen + σιωπηλός επανέλεγχος (Gumroad license key)
// Όλη η λογική ζει στο backend (/activate_license, /verify_license). Εδώ μόνο το UI.
function checkLicenseAndBoot() {
  fetch("/verify_license", { method: "POST", headers: {"Content-Type":"application/json"}, body: "{}" })
    .then(r => r.json())
    .then(d => {
      if (d.ok && d.activated) {
        load();                              // ✅ ενεργό (ή χάρη) → κανονική εκκίνηση
      } else if (d.needs_activation) {
        showActivationScreen();              // 🔑 πρώτο launch → ζήτα key
      } else {
        showLicenseBlocked(d.error || "Το license δεν είναι ενεργό.");  // ❌ ακυρωμένο/overuse
      }
    })
    .catch(() => {
      // Server δεν απάντησε — μην μπλοκάρεις τη γραμμή· άσε το load() να διαχειριστεί το σφάλμα.
      load();
    });
}

function showActivationScreen() {
  closeUpdatePopup();
  const pop = document.createElement("div");
  pop.className = "del-confirm center";
  pop.id = "license-pop";
  pop.innerHTML = `
    <div class="dc-msg"><b>🔑 Ενεργοποίηση</b><br>
      <span class="muted">Βάλε το license key από το email της αγοράς σου.</span></div>
    <div class="dc-btns" style="flex-wrap:wrap; gap:8px;">
      <input id="license-key-input" type="text" placeholder="License key" autocomplete="off"
             style="width:100%; padding:9px 12px; border:1px solid var(--border);
                    border-radius:10px; background:var(--card); color:var(--text);
                    font-family:inherit; font-size:13.5px;">
      <button class="dc-yes" onclick="activateLicense()">✓ Ενεργοποίηση</button>
      <button class="dc-no" onclick="closeUpdatePopup()">Αργότερα</button>
    </div>
    <div id="license-err" class="muted" style="margin-top:8px; font-size:12.5px;"></div>`;
  document.body.appendChild(pop);
  const inp = document.getElementById("license-key-input");
  if (inp) { setTimeout(() => inp.focus(), 60); }
}

function activateLicense() {
  const inp = document.getElementById("license-key-input");
  const err = document.getElementById("license-err");
  const key = (inp && inp.value || "").trim();
  if (!key) { if (err) err.textContent = "Δώσε το key."; return; }
  if (err) err.textContent = "…γίνεται έλεγχος…";
  fetch("/activate_license", {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({ license_key: key })
  })
    .then(r => r.json())
    .then(d => {
      if (d.ok && d.activated) {
        closeUpdatePopup();   // κλείσε το activation screen
        load();               // ✅ ενεργοποιήθηκε → ξεκίνα
      } else {
        if (err) err.textContent = d.error || "Η ενεργοποίηση απέτυχε.";
      }
    })
    .catch(() => { if (err) err.textContent = "Δεν απαντά ο server."; });
}

function showLicenseBlocked(msg) {
  closeUpdatePopup();
  const pop = document.createElement("div");
  pop.className = "del-confirm center";
  pop.id = "license-pop";
  pop.innerHTML = `
    <div class="dc-msg">⛔ <b>Το license δεν είναι ενεργό</b><br>
      <span class="muted" style="font-size:12.5px;">${esc(msg || "")}</span></div>
    <div class="dc-btns">
      <button class="dc-yes" onclick="closeUpdatePopup(); activateLicense()">🔑 Βάλε key ξανά</button>
      <button class="dc-no" onclick="this.closest('#license-pop').remove()">Κλείσιμο</button>
    </div>`;
  document.body.appendChild(pop);
}

window.addEventListener("scroll", scheduleFrost, { passive: true });
window.addEventListener("resize", scheduleFrost);

initTabDrag();   // ↕️ dragable tabs (σειρά από τον χρήστη)
checkLicenseAndBoot();   // 🔑 license gate → αν ενεργό, τρέχει load()· αλλιώς activation screen
</script>

<!-- 🎬 Floating player (lightbox) — το βίντεο παίζει "στον αέρα", πάνω από θολή σελίδα -->
<div id="lb" class="lb" style="display:none">
  <div class="lb-backdrop" onclick="closeLightbox()"></div>
  <div class="lb-dialog" role="dialog" aria-modal="true">
    <!-- 🎠 CAROUSEL: prev | player | next -->
    <div class="lb-stage">
      <div class="lb-side lb-side-far lb-side-prev2 hidden" id="lb-side-prev2" aria-hidden="true">
        <img class="lb-side-thumb" id="lb-thumb-prev2" alt="">
        <span class="lb-side-title" id="lb-title-prev2"></span>
      </div>
      <div class="lb-side lb-side-far lb-side-next2 hidden" id="lb-side-next2" aria-hidden="true">
        <img class="lb-side-thumb" id="lb-thumb-next2" alt="">
        <span class="lb-side-title" id="lb-title-next2"></span>
      </div>
      <!-- 🎠 Πλαϊνό ΑΡΙΣΤΕΡΑ (πίσω layer) — ΞΕΧΩΡΙΣΤΟ κουτί, όχι μέσα στο κεντρικό -->
      <div class="lb-side lb-side-prev" id="lb-side-prev" onclick="stepLightbox(-1)" title="Προηγούμενο βίντεο">
        <img class="lb-side-thumb" id="lb-thumb-prev" alt="">
        <div class="lb-side-title" id="lb-title-prev"></div>
      </div>

      <!-- 🎬 ΚΕΝΤΡΙΚΟΣ PLAYER — το ΜΟΝΟ λευκό κουτί -->
      <div class="lb-main" id="lb-main">
    <button class="lb-close" onclick="closeLightbox()" title="Κλείσε (Esc)">✕</button>
        <div class="lb-frame" id="lb-frame"></div>
    <!-- 📊 PROGRESS (χωρίς χρόνους — πάνε στην κάτω γραμμή) -->
    <div class="lb-progress-wrap">
      <div class="lb-progress" id="lb-progress" onclick="playerSeekAt(event)">
        <div class="lb-progress-fill" id="lb-progress-fill"></div>
      </div>
    </div>

    <!-- ═══ 🎛️ COMPACT BOTTOM BAR — ΜΙΑ γραμμή ═══ -->
    <div class="lb-bottom">
      <!-- ΑΡΙΣΤΕΡΑ: 🐇 ταχύτητα + δείκτης + χρόνος -->
      <div class="lb-bottom-left">
        <div class="lb-speed-wrap">
          <button class="lb-speed-btn" id="lb-speed-btn" onclick="toggleSpeedMenu()" title="Ταχύτητα αναπαραγωγής (S)">
            <svg class="lb-rabbit" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 17C7 10 6 2 10 2c3 0 4 8 4 14m4 0c0-6 1-14 4-14 4 0 3 8 0 15"/>
              <path d="M10 16c-4 2-6 5-5 8 1 4 5 6 11 6s10-2 11-6c1-3-1-6-5-8"/>
              <circle cx="11" cy="22" r="1" fill="currentColor" stroke="none"/>
              <circle cx="21" cy="22" r="1" fill="currentColor" stroke="none"/>
              <path d="m14 25 2 2 2-2m-2 2v2M3 23l5 1m16 0 5-1"/>
            </svg>
            <span class="lb-speed-val" id="lb-speed-val">1x</span>
          </button>
          <div class="lb-speed-popup" id="lb-speed-popup">
            <div class="lb-thermo">
              <div class="lb-speed-range" id="lb-speed-range" role="slider" tabindex="0"
                   aria-label="Ταχύτητα αναπαραγωγής" aria-orientation="vertical"
                   aria-valuemin="0.25" aria-valuemax="2" aria-valuenow="1"
                   onpointerdown="speedPointerDown(event)" onpointermove="speedPointerMove(event)"
                   onpointerup="speedPointerUp(event)" onpointercancel="speedPointerUp(event)"
                   onkeydown="speedKeyDown(event)">
                <span class="lb-speed-thumb" id="lb-speed-thumb"></span>
              </div>
              <div class="lb-speed-ticks" id="lb-speed-ticks"></div>
            </div>
          </div>
        </div>
        <span class="lb-pos" id="lb-pos"></span>
        <span class="lb-time-sep">·</span>
        <span class="lb-time" id="lb-time-cur">0:00</span>
        <span class="lb-time-sep">/</span>
        <span class="lb-time" id="lb-time-tot">0:00</span>
      </div>

      <!-- ΚΕΝΤΡΟ: controls (απόλυτα κεντραρισμένα) -->
      <div class="lb-bottom-center">
        <button class="lb-ctrl" id="lb-prev" onclick="stepLightbox(-1)" title="Προηγούμενο βίντεο (←)">|◀◀</button>
        <button class="lb-ctrl" id="lb-back" onclick="playerSkip(-SKIP_SEC)" title="Πίσω 20 δευτ.">◀◀<span class="lb-skip-num">20</span></button>
        <button class="lb-ctrl lb-ctrl-step" id="lb-back5" onclick="playerSkip(-SKIP_SMALL)" title="Πίσω 5 δευτ.">◀<span class="lb-skip-num">5</span></button>
        <button class="lb-ctrl lb-ctrl-play" id="lb-play" onclick="playerToggle()" title="Play / Pause (Space)">▶</button>
        <button class="lb-ctrl lb-ctrl-step" id="lb-fwd5" onclick="playerSkip(SKIP_SMALL)" title="Μπροστά 5 δευτ."><span class="lb-skip-num">5</span>▶</button>
        <button class="lb-ctrl" id="lb-fwd" onclick="playerSkip(SKIP_SEC)" title="Μπροστά 20 δευτ."><span class="lb-skip-num">20</span>▶▶</button>
        <button class="lb-ctrl" id="lb-next" onclick="stepLightbox(1)" title="Επόμενο βίντεο (→)">▶▶|</button>
      </div>

      <!-- ΔΕΞΙΑ: σημείωση + add/dismiss -->
      <div class="lb-bottom-right">
        <button class="lb-add" id="lb-add" onclick="lightboxAdd()" title="Πρόσθεσε στο ιστορικό μου" style="display:none">➕</button>
        <button class="lb-dismiss" id="lb-dismiss" onclick="lightboxDismiss()" title="Δεν με ενδιαφέρει" style="display:none">✕</button>
        <button class="lb-note-compact" id="lb-note-btn" onclick="toggleNotes()" title="Σημειώσεις (N)">📝 Σημείωση <span id="lb-notes-count"></span></button>
      </div>
    </div>
      </div>

      <!-- 🎠 Πλαϊνό ΔΕΞΙΑ (πίσω layer) -->
      <div class="lb-side lb-side-next" id="lb-side-next" onclick="stepLightbox(1)" title="Επόμενο βίντεο">
        <img class="lb-side-thumb" id="lb-thumb-next" alt="">
        <div class="lb-side-title" id="lb-title-next"></div>
      </div>
    </div>

    <!-- 📝 NOTES SIDEBAR (collapsible) -->
    <div class="lb-notes-panel" id="lb-notes-panel">
      <div class="lb-notes-head">
        <span>📝 Σημειώσεις</span>
        <button class="lb-notes-close" onclick="toggleNotes()" title="Κλείσε">✕</button>
      </div>
      <div class="lb-notes" id="lb-notes"></div>
      <div class="lb-notes-add">
        <button class="lb-note-btn" id="lb-note-btn2" onclick="openNoteForm()" title="Σημείωσε αυτό το σημείο">⏱️ Σημείωση εδώ</button>
      </div>
    </div>
  </div>
</div>

<div id="cw" class="lb" style="display:none">
  <div class="lb-backdrop" onclick="closeChannelPreview()"></div>
  <div class="cw-dialog" role="dialog" aria-modal="true">
    <button class="lb-close" onclick="closeChannelPreview()" title="Κλείσε (Esc)">✕</button>
    <div class="cw-head">
      <img class="cw-avatar" id="cw-avatar" alt="" onerror="this.style.display='none'">
      <div class="cw-title" id="cw-title"></div>
      <button class="yt-btn add" id="cw-watch" onclick="watchChannelFromWindow()">➕ Παρακολούθησε</button>
    </div>
    <div class="cw-videos-title">Πρόσφατα βίντεο</div>
    <div class="cw-videos" id="cw-videos"></div>
  </div>
</div>
</body>
</html>
