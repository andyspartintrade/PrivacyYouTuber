# 🔐 Πρότυπο .env — αντιγράψτε σε `.env` και βάλτε τα δικά σας keys.
# ΠΟΤΕ μην δεσμεύσετε το πραγματικό `.env` στο git.

# YouTube Innertube WEB API key (προαιρετικό — το app το βρίσκει και μόνο του από τη σελίδα).
# Αν θέλετε δικό σας (ή αν αλλάξει το δημόσιο key), βάλτε το εδώ.
YT_API_KEY=

# 📧 SMTP — για πραγματικό email στο Password Reset (προαιρετικό).
# Χωρίς αυτά, το reset δουλεύει με τοπικό recovery code (fallback).
# Για Gmail: χρειάζεται App Password (Google → Ασφάλεια → Κωδικοί εφαρμογών).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
